---
const categories = [
  { id: 'all', label: 'All Programs' },
  { id: 'Government Certified', label: 'Govt. Certified' },
  { id: 'Finance & Accounts', label: 'Finance' },
  { id: 'Programming', label: 'Programming' },
  { id: 'Creative Suite', label: 'Design' },
];
---

<div class="fixed top-24 left-1/2 -translate-x-1/2 z-50 pointer-events-auto">
  <div class="flex items-center gap-2 p-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-xl shadow-2xl overflow-x-auto max-w-[90vw] hide-scrollbar">
    {categories.map((cat, idx) => (
      <button
        class={`filter-btn px-4 py-2 rounded-full text-[11px] font-bold uppercase tracking-wider whitespace-nowrap transition-all duration-300 ${idx === 0 ? 'bg-white text-black' : 'text-white/60 hover:text-white hover:bg-white/10'}`}
        data-filter={cat.id}
      >
        {cat.label}
      </button>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const filter = target.dataset.filter;

        // Update active state
        buttons.forEach(b => {
          b.classList.remove('bg-white', 'text-black');
          b.classList.add('text-white/60', 'hover:text-white', 'hover:bg-white/10');
        });
        target.classList.remove('text-white/60', 'hover:text-white', 'hover:bg-white/10');
        target.classList.add('bg-white', 'text-black');

        // Filter Courses (Horizontal Scroll)
        const courseCards = document.querySelectorAll('.course-card');
        courseCards.forEach(card => {
          if (card instanceof HTMLElement) {
            const category = card.dataset.category;
            if (filter === 'all' || category === filter) {
              card.classList.remove('hidden');
              // Make sure to unhide smoothly
              card.style.opacity = '0';
              setTimeout(() => { card.style.opacity = '1'; }, 50);
            } else {
              card.classList.add('hidden');
            }
          }
        });

        // Trigger recalculation in Courses.astro
        if (typeof window.recalcCoursesScroll === 'function') {
          window.recalcCoursesScroll();
        }

        // Filter Digital Courses (Grid)
        // Since digital courses domains are different, we can either map them or just show all if 'all' is selected.
        // Let's do a simple mapping for the demo, or just hide digital courses if a specific main category is selected.
        const digitalCards = document.querySelectorAll('.digital-course-card');
        digitalCards.forEach(card => {
          if (card instanceof HTMLElement) {
            const domain = card.dataset.domain;
            let show = false;
            
            if (filter === 'all') {
              show = true;
            } else if (filter === 'Finance & Accounts' && domain === 'Office Skills') {
              show = true;
            } else if (filter === 'Programming' && domain === 'Web Dev & Programming') {
              show = true;
            } else if (filter === 'Creative Suite' && (domain === 'Graphic Designing' || domain === 'Digital Marketing')) {
              show = true;
            } else if (filter === 'Hindi & English' && domain === 'Spoken English') {
              show = true;
            }

            if (show) {
              card.style.display = 'flex';
              setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'scale(1)'; }, 50);
            } else {
              card.style.opacity = '0';
              card.style.transform = 'scale(0.95)';
              setTimeout(() => { card.style.display = 'none'; }, 300); // match transition duration
            }
          }
        });
      });
    });
  });
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
