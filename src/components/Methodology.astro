---
import { Image } from 'astro:assets';
---

<section
  id="methodology"
  class="py-20 md:py-40 bg-white text-black relative overflow-hidden"
>
  <div
    class="absolute top-0 right-0 p-4 md:p-20 opacity-[0.03] pointer-events-none"
  >
    <h2
      class="text-[25vw] sm:text-[12rem] md:text-[16rem] lg:text-[20rem] leading-none font-black italic"
    >
      BCI
    </h2>
    <!-- BCI is the internal abbreviation for Bhavya Computer Classes, used as a decorative watermark -->
  </div>

  <div class="container mx-auto px-4 md:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
      <div>
        <div
          data-reveal="up"
          class="opacity-0 translate-y-8 md:translate-y-12 transition-all duration-1000 ease-out"
        >
          <h2
            class="text-4xl sm:text-5xl md:text-6xl lg:text-8xl leading-[0.9] mb-8 md:mb-12 break-words tracking-tight"
          >
            The<br />BHAVYA<br />Vision
          </h2>
          <p class="text-xl text-black/60 font-light leading-relaxed mb-8">
            Bhavya Computer Classes is dedicated to empowering students with
            practical, job-ready skills. Our library facility and expert faculty
            ensure every student succeeds.
          </p>
          <div class="mt-6 border-l-4 border-black/80 pl-5">
            <p class="text-sm text-black/50 uppercase tracking-widest">
              Library Available
            </p>
            <p class="text-black/70 mt-1 text-sm">
              Free access to our resource library for all enrolled students.
            </p>
          </div>

          <!-- Classroom Photo — real institute photo for trust/credibility -->
          <div class="mt-10 group relative rounded-2xl overflow-hidden shadow-2xl">
            <Image
              src="/images/classroom.png"
              alt="Inside Bhavya Computer Classes — computer lab with students"
              width="700"
              height="468"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <!-- Gradient overlay at the bottom for the caption -->
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/70 to-transparent"></div>
            <!-- Caption badge -->
            <div class="absolute bottom-4 left-4 flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 bg-white/10 backdrop-blur-sm border border-white/20 text-white text-xs font-semibold px-3 py-1.5 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                Est. 2010 · Kota, Rajasthan
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-16">
        {
          [
            {
              num: '01',
              title: 'Government Certified Courses',
              desc: 'RSCIT — Rajasthan State Certificate in IT. Recognized by the Government of Rajasthan for students and job-seekers.',
            },
            {
              num: '02',
              title: 'Distance & Online Education',
              desc: 'Enroll in UGC-recognized degrees — BA, BCom, BSc, MBA, BCA, MCA, and more after 12th or graduation.',
            },
            {
              num: '03',
              title: 'Digital Skills for Today',
              desc: 'From Excel to Python, Graphic Design to Web Development — build in-demand digital skills with hands-on training.',
            },
          ].map((item, idx) => (
            <div
              data-reveal="up"
              class="opacity-0 translate-y-8 transition-all duration-800 ease-out group border-t border-black/10 pt-8"
              style={`transition-delay: ${idx * 200}ms;`}
            >
              <div class="flex gap-8">
                <span class="text-sm font-bold opacity-30">{item.num}</span>
                <div>
                  <h4 class="text-2xl mb-4 group-hover:italic transition-all">
                    {item.title}
                  </h4>
                  <p class="text-black/50 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
