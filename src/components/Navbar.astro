            <span class="text-white font-bold text-base leading-none" style="font-family: 'Syne', sans-serif;">10+</span>
            <span class="text-white/40 text-[9px] text-center leading-tight mt-1" style="font-family: 'Outfit', sans-serif;">Courses</span>
          </div>
          <div class="flex flex-col items-center gap-0.5 p-2 rounded-lg bg-white/4 border border-white/6">
            <span class="text-white font-bold text-base leading-none" style="font-family: 'Syne', sans-serif;">5★</span>
            <span class="text-white/40 text-[9px] text-center leading-tight mt-1" style="font-family: 'Outfit', sans-serif;">Rated</span>
