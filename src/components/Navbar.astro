    <!-- Bottom CTA -->
    <div class="px-4 py-5 border-t border-white/6 space-y-3">

      <!-- Quick Stats Card -->
      <div class="rounded-xl bg-gradient-to-br from-white/5 to-white/2 border border-white/8 p-4 space-y-3">
        <p class="text-white/30 text-[10px] uppercase tracking-widest" style="font-family: 'Outfit', sans-serif;">Why Bhavya Career Institute?</p>
        <div class="grid grid-cols-3 gap-2">
          <div class="flex flex-col items-center gap-0.5 p-2 rounded-lg bg-white/4 border border-white/6">
            <span class="text-white font-bold text-base leading-none" style="font-family: 'Syne', sans-serif;">500+</span>
            <span class="text-white/40 text-[9px] text-center leading-tight mt-1" style="font-family: 'Outfit', sans-serif;">Students</span>
          </div>
