        href="/all-courses"
        class="drawer-cta-btn flex items-center justify-between w-full px-4 py-3.5 rounded-xl text-white text-sm font-semibold transition-all duration-300 active:scale-[0.97]"
        style="font-family: 'Outfit', sans-serif; background: linear-gradient(135deg, #7c3aed, #06b6d4);"
      >
