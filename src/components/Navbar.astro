      </a>
    </div>



    <!-- Hamburger button (mobile) -->
    <button
      id="mobile-menu-btn"
      aria-label="Open menu"
      class="mobile-menu-btn flex md:hidden flex-col justify-center items-center w-10 h-10 gap-[5px] rounded-full transition-all duration-300"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
