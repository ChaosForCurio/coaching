</div>

<style>
  .text-gradient-brand {
    background: linear-gradient(135deg, #a78bfa 0%, #22d3ee 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .nav-link {
    position: relative;
    color: rgba(255,255,255,0.65);
    transition: color 0.25s;
    font-size: 13.5px;
    letter-spacing: 0.01em;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: linear-gradient(90deg, #a78bfa, #22d3ee);
    border-radius: 2px;
    transition: width 0.3s cubic-bezier(0.16,1,0.3,1);
  }
  .nav-link:hover { color: rgba(255,255,255,1); }
  .nav-link:hover::after { width: 100%; }

  .hamburger-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: rgba(255,255,255,0.75);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s, width 0.3s;
  }
  #mobile-menu-btn.is-open .hamburger-bar:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  #mobile-menu-btn.is-open .hamburger-bar:nth-child(2) { opacity: 0; width: 0; }
  #mobile-menu-btn.is-open .hamburger-bar:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .logo-icon {
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
  }
  .logo-icon:hover {
    transform: scale(1.08) rotate(-3deg);
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 10px;
    color: rgba(255,255,255,0.5);
    font-size: 14.5px;
    font-weight: 500;
    font-family: 'Outfit', sans-serif;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    letter-spacing: 0.01em;
    position: relative;
  }
  .drawer-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
    color: rgba(255,255,255,0.4);
  }
  .drawer-link-arrow {
    display: flex;
    align-items: center;
    margin-left: auto;
    color: rgba(255,255,255,0.2);
    transition: color 0.2s, transform 0.2s;
  }
  .drawer-link:hover {
    background: rgba(255,255,255,0.05);
    color: rgba(255,255,255,1);
  }
  .drawer-link:hover .drawer-link-icon {
    background: rgba(167,139,250,0.12);
    border-color: rgba(167,139,250,0.3);
    color: #a78bfa;
  }
  .drawer-link:hover .drawer-link-arrow {
    color: rgba(255,255,255,0.5);
    transform: translateX(2px);
  }
  .drawer-link.active-link {
    background: rgba(167,139,250,0.1);
    color: #c4b5fd;
  }
  .drawer-link.active-link .drawer-link-icon {
    background: rgba(167,139,250,0.15);
    border-color: rgba(167,139,250,0.35);
    color: #a78bfa;
  }

  /* Submenu styles */
  .drawer-sublink {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: 8px;
    color: rgba(255,255,255,0.4);
    font-size: 13.5px;
    font-family: 'Outfit', sans-serif;
    transition: background 0.2s, color 0.2s;
  }
  .drawer-sublink:hover {
    background: rgba(255,255,255,0.03);
    color: rgba(255,255,255,0.9);
  }
  .drawer-sublink.active-sublink {
    color: #c4b5fd;
    background: rgba(167,139,250,0.05);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    const panel = document.getElementById('drawer-panel');
    const closeBtn = document.getElementById('drawer-close');

    function openDrawer() {
      if (!drawer || !backdrop || !panel || !menuBtn) return;
      drawer.style.pointerEvents = 'auto';
      backdrop.style.opacity = '1';
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');
      menuBtn.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer || !backdrop || !panel || !menuBtn) return;
      backdrop.style.opacity = '0';
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      menuBtn.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => { drawer.style.pointerEvents = 'none'; }, 400);
    }

    menuBtn?.addEventListener('click', () => {
      if (menuBtn.classList.contains('is-open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Close on link click + active state highlight
    const currentPath = window.location.pathname + window.location.hash;
    document.querySelectorAll('.drawer-link, .drawer-sublink').forEach(link => {
      const href = link.getAttribute('href');
      if (href) {
        const isCurrent = (href === currentPath) || 
                          (href !== '/' && window.location.pathname === href.split('#')[0]);
        if (isCurrent) {
          if (link.classList.contains('drawer-link')) {
            link.classList.add('active-link');
          } else {
            link.classList.add('active-sublink');
            const submenu = link.closest('.submenu-content');
            if (submenu) {
              submenu.classList.remove('hidden');
              submenu.classList.add('flex');
              const toggle = submenu.previousElementSibling?.querySelector('.submenu-toggle');
              const arrow = toggle?.querySelector('.submenu-arrow') as HTMLElement | null;
              if (arrow) arrow.style.transform = 'rotate(180deg)';
            }
          }
        }
      }
      link.addEventListener('click', closeDrawer);
    });

    // Submenu toggle logic
    document.querySelectorAll('.submenu-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-submenu');
        const submenu = document.getElementById(targetId || '');
        const arrow = btn.querySelector('.submenu-arrow') as HTMLElement | null;
        if (submenu && arrow) {
          const isHidden = submenu.classList.contains('hidden');
          if (isHidden) {
            submenu.classList.remove('hidden');
            submenu.classList.add('flex');
            arrow.style.transform = 'rotate(180deg)';
          } else {
            submenu.classList.remove('flex');
            submenu.classList.add('hidden');
            arrow.style.transform = '';
          }
        }
      });
    });

    // Navbar scroll effect
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      if (!navbar) return;
      if (window.scrollY > 30) {
        navbar.style.background = 'rgba(10,10,10,0.85)';
        navbar.style.backdropFilter = 'blur(20px)';
        navbar.style.borderBottom = '1px solid rgba(255,255,255,0.06)';
        navbar.style.paddingTop = '14px';
        navbar.style.paddingBottom = '14px';
      } else {
        navbar.style.background = 'transparent';
        navbar.style.backdropFilter = 'none';
        navbar.style.borderBottom = 'none';
        navbar.style.paddingTop = '20px';
        navbar.style.paddingBottom = '20px';
      }
    }, { passive: true });
  });
</script>
