          <button class="submenu-toggle p-3 text-white/30 hover:text-white transition-colors" data-submenu="submenu-about" aria-label="Toggle About Us submenu">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="submenu-arrow transition-transform duration-300"><polyline points="6 9 12 15 18 9"/></svg>
