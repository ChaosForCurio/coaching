---
import statsData from '../data/stats.json';
---

<section id="stats-section" class="stats-section">
  <div class="stats-container">
    <!-- Section tag -->
    <div class="stats-tag-wrap">
      <span class="stats-tag">
        <span class="stats-tag-dot">●</span>
        Our Track Record
      </span>
    </div>

    <!-- Heading -->
    <h2 class="stats-heading font-['Poppins']">
      Our Numbers Speak for Themselves
      <span class="stats-heading-sub font-['Noto_Sans_Devanagari']">हमारी उपलब्धियां और छात्रों का विश्वास</span>
    </h2>

    <!-- Grid -->
    <div class="stats-grid">
      <!-- Students Trained -->
      <div class="stat-card stat-card--blue stats-reveal" style="transition-delay:0ms;">
        <div class="stat-icon stat-icon--blue">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="stat-number" data-target={statsData.studentsTrained.count} data-suffix={statsData.studentsTrained.suffix} data-duration={statsData.studentsTrained.duration}>0+</div>
        <div class="stat-label">
          <span>{statsData.studentsTrained.labelEn}</span>
          <span class="stat-label-hi font-['Noto_Sans_Devanagari']">{statsData.studentsTrained.labelHi}</span>
        </div>
      </div>

      <!-- Years of Excellence -->
      <div class="stat-card stat-card--amber stats-reveal" style="transition-delay:100ms;">
        <div class="stat-icon stat-icon--amber">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div class="stat-number" data-target={statsData.yearsOfExcellence.count} data-suffix={statsData.yearsOfExcellence.suffix} data-duration={statsData.yearsOfExcellence.duration}>0+</div>
        <div class="stat-label">
          <span>{statsData.yearsOfExcellence.labelEn}</span>
          <span class="stat-label-hi font-['Noto_Sans_Devanagari']">{statsData.yearsOfExcellence.labelHi}</span>
        </div>
      </div>

      <!-- Placement Rate -->
      <div class="stat-card stat-card--green stats-reveal" style="transition-delay:200ms;">
        <div class="stat-icon stat-icon--green">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <div class="stat-number" data-target={statsData.placementRate.count} data-suffix={statsData.placementRate.suffix} data-duration={statsData.placementRate.duration}>0%</div>
        <div class="stat-label">
          <span>{statsData.placementRate.labelEn}</span>
          <span class="stat-label-hi font-['Noto_Sans_Devanagari']">{statsData.placementRate.labelHi}</span>
        </div>
      </div>

      <!-- Courses Offered -->
      <div class="stat-card stat-card--purple stats-reveal" style="transition-delay:300ms;">
        <div class="stat-icon stat-icon--purple">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
        </div>
        <div class="stat-number" data-target={statsData.certifiedCourses.count} data-suffix={statsData.certifiedCourses.suffix} data-duration={statsData.certifiedCourses.duration}>0+</div>
        <div class="stat-label">
          <span>{statsData.certifiedCourses.labelEn}</span>
          <span class="stat-label-hi font-['Noto_Sans_Devanagari']">{statsData.certifiedCourses.labelHi}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section {
    background: #FFFFFF;
    padding: 72px 0;
  }

  .stats-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .stats-tag-wrap {
    text-align: center;
    margin-bottom: 18px;
  }

  .stats-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245,166,35,0.10);
    border: 1px solid rgba(245,166,35,0.4);
    color: #07366C;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 18px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .stats-tag-dot {
    color: #F5A623;
    font-size: 10px;
  }

  .stats-heading {
    text-align: center;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: #07366C;
    margin-bottom: 48px;
    line-height: 1.25;
  }

  .stats-heading-sub {
    display: block;
    font-size: clamp(14px, 1.8vw, 17px);
    font-weight: 500;
    color: #F39A18;
    margin-top: 8px;
    letter-spacing: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .stat-card {
    background: #fff;
    border: 1px solid #E1E8F1;
    border-radius: 16px;
    padding: 28px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.28s ease, box-shadow 0.28s ease;
    cursor: default;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(7,54,108,0.12);
  }

  .stat-card--blue  { border-top: 4px solid #3B82F6; }
  .stat-card--amber { border-top: 4px solid #F5A623; }
  .stat-card--green { border-top: 4px solid #22C55E; }
  .stat-card--purple{ border-top: 4px solid #8B5CF6; }

  .stat-icon {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .stat-icon--blue   { background: rgba(59,130,246,0.10); color: #3B82F6; }
  .stat-icon--amber  { background: rgba(245,166,35,0.12); color: #D97706; }
  .stat-icon--green  { background: rgba(34,197,94,0.10);  color: #16A34A; }
  .stat-icon--purple { background: rgba(139,92,246,0.10); color: #7C3AED; }

  .stat-number {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 900;
    color: #07366C;
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 13.5px;
    color: #082B63;
    font-weight: 600;
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
  }

  .stat-label-hi {
    font-size: 12px;
    color: #6B7A90;
    font-weight: 500;
  }

  .stats-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .stats-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 420px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Reveal on scroll
  const reveals = document.querySelectorAll<HTMLElement>('.stats-reveal');
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('stats-visible');
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  reveals.forEach(el => revealObs.observe(el));

  // Counter animation
  function easeOut(t: number) { return 1 - Math.pow(1 - t, 3); }

  function animateCounter(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    const suffix = el.dataset.suffix || '';
    const duration = parseInt(el.dataset.duration || '2000', 10);
    const startTime = performance.now();

    const tick = (now: number) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const value = Math.floor(easeOut(progress) * target);
      el.textContent = value.toLocaleString('en-IN') + suffix;
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const statNums = document.querySelectorAll<HTMLElement>('.stat-number[data-target]');
  const counterObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateCounter(e.target as HTMLElement);
        counterObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  statNums.forEach(el => counterObs.observe(el));
</script>
