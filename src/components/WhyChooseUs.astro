---
/**
 * WhyChooseUs.astro — Our Programs section (redesigned as msbif.org style)
 * 6 course program cards in a 3-column grid with topic-specific images.
 */
import { getOptimizedImageUrl } from '../utils/cloudinary';

const rscitImg = getOptimizedImageUrl('/images/programs/rscit.jpg', { width: 600, quality: 'auto', format: 'auto' });
const dcaImg = getOptimizedImageUrl('/images/programs/dca.jpg', { width: 600, quality: 'auto', format: 'auto' });
const tallyImg = getOptimizedImageUrl('/images/programs/tally.jpg', { width: 600, quality: 'auto', format: 'auto' });
const webDevImg = getOptimizedImageUrl('/images/programs/web-dev.jpg', { width: 600, quality: 'auto', format: 'auto' });
const graphicDesignImg = getOptimizedImageUrl('/images/programs/graphic-design.jpg', { width: 600, quality: 'auto', format: 'auto' });
const digitalMarketingImg = getOptimizedImageUrl('/images/programs/digital-marketing.jpg', { width: 600, quality: 'auto', format: 'auto' });
---

<section id="our-programs" class="programs-section">
  <div class="programs-container">
    <!-- Section tag -->
    <div class="programs-tag-wrap">
      <span class="programs-tag">
        <span class="programs-tag-dot">●</span>
        <span>Our Programs</span>
        <span style="color:#D88B08; margin: 0 4px;">•</span>
        <span class="font-['Noto_Sans_Devanagari']">प्रमुख कोर्स प्रोग्राम्स</span>
      </span>
    </div>

    <!-- Heading -->
    <h2 class="programs-heading font-['Poppins']">
      Our Key <span style="color:#D88B08;">Course Programs</span>
      <span class="programs-heading-sub font-['Noto_Sans_Devanagari']">सरकारी मान्यता प्राप्त एवं जॉब-ओरिएंटेड कंप्यूटर कोर्सेज</span>
    </h2>
    <p class="programs-subtitle font-['Noto_Sans_Devanagari']">
      शुरुआती स्तर से लेकर एडवांस स्तर तक — हर कोर्स आपको व्यावहारिक ज्ञान और उज्ज्वल करियर के लिए तैयार करता है।
    </p>

    <!-- Cards Grid -->
    <div class="programs-grid">

      <!-- 1. RSCIT -->
      <article class="prog-card">
        <div class="prog-img-area">
          <img
            src={rscitImg}
            alt="RSCIT Computer Course"
            class="prog-card-img"
            loading="lazy"
          />
          <div class="prog-img-overlay"></div>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">RSCIT</h3>
          <span class="prog-subtitle-tag" style="color:#E65100;">Govt. Certified IT • राजस्थान सरकार मान्यता प्राप्त</span>
          <p class="prog-desc">
            राजस्थान स्टेट सर्टिफिकेट इन इंफॉर्मेशन टेक्नोलॉजी (RSCIT) — सरकारी नौकरियों के लिए आवश्यक। प्रवेश पर 2 डिजिटल कोर्स निःशुल्क।
          </p>
        </div>
      </article>

      <!-- 2. DCA -->
      <article class="prog-card">
        <div class="prog-img-area">
          <img
            src={dcaImg}
            alt="DCA Diploma in Computer Applications"
            class="prog-card-img"
            loading="lazy"
          />
          <div class="prog-img-overlay"></div>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">DCA</h3>
          <span class="prog-subtitle-tag" style="color:#1565C0;">Diploma in Computer Applications • 1-वर्षीय डिप्लोमा</span>
          <p class="prog-desc">
            कंप्यूटर फंडामेंटल्स, एमएस ऑफिस, इंटरनेट व टैली बेसिक्स का संपूर्ण डिप्लोमा कोर्स। प्राइवेट व सरकारी सेक्टर के लिए आदर्श।
          </p>
        </div>
      </article>

      <!-- 3. Tally Prime -->
      <article class="prog-card">
        <div class="prog-img-area">
          <img
            src={tallyImg}
            alt="Tally Prime GST Accounting"
            class="prog-card-img"
            loading="lazy"
          />
          <div class="prog-img-overlay"></div>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Tally Prime</h3>
          <span class="prog-subtitle-tag" style="color:#2E7D32;">Finance &amp; GST Accounting • वित्तीय लेखांकन</span>
          <p class="prog-desc">
            जीएसटी इनवॉइसिंग, लेजर अकाउंटिंग, ई-वे बिल और बैलेंस शीट रिपोर्टिंग सीखें। कॉमर्स व एकाउंट्स में शानदार करियर अवसर।
          </p>
        </div>
      </article>

      <!-- 4. Web Development -->
      <article class="prog-card">
        <div class="prog-img-area">
          <img
            src={webDevImg}
            alt="Web Development and Coding"
            class="prog-card-img"
            loading="lazy"
          />
          <div class="prog-img-overlay"></div>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Web Development</h3>
          <span class="prog-subtitle-tag" style="color:#AD1457;">Full-Stack &amp; Python • वेबसाइट व ऐप निर्माण</span>
          <p class="prog-desc">
            HTML, CSS, JavaScript, React और Python प्रोग्रामिंग के साथ आधुनिक वेब एप्लीकेशन्स बनाना सीखें। लाइव प्रोजेक्ट्स शामिल।
          </p>
        </div>
      </article>

      <!-- 5. Graphic Design -->
      <article class="prog-card">
        <div class="prog-img-area">
          <img
            src={graphicDesignImg}
            alt="Graphic Design & Multimedia"
            class="prog-card-img"
            loading="lazy"
          />
          <div class="prog-img-overlay"></div>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Graphic Design</h3>
          <span class="prog-subtitle-tag" style="color:#BF360C;">Photoshop &amp; CorelDRAW • ग्राफिक डिजाइनिंग</span>
          <p class="prog-desc">
            फोटो एडिटिंग, बैनर डिजाइन, सोशल मीडिया पोस्ट और प्रिंट पब्लिशिंग (DTP) में दक्ष बनें। फ्रीलांसिंग व एजेंसी जॉब्स के लिए उत्तम।
          </p>
        </div>
      </article>

      <!-- 6. Digital Marketing -->
      <article class="prog-card">
        <div class="prog-img-area">
          <img
            src={digitalMarketingImg}
            alt="Digital Marketing & Social Media"
            class="prog-card-img"
            loading="lazy"
          />
          <div class="prog-img-overlay"></div>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Digital Marketing</h3>
          <span class="prog-subtitle-tag" style="color:#6A1B9A;">SEO &amp; Social Media • डिजिटल मार्केटिंग</span>
          <p class="prog-desc">
            गूगल एड्स, एसईओ (SEO), सोशल मीडिया कैंपेन और ब्रांड प्रमोशन की तकनीकें सीखकर ऑनलाइन व्यापार व करियर में आगे बढ़ें।
          </p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .programs-section {
    background: #F5F8FC;
    padding: 82px 0 88px;
  }

  .programs-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .programs-tag-wrap {
    text-align: center;
    margin-bottom: 18px;
  }

  .programs-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245,166,35,0.10);
    border: 1px solid rgba(245,166,35,0.4);
    color: #07366C;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 18px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .programs-tag-dot {
    color: #F5A623;
    font-size: 10px;
  }

  .programs-heading {
    text-align: center;
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 800;
    color: #07366C;
    margin-bottom: 14px;
    line-height: 1.25;
  }

  .programs-heading-sub {
    display: block;
    font-size: clamp(14px, 1.8vw, 18px);
    font-weight: 600;
    color: #F39A18;
    margin-top: 8px;
    letter-spacing: 0;
  }

  .programs-subtitle {
    text-align: center;
    color: #4A5568;
    font-size: 15.5px;
    max-width: 650px;
    margin: 0 auto 52px;
    line-height: 1.65;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .prog-card {
    background: #fff;
    border: 1px solid #E1E8F1;
    border-radius: 19px;
    box-shadow: 0 8px 28px rgba(7,54,108,0.07);
    overflow: hidden;
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    display: flex;
    flex-direction: column;
  }

  .prog-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 20px 50px rgba(7,54,108,0.14);
    border-color: #F5A623;
  }

  .prog-card:hover .prog-card-img {
    transform: scale(1.05);
  }

  .prog-img-area {
    height: 200px;
    position: relative;
    overflow: hidden;
    background: #E8EEF5;
  }

  .prog-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .prog-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 54, 108, 0.05) 0%, rgba(7, 54, 108, 0.25) 100%);
    pointer-events: none;
  }

  .prog-accent-bar {
    height: 5px;
    background: linear-gradient(90deg, #07366C, #F5A623, #FFD166);
  }

  .prog-body {
    padding: 24px 22px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .prog-title {
    font-size: 20px;
    font-weight: 800;
    color: #07366C;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .prog-subtitle-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
    display: block;
  }

  .prog-desc {
    font-size: 14px;
    color: #5A687A;
    line-height: 1.65;
    flex: 1;
    margin-bottom: 18px;
  }

  .prog-btn {
    display: inline-block;
    background: linear-gradient(135deg, #F5A623, #FFD166);
    color: #07366C;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 20px;
    border-radius: 9px;
    text-decoration: none;
    align-self: flex-start;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .prog-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(245,166,35,0.4);
  }

  @media (max-width: 1024px) {
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
