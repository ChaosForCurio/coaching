---
/**
 * WhyChooseUs.astro — Our Programs section (redesigned as msbif.org style)
 * 6 course program cards in a 3-column grid with gradient icon areas.
 */
---

<section id="our-programs" class="programs-section">
  <div class="programs-container">
    <!-- Section tag -->
    <div class="programs-tag-wrap">
      <span class="programs-tag">
        <span class="programs-tag-dot">●</span>
        Our Programs &bull; Our Commitment
      </span>
    </div>

    <!-- Heading -->
    <h2 class="programs-heading">
      Our Key <span style="color:#D88B08;">Course Programs</span>
    </h2>
    <p class="programs-subtitle">
      From government certifications to professional skills — every course designed for real-world success.
    </p>

    <!-- Cards Grid -->
    <div class="programs-grid">

      <!-- 1. RSCIT -->
      <article class="prog-card">
        <div class="prog-img-area" style="background: linear-gradient(135deg, #FFF3E0, #FFCC80);">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#E65100" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">RSCIT</h3>
          <span class="prog-subtitle-tag" style="color:#E65100;">Govt. Certified IT</span>
          <p class="prog-desc">Rajasthan State Certificate in IT — recognized by Government of Rajasthan. Includes 2 Digital Courses FREE on admission.</p>
          <a href="/all-courses" class="prog-btn">More Details &rarr;</a>
        </div>
      </article>

      <!-- 2. DCA -->
      <article class="prog-card">
        <div class="prog-img-area" style="background: linear-gradient(135deg, #E3F2FD, #90CAF9);">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#1565C0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">DCA</h3>
          <span class="prog-subtitle-tag" style="color:#1565C0;">Diploma in Computer Applications</span>
          <p class="prog-desc">The most complete foundation course covering MS Office, Internet, Tally basics & more. Government recognized certificate.</p>
          <a href="/all-courses" class="prog-btn">More Details &rarr;</a>
        </div>
      </article>

      <!-- 3. Tally Prime -->
      <article class="prog-card">
        <div class="prog-img-area" style="background: linear-gradient(135deg, #E8F5E9, #A5D6A7);">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Tally Prime</h3>
          <span class="prog-subtitle-tag" style="color:#2E7D32;">Finance &amp; Accounting</span>
          <p class="prog-desc">Complete Tally ERP with practical GST, invoicing, ledgers, and financial reporting for business &amp; commerce professionals.</p>
          <a href="/all-courses" class="prog-btn">More Details &rarr;</a>
        </div>
      </article>

      <!-- 4. Web Development -->
      <article class="prog-card">
        <div class="prog-img-area" style="background: linear-gradient(135deg, #FCE4EC, #F48FB1);">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#AD1457" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Web Development</h3>
          <span class="prog-subtitle-tag" style="color:#AD1457;">Full-Stack Programming</span>
          <p class="prog-desc">Build dynamic websites with PHP &amp; React. Includes Python Programming Basic &amp; Advanced with live projects.</p>
          <a href="/all-courses" class="prog-btn">More Details &rarr;</a>
        </div>
      </article>

      <!-- 5. Graphic Design -->
      <article class="prog-card">
        <div class="prog-img-area" style="background: linear-gradient(135deg, #FFF3E0, #FFAB91);">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#BF360C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </svg>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Graphic Design</h3>
          <span class="prog-subtitle-tag" style="color:#BF360C;">Creative Digital Suite</span>
          <p class="prog-desc">Photoshop, CorelDRAW, DTP &amp; digital publishing — develop creative skills for print and digital media.</p>
          <a href="/all-courses" class="prog-btn">More Details &rarr;</a>
        </div>
      </article>

      <!-- 6. Digital Marketing -->
      <article class="prog-card">
        <div class="prog-img-area" style="background: linear-gradient(135deg, #EDE7F6, #CE93D8);">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#6A1B9A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 20V10"/>
            <path d="M12 20V4"/>
            <path d="M6 20v-6"/>
          </svg>
        </div>
        <div class="prog-accent-bar"></div>
        <div class="prog-body">
          <h3 class="prog-title">Digital Marketing</h3>
          <span class="prog-subtitle-tag" style="color:#6A1B9A;">Online Growth Skills</span>
          <p class="prog-desc">SEO, social media marketing, Google Ads &amp; paid campaigns — learn to grow businesses in the digital era.</p>
          <a href="/all-courses" class="prog-btn">More Details &rarr;</a>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .programs-section {
    background: #F5F8FC;
    padding: 82px 0 88px;
  }

  .programs-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .programs-tag-wrap {
    text-align: center;
    margin-bottom: 18px;
  }

  .programs-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245,166,35,0.10);
    border: 1px solid rgba(245,166,35,0.4);
    color: #07366C;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 18px;
    border-radius: 100px;
    letter-spacing: 0.02em;
  }

  .programs-tag-dot {
    color: #F5A623;
    font-size: 10px;
  }

  .programs-heading {
    text-align: center;
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 800;
    color: #07366C;
    margin-bottom: 14px;
    line-height: 1.2;
  }

  .programs-subtitle {
    text-align: center;
    color: #5A687A;
    font-size: 16px;
    max-width: 600px;
    margin: 0 auto 52px;
    line-height: 1.65;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .prog-card {
    background: #fff;
    border: 1px solid #E1E8F1;
    border-radius: 19px;
    box-shadow: 0 8px 28px rgba(7,54,108,0.07);
    overflow: hidden;
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    display: flex;
    flex-direction: column;
  }

  .prog-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 20px 50px rgba(7,54,108,0.14);
    border-color: #F5A623;
  }

  .prog-img-area {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prog-accent-bar {
    height: 5px;
    background: linear-gradient(90deg, #07366C, #F5A623, #FFD166);
  }

  .prog-body {
    padding: 24px 22px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .prog-title {
    font-size: 20px;
    font-weight: 800;
    color: #07366C;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .prog-subtitle-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
    display: block;
  }

  .prog-desc {
    font-size: 14px;
    color: #5A687A;
    line-height: 1.65;
    flex: 1;
    margin-bottom: 18px;
  }

  .prog-btn {
    display: inline-block;
    background: linear-gradient(135deg, #F5A623, #FFD166);
    color: #07366C;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 20px;
    border-radius: 9px;
    text-decoration: none;
    align-self: flex-start;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .prog-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(245,166,35,0.4);
  }

  @media (max-width: 1024px) {
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
