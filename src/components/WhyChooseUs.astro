---
/**
 * WhyChooseUs.astro — Key Highlights & Features Row
 * Visual grid showcasing Government Certification, 15+ Yrs Faculty, and Placement Support.
 */
---

<section id="why-choose-us" class="relative bg-[#060606] py-20 px-4 sm:px-8 border-b border-white/5 overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-emerald-500/5 blur-[120px] rounded-full"></div>

  <div class="relative z-10 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.55em] text-emerald-400 font-semibold mb-3">
        <span class="w-5 h-px bg-emerald-500/30"></span>
        Why Bhavya Computer Classes
        <span class="w-5 h-px bg-emerald-500/30"></span>
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Built for Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">Career Success</span>
      </h2>
      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto mt-4 font-normal">
        We combine government recognition, hands-on lab practice, and active job placement to prepare you for the real world.
      </p>
    </div>

    <!-- 3-Column Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Feature 1: Govt Certification -->
      <div class="group relative p-8 rounded-3xl bg-white/[0.02] border border-white/10 hover:border-emerald-500/40 hover:bg-white/[0.04] transition-all duration-300 flex flex-col justify-between">
        <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
          📜
        </div>
        <div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
            Govt. Certified Center
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Official training provider for RSCIT &amp; DCA courses recognized across Rajasthan government jobs, contractual positions, and private sector firms.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs text-emerald-400 font-medium">
          <span>Valid for Govt Jobs</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </div>

      <!-- Feature 2: Practical Lab & Expert Faculty -->
      <div class="group relative p-8 rounded-3xl bg-white/[0.02] border border-white/10 hover:border-amber-500/40 hover:bg-white/[0.04] transition-all duration-300 flex flex-col justify-between">
        <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
          👨‍💻
        </div>
        <div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-amber-300 transition-colors">
            100% Practical Labs
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Modern computer labs with high-speed internet, silent library facilities, and 1-on-1 guidance from instructors with over 15 years of teaching experience.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs text-amber-400 font-medium">
          <span>Personal Attention</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </div>

      <!-- Feature 3: Job Placement Support -->
      <div class="group relative p-8 rounded-3xl bg-white/[0.02] border border-white/10 hover:border-purple-500/40 hover:bg-white/[0.04] transition-all duration-300 flex flex-col justify-between">
        <div class="w-14 h-14 rounded-2xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
          💼
        </div>
        <div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-purple-300 transition-colors">
            Placement Assistance
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Resume building, mock interviews, and direct referral connections to top local accounting firms, IT agencies, and businesses in Kota &amp; Rajasthan.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-2 text-xs text-purple-400 font-medium">
          <span>Resume &amp; Interview Prep</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
      </div>

    </div>
  </div>
</section>
