---
---

<section
  id="hero-section"
  style="background-image: url('/images/hero-bg.jpg'); background-size: cover; background-position: center; min-height: 600px; display: flex; align-items: center; position: relative;"
>
  <!-- Subtle contrast overlay instead of whitish overlay -->
  <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7, 30, 60, 0.45) 0%, rgba(7, 30, 60, 0.15) 60%, rgba(7, 30, 60, 0.3) 100%);"></div>

  <!-- Content -->
  <div style="max-width: 1240px; margin: 0 auto; padding: 80px 35px; position: relative; z-index: 1; width: 100%;">
    <div class="hero-content">
      <!-- Tag pill -->
      <div class="hero-tag-pill">
        <span style="color: #F5A623; margin-right: 6px;">●</span>
        Computer Education &bull; Skill Development &bull; Career Growth
      </div>

      <!-- H1 -->
      <h1 class="hero-h1">Kota's Leading Computer Training Institute</h1>

      <!-- Description with amber left border -->
      <p class="hero-desc">
        Bhavya Career Institute — Kota's government-certified computer training institute. Learn DCA, Tally Prime, Python, RSCIT &amp; Web Development with 100% placement support.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-cta-row">
        <button
          type="button"
          data-open-demo-modal
          class="hero-btn-primary"
        >
          Book Free Demo Class &rarr;
        </button>
        <a href="/all-courses" class="hero-btn-secondary">
          Explore All Courses &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-content {
    max-width: 650px;
  }

  .hero-tag-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid #F5A623;
    background: #fff;
    color: #07366C;
    font-size: 13px;
    font-weight: 600;
    padding: 7px 18px;
    border-radius: 100px;
    margin-bottom: 28px;
    letter-spacing: 0.01em;
  }

  .hero-h1 {
    color: #FFFFFF;
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  .hero-desc {
    background: rgba(255,255,255,0.92);
    border-left: 4px solid #F5A623;
    padding: 15px 19px;
    border-radius: 0 10px 10px 0;
    color: #26384D;
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 580px;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .hero-btn-primary {
    background: linear-gradient(135deg, #F5A623, #FFD166);
    color: #07366C;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 30px;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 18px rgba(245,166,35,0.35);
  }
  .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(245,166,35,0.5);
  }

  .hero-btn-secondary {
    display: inline-block;
    border: 2px solid #FFFFFF;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 15px;
    padding: 13px 28px;
    border-radius: 100px;
    text-decoration: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-btn-secondary:hover {
    background: #FFFFFF;
    border-color: #FFFFFF;
    color: #07366C;
    text-shadow: none;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 600px) {
    #hero-section > div {
      padding: 48px 20px !important;
    }
    .hero-h1 {
      font-size: clamp(28px, 7.2vw, 36px);
    }
    .hero-cta-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
