---

---

<section
  id="hero-section"
  class="relative w-full bg-[#0a0a0a] overflow-hidden flex flex-col items-center select-none"
  style="min-height: clamp(560px, 100svh, 100svh);"
>
  <!-- Visual Background Image with Gradients & Grid Overlay -->
  <div class="absolute inset-0 z-0">
    <!-- Background image — responsive position shifts focus on portrait/mobile -->
    <div
      class="absolute inset-0 opacity-90 hero-bg-parallax"
      style="
        background-image: url('/images/hero-bg.jpg');
        background-size: cover;
        background-position: center top;
        background-repeat: no-repeat;
        transform: scale(1.04);
        transform-origin: center center;
        will-change: transform;
      "
    >
    </div>

    <!-- Top vignette -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/60 via-transparent to-[#0a0a0a]/80"
    >
    </div>

    <!-- Bottom fade -->
    <div
      class="absolute inset-x-0 bottom-0 h-32 md:h-52 bg-gradient-to-t from-[#0a0a0a] to-transparent"
    >
    </div>

    <!-- Left & right edge vignettes -->
    <div
      class="absolute inset-y-0 left-0 w-16 md:w-24 bg-gradient-to-r from-[#0a0a0a]/50 to-transparent hidden sm:block"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 w-16 md:w-24 bg-gradient-to-l from-[#0a0a0a]/50 to-transparent hidden sm:block"
    >
    </div>

    <!-- Soft dynamic light orbs -->
    <div class="absolute inset-0 pointer-events-none hero-light-orbs"></div>
  </div>

  <!-- Hero Content -->
  <div
    class="relative z-10 flex flex-col items-center justify-center flex-1 w-full text-center px-4 sm:px-6 md:px-8 max-w-6xl mx-auto"
    style="min-height: inherit;"
  >


    <!-- Main Heading -->
    <h1
      class="hero-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight mb-5 text-white"
      style="font-family: 'Syne', sans-serif; opacity: 0; transform: translateY(30px);"
    >
      Kota's <span class="hero-plain-text">Best Computer</span><br />
      <span class="hero-plain-text">Classes</span>
    </h1>

    <!-- Subheadline -->
    <p
      class="hero-sub text-white/55 text-base sm:text-lg md:text-xl max-w-2xl leading-relaxed mb-8"
      style="font-family: 'Inter', sans-serif; opacity: 0; transform: translateY(24px);"
    >
      Learn <strong class="text-white/80">DCA, Tally Prime, Python, RSCIT, Web Development</strong> &
      Digital Marketing. Practical training with 100% placement support.
    </p>

    <!-- Trust Badges Row -->
    <div
      class="hero-trust flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-8"
      style="opacity: 0; transform: translateY(20px);"
    >
      <div class="trust-badge">
        <span class="trust-icon">🎓</span>
        <span>5,000+ Students</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <span class="trust-icon">⏱️</span>
        <span>15+ Years</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <span class="trust-icon">✅</span>
        <span>Govt. Certified</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-badge">
        <span class="trust-icon">💼</span>
        <span>100% Placement</span>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div
      class="hero-ctas flex flex-col sm:flex-row items-center gap-3 sm:gap-4"
      style="opacity: 0; transform: translateY(20px);"
    >
      <!-- Primary: Explore Courses -->
      <a
        href="/all-courses"
        id="hero-courses-btn"
        class="group flex items-center gap-2.5 px-8 py-3.5 rounded-full bg-white text-black font-semibold text-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(255,255,255,0.2)]"
        style="font-family: 'Outfit', sans-serif;"
      >
        Explore Courses
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>

      <!-- Secondary: Contact -->
      <a
        href="/contact"
        id="hero-contact-btn"
        class="group flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/18 border border-white/15 hover:border-white/30 text-white font-semibold text-sm transition-all duration-300 hover:-translate-y-0.5 backdrop-blur-md"
        style="font-family: 'Outfit', sans-serif;"
      >
        Contact Us
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Scroll hint -->
    <div
      class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
      style="opacity: 0;"
    >
      <span class="text-white/25 text-[10px] uppercase tracking-[0.4em]" style="font-family: 'Outfit', sans-serif;">Scroll</span>
      <div class="scroll-line"></div>
    </div>
  </div>
</section>

<style>
  /* Plain white text */
  .hero-plain-text {
    color: #ffffff;
  }

  /* Trust badges */
  .trust-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    color: rgba(255,255,255,0.65);
    letter-spacing: 0.02em;
  }
  .trust-icon {
    font-size: 14px;
  }
  .trust-divider {
    width: 1px;
    height: 14px;
    background: rgba(255,255,255,0.15);
  }

  /* Scroll indicator */
  .scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.4), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 0.8; transform: scaleY(1.15); }
  }

  /* Orb animation */
  @keyframes orbFlow {
    0% { background: radial-gradient(circle at 40% 40%, rgba(167,139,250,0.07) 0%, transparent 55%); }
    33% { background: radial-gradient(circle at 60% 60%, rgba(34,211,238,0.06) 0%, transparent 55%); }
    66% { background: radial-gradient(circle at 30% 70%, rgba(16,185,129,0.05) 0%, transparent 55%); }
    100% { background: radial-gradient(circle at 40% 40%, rgba(167,139,250,0.07) 0%, transparent 55%); }
  }
  .hero-light-orbs {
    animation: orbFlow 15s ease-in-out infinite;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Staggered entrance animations
    const badge = document.querySelector('.hero-badge') as HTMLElement;
    const heading = document.querySelector('.hero-heading') as HTMLElement;
    const sub = document.querySelector('.hero-sub') as HTMLElement;
    const trust = document.querySelector('.hero-trust') as HTMLElement;
    const ctas = document.querySelector('.hero-ctas') as HTMLElement;
    const scroll = document.querySelector('.hero-scroll') as HTMLElement;

    const animateIn = (el: HTMLElement | null, delay: number) => {
      if (!el) return;
      setTimeout(() => {
        el.style.transition = 'opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1)';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      }, delay);
    };

    animateIn(heading, 100);
    animateIn(sub, 260);
    animateIn(trust, 400);
    animateIn(ctas, 520);
    setTimeout(() => {
      if (scroll) {
        scroll.style.transition = 'opacity 1s ease';
        scroll.style.opacity = '1';
      }
    }, 1000);

    // Parallax on scroll
    const hero = document.getElementById('hero-section');
    const bg = hero?.querySelector('.hero-bg-parallax') as HTMLElement;
    if (!hero || !bg) return;

    let ticking = false;
    const onScroll = () => {
      const scrollY = window.scrollY;
      const rect = hero.getBoundingClientRect();
      if (rect.bottom > 0) {
        const progress = scrollY / window.innerHeight;
        const rotate = progress * 6;
        bg.style.transform = `scale(1.04) rotate(${rotate}deg)`;
      }
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  });
</script>
