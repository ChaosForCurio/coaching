---
import { Image } from 'astro:assets';
import facultyClassroomImg from '../../public/images/faculty-classroom.jpg';
import heroBgImg from '../../public/images/hero-bg.jpg';
import webDevImg from '../../public/images/web-dev.jpg';
const courses = [
  {
    num: '01',
    title: 'RSCIT',
    category: 'Government Certified',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
    image: facultyClassroomImg,
    description:
      'Rajasthan State Certificate in Information Technology. Recognized by Govt. of Rajasthan. Includes 2 Digital Courses FREE on admission.',
    badge: '2 Courses FREE',
    accent: '#f59e0b',
  },
  {
    num: '02',
    title: 'Tally & Accounting',
    category: 'Finance & Accounts',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>',
    image: heroBgImg,
    description:
      'Complete Tally ERP with practical GST, invoicing, ledgers, and financial reporting for business and commerce professionals.',
    accent: '#10b981',
  },
  {
    num: '03',
    title: 'Typing',
    category: 'Hindi & English',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>',
    image: webDevImg,
    description:
      'Professional Hindi and English typing courses built for government exam readiness and corporate job requirements.',
    accent: '#6366f1',
  },
  {
    num: '04',
    title: 'Web Development',
    category: 'Programming',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
    image: webDevImg,
    description:
      'Build dynamic websites with PHP and React. Includes Python Programming Basic & Advanced with live projects.',
    accent: '#ec4899',
  },
  {
    num: '05',
    title: 'Graphic Design',
    category: 'Creative Suite',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>',
    image: heroBgImg,
    description:
      'Photoshop, CorelDRAW, DTP and digital marketing — SEO, social media, and paid campaigns.',
    accent: '#f97316',
  },
  {
    num: '06',
    title: 'Python & AI',
    category: 'Advanced Tech',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>',
    image: webDevImg,
    description:
      'From basic syntax to ML fundamentals. Hands-on automation, data analysis, and real-world project building.',
    accent: '#22d3ee',
  },
];
---

<!-- Outer wrapper for scroll budget -->
<section id="courses-wrapper" class="relative bg-[#fafaf8]" style="height: 5000px;">
  
  <!-- Sticky viewport -->
  <div class="sticky top-0 h-screen overflow-hidden flex flex-col justify-center">

    <!-- Section header -->
    <div id="courses-header" class="absolute top-10 left-8 md:left-14 z-20 pointer-events-none select-none transition-all duration-300">
      <span class="text-[10px] uppercase tracking-[0.65em] text-[#1a1a2e]/40 block mb-2">
        Our Programs
      </span>
      <h2 class="text-6xl md:text-[7rem] leading-none">Programs</h2>
      <div class="flex items-center gap-2 mt-3">
        <div class="w-4 h-px bg-[#1a1a2e]/30"></div>
        <span class="text-[10px] uppercase tracking-[0.4em] text-[#1a1a2e]/40">
          Scroll to explore
        </span>
      </div>
    </div>

    <!-- Live card counter -->
    <div class="absolute top-10 right-8 md:right-14 z-20 pointer-events-none select-none text-right">
      <span class="text-[10px] text-[#1a1a2e]/50 uppercase tracking-widest block mb-1">
        Course
      </span>
      <div class="flex items-end justify-end gap-1">
        <span id="courses-counter" class="text-3xl font-black text-[#1a1a2e]/50 tabular-nums leading-none">
          01
        </span>
        <span class="text-[#1a1a2e]/30 text-base mb-0.5">/0{courses.length}</span>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="absolute bottom-8 left-8 right-8 z-20">
      <div class="relative h-px bg-[#1a1a2e]/10 overflow-hidden">
        <div id="courses-progress-bar" class="absolute inset-y-0 left-0 bg-[#1a1a2e]/60 origin-left scale-x-0"></div>
      </div>
      <div class="flex justify-between mt-2">
        <span class="text-[9px] uppercase tracking-[0.4em] text-[#1a1a2e]/50">
          Bhavya Computer Classes
        </span>
        <span class="text-[9px] uppercase tracking-[0.4em] text-[#1a1a2e]/50">
          {courses.length} Programs
        </span>
      </div>
    </div>

    <!-- Horizontal strip -->
    <div id="courses-strip" class="flex items-stretch gap-6 pl-[10vw]" style="will-change: transform;">
      {courses.map((course, idx) => (
        <article
          class="course-card group relative border bg-white backdrop-blur-md overflow-hidden h-[68vh] max-h-[560px] flex flex-col justify-between p-9 hover:bg-white hover:shadow-[0_12px_40px_rgba(26,26,46,0.1)] cursor-pointer rounded-xl"
          style={`width: clamp(280px, 85vw, 400px); flex-shrink: 0; border-color: ${course.accent}40; opacity: 0.15; transform: translateY(50px);`}
          data-index={idx}
          data-category={course.category}
        >
          <!-- Accent glow -->
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
            style={`background: radial-gradient(ellipse at 15% 85%, ${course.accent}22 0%, transparent 60%);`}
          ></div>

          <!-- Background image -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-[0.15] transition-opacity duration-700 pointer-events-none">
            <Image
              src={course.image}
              alt=""
              loading="lazy"
              class="w-full h-full object-cover grayscale mix-blend-overlay"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#fafaf8] via-[#fafaf8]/80 to-transparent"></div>
          </div>

          <!-- Top row: ghost number + icon -->
          <div class="relative z-10 flex justify-between items-start">
            <span
              class="font-black select-none leading-none group-hover:scale-105 transition-transform duration-500 origin-top-left"
              style={`font-size: clamp(64px, 15vw, 112px); color: ${course.accent}20; line-height: 0.85;`}
            >
              {course.num}
            </span>
            <div
              class="w-12 h-12 mt-1 flex items-center justify-center border border-[#1a1a2e]/10 group-hover:border-[#1a1a2e]/30 rounded-full group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-500 flex-shrink-0"
              style={`background: ${course.accent}22; color: rgba(26,26,46,0.7);`}
            >
              <Fragment set:html={course.icon} />
            </div>
          </div>

          <!-- Bottom content -->
          <div class="relative z-10 transform group-hover:-translate-y-2 transition-transform duration-500">
            <span
              class="text-[10px] font-medium uppercase tracking-[0.4em] mb-3 block transition-colors duration-500"
              style={`color: ${course.accent}; opacity: 0.8;`}
            >
              {course.category}
            </span>

            <h3 class="text-[2rem] md:text-[2.25rem] font-bold leading-tight mb-3 group-hover:translate-x-1.5 transition-transform duration-500">
              {course.title}
            </h3>

            {course.badge && (
              <span
                class="inline-block mb-5 text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 font-bold rounded-sm shadow-lg"
                style={`background: ${course.accent}; color: #fafaf8;`}
              >
                {course.badge}
              </span>
            )}

            <p class="text-[14px] text-[#1a1a2e]/70 leading-relaxed mb-6 max-w-[340px] opacity-60 group-hover:opacity-100 transition-opacity duration-500">
              {course.description}
            </p>

            <!-- Animated reveal line -->
            <div class="flex items-center gap-3 overflow-hidden">
              <div
                class="h-px w-0 group-hover:w-12 transition-all duration-500 ease-out"
                style={`background: ${course.accent};`}
              ></div>
              <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#1a1a2e]/40 group-hover:text-[#1a1a2e]/80 transition-colors duration-500">
                View Syllabus
              </span>
            </div>
          </div>

          <!-- Bottom accent stroke -->
          <div
            class="absolute bottom-0 left-0 h-[3px] w-0 group-hover:w-full transition-all duration-700 ease-out"
            style={`background: linear-gradient(90deg, ${course.accent} 0%, ${course.accent}00 100%);`}
          ></div>
        </article>
      ))}

      <!-- End CTA panel -->
      <div class="flex-shrink-0 w-[85vw] max-w-[320px] flex flex-col justify-center items-start px-8 md:px-16">
        <span class="text-[10px] uppercase tracking-[0.5em] text-[#1a1a2e]/40 mb-6 font-medium">
          Ready to start?
        </span>
        <h3 class="text-5xl md:text-6xl font-bold leading-tight mb-8">
          Enroll<br />Today
        </h3>
        <a
          href="https://wa.me/919694932391"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 border border-[#1a1a2e]/20 bg-[#1a1a2e]/5 text-[#1a1a2e] backdrop-blur-sm rounded-full px-8 py-4 hover:bg-[#1a1a2e] hover:text-[#fafaf8] transition-all duration-500"
        >
          <span class="text-[11px] font-bold uppercase tracking-[0.2em]">Chat on WhatsApp</span>
          <svg
            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <!-- Right breathing room so last card isn't flush to edge -->
      <div class="flex-shrink-0 w-[10vw]"></div>
    </div>
  </div>
</section>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Element refs ──────────────────────────────────────────────────────────────
  const wrapper     = document.getElementById('courses-wrapper')      as HTMLElement | null;
  const strip       = document.getElementById('courses-strip')        as HTMLElement | null;
  const stickyEl    = wrapper?.querySelector<HTMLElement>('.sticky');
  const header      = document.getElementById('courses-header')       as HTMLElement | null;
  const counter     = document.getElementById('courses-counter')      as HTMLElement | null;
  const progressBar = document.getElementById('courses-progress-bar') as HTMLElement | null;

  if (!wrapper || !strip || !stickyEl || !header || !counter || !progressBar) {
    console.warn('[Courses] Missing DOM elements — skipping scroll init');
  } else {

    // ── Lenis — smooth wheel/touch momentum ───────────────────────────────────
    // Lenis intercepts wheel/touch and re-dispatches via RAF.
    // We do NOT use scrollerProxy — that's only for virtual/custom scrollers
    // and causes a deadlock when used with the native document scroller.
    const lenis = new Lenis({
      lerp: 0.1,
      smoothWheel: true,
      touchMultiplier: 1.5,
    });

    // Feed Lenis's RAF into GSAP ticker so both run on the same clock
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // ── Measure total horizontal travel ──────────────────────────────────────
    let totalTravel = 0;
    let refreshScheduled = false;

    const measure = () => {
      totalTravel = Math.max(0, strip.scrollWidth - window.innerWidth);
      wrapper.style.height = `${window.innerHeight + totalTravel}px`;

      // Defer refresh to avoid re-entrancy (refresh can trigger resize events)
      if (!refreshScheduled) {
        refreshScheduled = true;
        requestAnimationFrame(() => {
          ScrollTrigger.refresh();
          refreshScheduled = false;
        });
      }
    };

    measure();

    // Debounced resize
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(measure, 120);
    }, { passive: true });

    // ── ScrollTrigger — horizontal scrub ──────────────────────────────────────
    // NO pin:true — the wrapper already has height = viewport + totalTravel set
    // manually, and the .sticky child provides CSS pinning. Adding pin:true
    // would double the scroll budget, causing the section to hang at exit.
    let currentSkew = 0;

    ScrollTrigger.create({
      trigger: wrapper,
      start: 'top top',
      end: () => `+=${totalTravel}`,
      scrub: 1,
      invalidateOnRefresh: true,

      onUpdate(self) {
        const prog = self.progress;
        const x    = prog * totalTravel;

        // Skew from velocity — interpolated to ease back to 0
        const vel        = self.getVelocity();
        const targetSkew = gsap.utils.clamp(-5, 5, -(vel / 2500) * 5);
        currentSkew     += (targetSkew - currentSkew) * 0.18;

        // ── Horizontal translate ────────────────────────────────────────────
        gsap.set(strip, { x: -x, skewX: currentSkew, force3D: true });

        // ── Header fade (first 6%) ──────────────────────────────────────────
        if (prog < 0.06) {
          const t = prog / 0.06;
          gsap.set(header, { opacity: 1 - t, y: -t * 24 });
        } else {
          gsap.set(header, { opacity: 0, y: -24 });
        }

        // ── Progress bar ────────────────────────────────────────────────────
        gsap.set(progressBar, { scaleX: prog, transformOrigin: 'left center' });

        // ── Counter ─────────────────────────────────────────────────────────
        const cards = Array.from(
          strip.querySelectorAll<HTMLElement>('.course-card:not([data-hidden="true"])')
        );
        const total = cards.length;
        if (total > 0) {
          const idx = Math.min(total, Math.max(1, Math.round(prog * (total - 1)) + 1));
          counter.textContent = idx.toString().padStart(2, '0');
        }

        // ── Card reveal ─────────────────────────────────────────────────────
        if (total > 0) {
          const seg = 1 / total;
          cards.forEach((card, i) => {
            const start = Math.max(0, i * seg - seg * 0.4);
            const end   = Math.min(1, start + seg * 0.8);
            const cp    = prog > start ? Math.min(1, (prog - start) / (end - start)) : 0;
            gsap.set(card, { opacity: 0.15 + 0.85 * cp, y: 50 - 50 * cp });
          });
        }
      },
    });

    // ── Expose recalc for category filtering ──────────────────────────────────
    window.recalcCoursesScroll = () => {
      strip.querySelectorAll<HTMLElement>('.course-card').forEach(c => {
        const hidden = c.classList.contains('hidden');
        c.style.display    = hidden ? 'none' : 'flex';
        c.dataset.hidden   = hidden ? 'true' : 'false';
      });
      setTimeout(measure, 60);
    };
  }
</script>

