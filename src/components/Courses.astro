---
/**
 * Courses.astro — About / Who We Are split-layout section (msbif.org style)
 * Replaces old horizontal scroll courses section.
 */
import { Image } from 'astro:assets';
import facultyClassroomImg from '../../public/images/faculty-classroom.jpg';
---

<section id="about-us" class="about-section">
  <div class="about-container">

    <!-- Eyebrow label -->
    <div class="about-eyebrow">
      <span class="about-eyebrow-bar"></span>
      <span class="about-eyebrow-text">WHO WE ARE</span>
    </div>

    <!-- Two-column grid -->
    <div class="about-grid">

      <!-- LEFT — Image block -->
      <div class="about-img-col">
        <div class="about-img-frame">
          <Image
            src={facultyClassroomImg}
            alt="Bhavya Career Institute Faculty &amp; Classroom"
            class="about-img"
            loading="lazy"
          />
          <!-- Caption overlay bottom-left -->
          <div class="about-img-caption">
            <span class="about-img-caption-icon">&#9733;</span>
            <div>
              <div class="about-img-caption-title">500+ Students Trained</div>
              <div class="about-img-caption-sub">Kota's Best Since 2010</div>
            </div>
          </div>
        </div>
        <!-- Decorative elements -->
        <div class="about-deco-corner"></div>
        <div class="about-deco-circle"></div>
      </div>

      <!-- RIGHT — Content -->
      <div class="about-content-col">
        <!-- Small tag badge -->
        <span class="about-badge">
          <span style="color:#F5A623; margin-right:6px;">●</span>
          <span>Bhavya Career Institute</span>
          <span style="color:#F5A623; margin: 0 4px;">•</span>
          <span class="font-['Noto_Sans_Devanagari']">भव्य करियर इंस्टीट्यूट</span>
        </span>

        <!-- Heading -->
        <h2 class="about-heading font-['Poppins']">
          Building Bridges Between Education and <span class="about-heading-span">Career Opportunities</span>.
          <span class="about-heading-sub font-['Noto_Sans_Devanagari']">शिक्षा, तकनीकी ज्ञान और रोजगार का मजबूत आधार</span>
        </h2>

        <!-- Amber divider -->
        <div class="about-amber-divider"></div>

        <!-- Description paragraphs -->
        <p class="about-para font-['Noto_Sans_Devanagari']">
          <strong>2010 से स्थापित</strong>, भव्य करियर इंस्टीट्यूट कोटा के विद्यार्थियों को आधुनिक कंप्यूटर शिक्षा और प्रैक्टिकल स्किल्स प्रदान कर रहा है। राजस्थान सरकार द्वारा मान्यता प्राप्त हमारा संस्थान सरकारी व निजी क्षेत्र में नौकरियों के लिए उच्चस्तरीय प्रशिक्षण देता है।
        </p>
        <p class="about-para">
          Our experienced faculty combines rigorous theoretical knowledge with hands-on lab practice — ensuring every student leaves with industry-recognized certificates and real-world competence.
        </p>

        <!-- Focus areas -->
        <div class="about-focus-label">
          <span class="about-focus-bar"></span>
          <span class="about-focus-text">Our Key Areas • हमारी प्रमुख विशेषताएं</span>
        </div>

        <div class="about-focus-grid">
          <!-- Card 1 -->
          <div class="focus-card">
            <div class="focus-icon focus-icon--blue">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
            <span class="focus-label">
              <span>Digital Literacy</span>
              <small class="block text-xs text-[#6B7A90] font-['Noto_Sans_Devanagari']">डिजिटल साक्षरता</small>
            </span>
          </div>
          <!-- Card 2 -->
          <div class="focus-card">
            <div class="focus-icon focus-icon--blue">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
            </div>
            <span class="focus-label">
              <span>Placement Support</span>
              <small class="block text-xs text-[#6B7A90] font-['Noto_Sans_Devanagari']">रोजगार मार्गदर्शन</small>
            </span>
          </div>
          <!-- Card 3 -->
          <div class="focus-card">
            <div class="focus-icon focus-icon--blue">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <span class="focus-label">
              <span>Govt. Certificates</span>
              <small class="block text-xs text-[#6B7A90] font-['Noto_Sans_Devanagari']">मान्यता प्राप्त प्रमाण पत्र</small>
            </span>
          </div>
          <!-- Card 4 -->
          <div class="focus-card">
            <div class="focus-icon focus-icon--blue">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <span class="focus-label">
              <span>Expert Faculty &amp; Labs</span>
              <small class="block text-xs text-[#6B7A90] font-['Noto_Sans_Devanagari']">आधुनिक कंप्यूटर लैब</small>
            </span>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="about-actions">
          <a href="/about-us" class="about-btn-primary">Learn More About Us &rarr;</a>
          <a href="/all-courses" class="about-btn-secondary">Explore All Courses</a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section {
    background: linear-gradient(135deg, #FFF9ED 0%, #FFFDF8 48%, #F0F5FC 100%);
    padding: 88px 0 94px;
  }

  .about-container {
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* Eyebrow */
  .about-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
  }

  .about-eyebrow-bar {
    display: block;
    width: 42px;
    height: 4px;
    background: linear-gradient(90deg, #F5A623, #FFD166);
    border-radius: 4px;
  }

  .about-eyebrow-text {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #07366C;
    text-transform: uppercase;
  }

  /* Two-column grid */
  .about-grid {
    display: grid;
    grid-template-columns: 0.94fr 1.06fr;
    gap: 56px;
    align-items: center;
  }

  /* Image column */
  .about-img-col {
    position: relative;
  }

  .about-img-frame {
    border: 7px solid #fff;
    border-radius: 26px;
    box-shadow: 0 24px 65px rgba(7,54,108,0.16);
    overflow: hidden;
    position: relative;
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Caption overlay */
  .about-img-caption {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: rgba(5,41,83,0.70);
    backdrop-filter: blur(8px);
    border-radius: 15px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-img-caption-icon {
    font-size: 20px;
    color: #FFD166;
    line-height: 1;
  }

  .about-img-caption-title {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }

  .about-img-caption-sub {
    font-size: 11px;
    color: rgba(255,255,255,0.70);
    margin-top: 2px;
  }

  /* Decorative elements */
  .about-deco-corner {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 60px;
    height: 60px;
    border-top: 4px solid #F5A623;
    border-right: 4px solid #F5A623;
    border-radius: 0 10px 0 0;
    pointer-events: none;
  }

  .about-deco-circle {
    position: absolute;
    bottom: -20px;
    left: -20px;
    width: 64px;
    height: 64px;
    background: #07366C;
    border-radius: 50%;
    opacity: 0.12;
    pointer-events: none;
  }

  /* Content column */
  .about-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(245,166,35,0.10);
    border: 1px solid rgba(245,166,35,0.4);
    color: #07366C;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .about-heading {
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 800;
    color: #07366C;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .about-heading-sub {
    display: block;
    font-size: clamp(14px, 1.8vw, 18px);
    font-weight: 600;
    color: #F39A18;
    margin-top: 8px;
    letter-spacing: 0;
  }

  .about-heading-span {
    position: relative;
    display: inline-block;
    color: #07366C;
    text-decoration: underline;
    text-decoration-color: #F5A623;
    text-underline-offset: 5px;
  }

  .about-amber-divider {
    width: 65px;
    height: 4px;
    background: linear-gradient(90deg, #F5A623, #FFD166);
    border-radius: 4px;
    margin-bottom: 22px;
  }

  .about-para {
    color: #26384D;
    font-size: 15px;
    line-height: 1.75;
    margin-bottom: 16px;
  }

  /* Focus areas */
  .about-focus-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    margin-bottom: 16px;
  }

  .about-focus-bar {
    display: block;
    width: 28px;
    height: 3px;
    background: #F5A623;
    border-radius: 3px;
  }

  .about-focus-text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #07366C;
    text-transform: uppercase;
  }

  .about-focus-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 30px;
  }

  .focus-card {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #E3EAF4;
    border-radius: 12px;
    padding: 14px 16px;
    min-height: 64px;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .focus-card:hover {
    border-color: #F5A623;
    box-shadow: 0 4px 16px rgba(7,54,108,0.08);
  }

  .focus-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .focus-icon--blue {
    background: rgba(59,130,246,0.10);
    color: #1D4ED8;
  }

  .focus-label {
    font-size: 13px;
    font-weight: 700;
    color: #07366C;
    line-height: 1.3;
  }

  /* Action buttons */
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  .about-btn-primary {
    display: inline-block;
    background: linear-gradient(135deg, #F5A623, #FFD166);
    color: #07366C;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 26px;
    border-radius: 9px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 16px rgba(245,166,35,0.3);
  }

  .about-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(245,166,35,0.45);
  }

  .about-btn-secondary {
    display: inline-block;
    border: 2px solid #07366C;
    color: #07366C;
    font-weight: 600;
    font-size: 14px;
    padding: 11px 24px;
    border-radius: 9px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .about-btn-secondary:hover {
    background: #07366C;
    color: #fff;
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .about-eyebrow {
      margin-bottom: 24px;
    }
    .about-focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
