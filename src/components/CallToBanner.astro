---
/**
 * CallToBanner.astro — Pre-footer conversion banner
 * High-impact section encouraging prospective students to book a free demo session.
 */
---

<section id="cta-banner" class="relative py-20 px-4 sm:px-8 bg-[#060606] overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <div class="relative rounded-3xl p-8 sm:p-12 md:p-16 bg-gradient-to-r from-emerald-950/60 via-gray-900 to-emerald-950/60 border border-emerald-500/30 text-center overflow-hidden shadow-2xl">
      <!-- Glow effect -->
      <div class="pointer-events-none absolute -top-24 -left-24 w-96 h-96 bg-emerald-500/10 blur-[100px] rounded-full"></div>
      <div class="pointer-events-none absolute -bottom-24 -right-24 w-96 h-96 bg-teal-500/10 blur-[100px] rounded-full"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        <span class="inline-block px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider border border-emerald-500/20">
          🎓 Start Learning Today
        </span>

        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Ready to Master <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-amber-300">New Computer Skills</span>?
        </h2>

        <p class="text-gray-300 text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
          Join 5,000+ successful students in Kota. Book a free 2-day demo class or ask about batch timings directly.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <button
            type="button"
            data-open-demo-modal
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm tracking-wider uppercase transition-all shadow-[0_0_30px_rgba(16,185,129,0.35)] hover:-translate-y-0.5 cursor-pointer"
          >
            Book Free Demo Class
          </button>
          <a
            href="https://wa.me/919694932391?text=Hi%20Bhavya%20Computer%20Classes,%20I%20want%20to%20enquire%20about%20courses%20and%20demo%20classes."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-sm tracking-wider uppercase transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2"
          >
            <span>Chat on WhatsApp</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
