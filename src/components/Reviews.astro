---
/**
 * Reviews.astro — "How We Train You" 4-step approach section
 * Replaces old testimonials slider with a clean static 4-card process section.
 */
---

<section id="how-we-train" class="approach-section">
  <div class="approach-container">
    <!-- Header -->
    <div class="approach-header">
      <span class="approach-tag">OUR APPROACH</span>
      <h2 class="approach-heading">How We Train You</h2>
      <div class="approach-divider"></div>
    </div>

    <!-- 4-step cards -->
    <div class="approach-grid">

      <!-- Step 1 -->
      <div class="step-card">
        <div class="step-num">01 / STEP</div>
        <div class="step-title">Enroll</div>
        <div class="step-label">GET STARTED</div>
        <p class="step-desc">Join with zero prior experience needed. Our team will guide you from day one.</p>
      </div>

      <!-- Step 2 -->
      <div class="step-card">
        <div class="step-num">02 / STEP</div>
        <div class="step-title">Learn</div>
        <div class="step-label">EXPERT TRAINING</div>
        <p class="step-desc">Hands-on practical training from experienced faculty with 15+ years of teaching.</p>
      </div>

      <!-- Step 3 -->
      <div class="step-card">
        <div class="step-num">03 / STEP</div>
        <div class="step-title">Practice</div>
        <div class="step-label">REAL PROJECTS</div>
        <p class="step-desc">Real projects, live labs, and mock tests to sharpen your skills before the job market.</p>
      </div>

      <!-- Step 4 -->
      <div class="step-card">
        <div class="step-num">04 / STEP</div>
        <div class="step-title">Succeed</div>
        <div class="step-label">CAREER LAUNCH</div>
        <p class="step-desc">Placement support + government certificate to kickstart your career with confidence.</p>
      </div>

    </div>
  </div>
</section>

<style>
  .approach-section {
    background: #F3F7FC;
    padding: 38px 18px 56px;
  }

  .approach-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .approach-header {
    text-align: center;
    margin-bottom: 44px;
  }

  .approach-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #5A687A;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .approach-heading {
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 800;
    color: #07366C;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .approach-divider {
    width: 55px;
    height: 4px;
    background: linear-gradient(90deg, #F5A623, #FFD166);
    border-radius: 4px;
    margin: 0 auto;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }

  .step-card {
    background: #fff;
    border: 1px solid #e2eaf4;
    border-bottom: 3px solid #F5A623;
    border-radius: 12px;
    padding: 22px 16px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(7,54,108,0.10);
  }

  .step-num {
    font-size: 11px;
    font-weight: 700;
    color: #F5A623;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .step-title {
    font-size: 28px;
    font-weight: 800;
    color: #07366C;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .step-label {
    font-size: 10px;
    font-weight: 700;
    color: #C47A0A;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .step-desc {
    font-size: 13px;
    color: #5A687A;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 767px) {
    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 360px) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
