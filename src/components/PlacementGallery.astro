---
import placementsData from '../data/placements.json';
---

<section class="py-20 bg-gray-900/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-4 font-outfit text-white">
        Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-blue-400">Placement Gallery</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Join the ranks of our successful alumni working in top companies worldwide.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
      {placementsData.map((student) => (
        <div class="group relative overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 aspect-[3/4]">
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-gray-800 animate-pulse"></div> <!-- Placeholder background -->
          
          <div class="absolute bottom-0 left-0 right-0 p-4 z-20 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
            <h4 class="text-white font-bold text-lg leading-tight mb-1">{student.name}</h4>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-semibold rounded-md border border-emerald-500/30">
                {student.company}
              </span>
            </div>
            <p class="text-gray-400 text-sm mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100">
              {student.role}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
