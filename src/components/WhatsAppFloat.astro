---
---

<!-- Floating WhatsApp Button -->
<a
  id="whatsapp-fab"
  href="https://wa.me/919694932391?text=Hi%2C%20I%27m%20interested%20in%20your%20computer%20courses%20at%20Bhavya%20Computer%20Classes%2C%20Kota."
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  class="whatsapp-fab"
>
  <!-- Pulse rings -->
  <span class="fab-ring fab-ring-1"></span>
  <span class="fab-ring fab-ring-2"></span>

  <!-- Icon -->
  <span class="fab-icon">
    <svg viewBox="0 0 24 24" fill="white" width="26" height="26" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.528 2.01 14.069.987 11.48.987 6.045.987 1.62 5.357 1.616 10.787c-.001 1.748.47 3.447 1.36 4.966l-1.001 3.655 3.748-.973.334.218zM18.82 15.111c-.37-.185-2.18-.897-2.52-1.021-.34-.124-.588-.185-.836.186-.248.37-.958 1.206-1.17 1.454-.216.247-.433.279-.803.093-.37-.185-1.56-.57-2.971-1.829-1.09-.973-1.826-2.176-2.04-2.547-.217-.37-.023-.57.162-.754.166-.165.37-.432.556-.65.186-.216.248-.37.372-.617.124-.247.062-.463-.03-.649-.093-.185-.837-2.006-1.146-2.748-.3-.721-.606-.624-.836-.636-.216-.011-.463-.014-.71-.014-.248 0-.65.093-.99.463-.34.37-1.3 1.266-1.3 3.087 0 1.82 1.33 3.582 1.516 3.829.186.247 2.612 3.987 6.326 5.586.883.38 1.572.607 2.11.779.887.282 1.696.242 2.335.146.711-.107 2.18-.89 2.49-1.752.31-.862.31-1.603.217-1.752-.093-.149-.34-.241-.71-.426z"/>
    </svg>
  </span>

  <!-- Tooltip label -->
  <span class="fab-tooltip" aria-hidden="true">Chat with us!</span>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    bottom: 28px;
    right: 24px;
    z-index: 9999;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25D366;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.45);
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s ease;
    text-decoration: none;
  }
  .whatsapp-fab:hover {
    transform: scale(1.12);
    box-shadow: 0 10px 40px rgba(37, 211, 102, 0.65);
  }
  .whatsapp-fab:hover .fab-tooltip {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Pulse rings */
  .fab-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.5);
    animation: fabPulse 2.4s ease-out infinite;
  }
  .fab-ring-2 {
    animation-delay: 0.8s;
  }
  @keyframes fabPulse {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(1.75); opacity: 0; }
  }

  .fab-icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  /* Tooltip */
  .fab-tooltip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateX(8px) translateY(-50%);
    white-space: nowrap;
    background: #111;
    color: #fff;
    font-size: 12px;
    font-family: 'Outfit', sans-serif;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.08);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .fab-tooltip::after {
    content: '';
    position: absolute;
    right: -5px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 5px 0 5px 5px;
    border-color: transparent transparent transparent #111;
  }

  /* Hide on very small screens, show from 360px */
  @media (max-width: 359px) {
    .whatsapp-fab {
      width: 50px;
      height: 50px;
      bottom: 18px;
      right: 14px;
    }
  }
</style>

<script>
  // Delay FAB entrance slightly so it doesn't fight with page load
  const fab = document.getElementById('whatsapp-fab');
  if (fab) {
    fab.style.opacity = '0';
    fab.style.transform = 'scale(0.5)';
    fab.style.transition = 'opacity 0.5s ease, transform 0.5s cubic-bezier(0.34,1.56,0.64,1)';
    setTimeout(() => {
      fab.style.opacity = '1';
      fab.style.transform = 'scale(1)';
    }, 1200);
  }
</script>
