<section
  id="contact-section"
  class="relative min-h-screen bg-[#0a0a0a] overflow-hidden py-28 px-5 sm:px-8 md:px-16"
>
  <!-- Background ambient glows -->
  <div class="pointer-events-none absolute inset-0 z-0">
    <div
      class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] rounded-full bg-white/5 blur-[130px]"
    >
    </div>
    <div
      class="absolute bottom-[-10%] right-[-5%] w-[500px] h-[500px] rounded-full bg-white/5 blur-[130px]"
    >
    </div>
    <div
      class="absolute top-[50%] left-[40%] w-[300px] h-[300px] rounded-full bg-white/5 blur-[100px]"
    >
    </div>
    <!-- Grid texture -->
    <div
      class="absolute inset-0 opacity-[0.025]"
      style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
  </div>

  <!-- Section header -->
  <div class="relative z-10 max-w-7xl mx-auto mb-16 reveal-item" data-reveal>
    <div class="flex flex-col sm:flex-row sm:items-end gap-4 sm:gap-8">
      <div class="flex-1">
        <span
          class="text-[10px] uppercase tracking-[0.5em] text-white/30 block mb-2"
          >Get In Touch</span
        >
        <h1 class="text-5xl md:text-8xl italic mt-2">
          Contact<br />Us
        </h1>
      </div>
      <p
        class="text-white/40 text-sm sm:text-base leading-relaxed max-w-xs sm:max-w-sm font-light pb-2 mt-8 md:mt-0"
      >
        Have a question about our courses? Want to enroll? Reach out — we're
        here to help you start your journey.
      </p>
    </div>

    <!-- Free demo prompt -->
    <div class="mt-6 inline-flex items-center gap-3 px-4 py-2.5 rounded-full border border-white/10 bg-white/[0.035] backdrop-blur-sm">
      <span class="text-base">🎓</span>
      <span class="text-xs text-white/50 leading-snug">Want to try before you enroll? <strong class="text-white/70 font-semibold">Free demo class</strong> available — just call or WhatsApp us.</span>
    </div>

    <!-- Decorative divider -->
    <div
      class="mt-8 h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent"
    >
    </div>
  </div>

  <!-- Main grid -->
  <div
    class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 xl:gap-14 max-w-7xl mx-auto"
  >
    <!-- LEFT: Call & WhatsApp CTAs -->
    <div class="reveal-item flex flex-col gap-6" data-reveal>
      <!-- Label -->
      <div class="mb-2">
        <h2 class="text-xl font-bold text-white mb-1">Reach Out Directly</h2>
        <p class="text-white/35 text-xs">
          The fastest way to connect with us — no forms, no waiting.
        </p>
      </div>

      <!-- Call Card -->
      <a
        href="tel:+919694932391"
        class="contact-cta-card contact-cta-call group"
        id="contact-call-btn"
        aria-label="Call Bhavya Computer Classes"
      >
        <div class="contact-cta-icon-wrap call-icon-bg">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-white"
          >
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.16 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.11 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l-.08.92z"
            ></path>
          </svg>
        </div>
        <div class="flex-1">
          <p class="contact-cta-tag">Give us a call</p>
          <p class="contact-cta-number">+91 96949 32391</p>
          <p class="contact-cta-sub">+91 96940 25249</p>
          <p class="contact-cta-hours">Mon – Sat &nbsp;·&nbsp; 9 AM – 7 PM</p>
        </div>
        <div class="contact-cta-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7"></path><path d="M7 7h10v10"></path>
          </svg>
        </div>
      </a>

      <!-- WhatsApp Card -->
      <a
        href="https://wa.me/919694932391"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-cta-card contact-cta-whatsapp group"
        id="contact-whatsapp-btn"
        aria-label="Chat on WhatsApp"
      >
        <div class="contact-cta-icon-wrap whatsapp-icon-bg">
          <svg viewBox="0 0 24 24" fill="white" class="w-7 h-7">
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.528 2.01 14.069.987 11.48.987 6.045.987 1.62 5.357 1.616 10.787c-.001 1.748.47 3.447 1.36 4.966l-1.001 3.655 3.748-.973l.334.218zM18.82 15.111c-.37-.185-2.18-.897-2.52-1.021-.34-.124-.588-.185-.836.186-.248.37-.958 1.206-1.17 1.454-.216.247-.433.279-.803.093-.37-.185-1.56-.57-2.971-1.829-1.09-.973-1.826-2.176-2.04-2.547-.217-.37-.023-.57.162-.754.166-.165.37-.432.556-.65.186-.216.248-.37.372-.617.124-.247.062-.463-.03-.649-.093-.185-.837-2.006-1.146-2.748-.3-.721-.606-.624-.836-.636-.216-.011-.463-.014-.71-.014-.248 0-.65.093-.99.463-.34.37-1.3 1.266-1.3 3.087 0 1.82 1.33 3.582 1.516 3.829.186.247 2.612 3.987 6.326 5.586.883.38 1.572.607 2.11.779.887.282 1.696.242 2.335.146.711-.107 2.18-.89 2.49-1.752.31-.862.31-1.603.217-1.752-.093-.149-.34-.241-.71-.426z"
            ></path>
          </svg>
        </div>
        <div class="flex-1">
          <p class="contact-cta-tag">Message on WhatsApp</p>
          <p class="contact-cta-number">+91 96949 32391</p>
          <p class="contact-cta-sub">Fastest response · Usually replies in minutes</p>
        </div>
        <div class="contact-cta-arrow whatsapp-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7"></path><path d="M7 7h10v10"></path>
          </svg>
        </div>
      </a>

      <!-- Working hours note -->
      <div class="contact-hours-note">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5 text-white/30"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>Available <strong>Mon – Sat, 9 AM – 7 PM</strong>. WhatsApp anytime for quick queries.</span>
      </div>
    </div>

    <!-- RIGHT: Info + Map -->
    <div class="flex flex-col gap-5 reveal-item" data-reveal>
      <!-- Info cards (address & hours only) -->
      <div class="flex flex-col gap-4">
        <!-- Address card -->
        <div class="contact-info-card group">
          <div class="contact-info-icon bg-white/5 group-hover:bg-white/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-white/70 group-hover:text-white transition-colors" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div class="flex-1">
            <p class="contact-info-label">Visit Us</p>
            <p class="contact-info-value">3-N-25, Mahaveer Nagar Extn., Near Ganesh Ji Mandir, Kota, Rajasthan</p>
            <a href="https://maps.google.com/?q=Mahaveer+Nagar+Extension+Kota+Rajasthan" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-widest text-white/50 hover:text-white transition-colors font-medium">
              Open in Maps
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
        </div>
        <!-- Hours card -->
        <div class="contact-info-card group">
          <div class="contact-info-icon bg-white/5 group-hover:bg-white/10">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-white/70 group-hover:text-white transition-colors" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="flex-1">
            <p class="contact-info-label">Working Hours</p>
            <div class="flex justify-between items-center mt-1 flex-wrap gap-2">
              <span class="contact-info-value">Mon – Sat</span>
              <span class="text-white/80 text-xs font-semibold">9:00 AM – 7:00 PM</span>
            </div>
            <div class="flex justify-between items-center mt-1 flex-wrap gap-2">
              <span class="contact-info-value">Sunday</span>
              <span class="text-white/30 text-xs font-medium">Closed</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Full-width map -->
  <div class="relative z-10 max-w-7xl mx-auto mt-10 reveal-item" data-reveal>
    <div class="relative rounded-2xl overflow-hidden border border-white/8" style="height:360px;box-shadow:0 25px 60px rgba(0,0,0,0.5);">
      <iframe title="Bhavya Computer Classes — Kota Location" src="https://maps.google.com/maps?q=Mahaveer+Nagar+Extension+Kota+Rajasthan&t=&z=15&ie=UTF8&iwloc=&output=embed" width="100%" height="100%" style="border:0;filter:grayscale(60%) brightness(65%) contrast(115%);height:360px;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>

  <!-- Social proof strip -->
  <div class="relative z-10 max-w-7xl mx-auto mt-6 reveal-item" data-reveal>
    <div class="social-proof-strip flex flex-wrap items-center justify-center gap-x-6 gap-y-3 py-4 px-6 rounded-2xl">
      <div class="flex items-center gap-2">
        <div class="flex gap-0.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <span class="text-white/70 text-sm font-semibold">4.8/5 on Google</span>
      </div>
      <div class="w-px h-4 bg-white/10 hidden sm:block"></div>
      <span class="text-white/40 text-sm">Trusted by <strong class="text-white/70">500+ students</strong> in Kota</span>
      <div class="w-px h-4 bg-white/10 hidden sm:block"></div>
      <span class="text-white/40 text-sm">🎓 <strong class="text-white/70">Free demo</strong> available — just ask!</span>
    </div>
  </div>

  <!-- Quick CTA strip -->
  <div class="relative z-10 max-w-7xl mx-auto mt-14 reveal-item" data-reveal>
    <div
      class="cta-strip flex flex-col sm:flex-row items-center justify-between gap-5 p-6 sm:p-8 rounded-2xl"
    >
      <div>
        <p class="text-white font-semibold text-base">Still have questions?</p>
        <p class="text-white/40 text-sm mt-0.5">
          Browse our FAQ or speak to us — we're happy to help.
        </p>
      </div>
      <div
        class="flex items-center gap-3 flex-wrap justify-center sm:justify-end"
      >
        <a
          href="/faq"
          class="px-5 py-2.5 rounded-xl bg-white/8 border border-white/12 text-white/80 text-sm font-medium hover:bg-white/14 hover:text-white transition-all duration-250 flex items-center gap-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><path
              d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line
              x1="12"
              y1="17"
              x2="12.01"
              y2="17"></line></svg
          >
          See Common Questions
        </a>
        <a
          href="tel:+919694932391"
          class="px-5 py-2.5 rounded-xl bg-white text-black text-sm font-semibold hover:bg-white/90 hover:-translate-y-0.5 transition-all duration-250 flex items-center gap-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.16 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.11 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l-.08.92z"
            ></path></svg
          >
          Call Now
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── CTA Cards ── */
  .contact-cta-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px 22px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    text-decoration: none;
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s,
      background 0.3s,
      box-shadow 0.3s;
    backdrop-filter: blur(8px);
  }
  .contact-cta-call:hover {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }
  .contact-cta-whatsapp:hover {
    border-color: rgba(37, 211, 102, 0.35);
    background: rgba(37, 211, 102, 0.05);
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(37, 211, 102, 0.12);
  }

  .contact-cta-icon-wrap {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
  }
  .contact-cta-card:hover .contact-cta-icon-wrap {
    transform: scale(1.07);
  }
  .call-icon-bg {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .whatsapp-icon-bg {
    background: rgba(37, 211, 102, 0.15);
    border: 1px solid rgba(37, 211, 102, 0.25);
  }

  .contact-cta-tag {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.3);
    font-weight: 500;
    margin-bottom: 5px;
  }
  .contact-cta-number {
    font-size: 20px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.92);
    letter-spacing: -0.02em;
    font-family: 'Syne', sans-serif;
    line-height: 1.2;
  }
  .contact-cta-sub {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.38);
    margin-top: 4px;
  }
  .contact-cta-hours {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.22);
    margin-top: 6px;
    letter-spacing: 0.02em;
  }

  /* ── Social proof strip ── */
  .social-proof-strip {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(6px);
  }
  .contact-cta-whatsapp .contact-cta-number {
    color: #25D366;
  }

  .contact-cta-arrow {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.2);
    transition: color 0.3s, transform 0.3s;
  }
  .contact-cta-call:hover .contact-cta-arrow {
    color: rgba(255, 255, 255, 0.7);
    transform: translate(2px, -2px);
  }
  .whatsapp-arrow {
    color: rgba(37, 211, 102, 0.3);
  }
  .contact-cta-whatsapp:hover .whatsapp-arrow {
    color: #25D366;
    transform: translate(2px, -2px);
  }

  .contact-hours-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.3);
    line-height: 1.6;
    padding: 4px 0;
  }
  .contact-hours-note strong {
    color: rgba(255, 255, 255, 0.55);
    font-weight: 600;
  }

  /* ── Info cards ── */
  .contact-info-card {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;
    padding: 18px;
    transition:
      border-color 0.3s,
      background 0.3s,
      transform 0.3s;
  }
  .contact-info-card:hover {
    background: rgba(255, 255, 255, 0.045);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }
  .contact-info-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }
  .contact-info-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: rgba(255, 255, 255, 0.22);
    font-weight: 500;
    margin-bottom: 4px;
  }
  .contact-info-value {
    display: block;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.55;
  }

  /* ── CTA strip ── */
  .cta-strip {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
  }

  /* ── Spin animation ── */
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .animate-spin {
    animation: spin 0.8s linear infinite;
  }
  .hidden {
    display: none !important;
  }

  /* ── Reveal animation ── */
  .reveal-item {
    opacity: 0;
    transform: translateY(36px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-item.reveal-active {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-item:nth-child(2) {
    transition-delay: 0.12s;
  }
  .reveal-item:nth-child(3) {
    transition-delay: 0.22s;
  }

  /* ── Mobile tweaks ── */
  @media (max-width: 480px) {
    .contact-info-card {
      padding: 15px;
      gap: 11px;
    }
    .contact-info-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
    }
  }
</style>

