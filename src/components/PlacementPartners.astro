---

<section id="placement-partners-section" class="py-16 md:py-24 bg-white relative overflow-hidden border-t border-slate-200/80">
  <!-- Subtle decorative ambient lights -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Title & Subtitle matching Samyak style -->
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-300 text-amber-900 text-xs font-bold tracking-wider uppercase mb-3.5 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Corporate Hiring Network</span>
        <span class="text-amber-500">•</span>
        <span class="font-['Noto_Sans_Devanagari']">प्लेसमेंट पार्टनर्स</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#0B1A30] font-['Poppins'] tracking-tight leading-tight">
        Our Placement Partners
      </h2>
      <p class="text-amber-600 font-bold text-base sm:text-lg mt-2 font-['Noto_Sans_Devanagari']">
        हमारे प्रशिक्षित छात्रों को शीर्ष कंपनियों और कॉर्पोरेट्स में मिला रोजगार
      </p>

      <p class="text-slate-600 text-sm sm:text-base leading-relaxed mt-3">
        Over 500+ top multinational tech firms, accounting enterprises, and marketing agencies hire qualified graduates directly from <strong>Bhavya Career Institute</strong>.
      </p>
    </div>

    <!-- Placement Fast Metrics Ribbon -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-5 max-w-4xl mx-auto mb-12 sm:mb-16">
      <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 text-center hover:border-amber-400 transition-colors">
        <span class="block text-2xl sm:text-3xl font-black text-[#07366C]">100%</span>
        <span class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Placement Support</span>
      </div>
      <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 text-center hover:border-amber-400 transition-colors">
        <span class="block text-2xl sm:text-3xl font-black text-[#E8590C]">500+</span>
        <span class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Students Placed</span>
      </div>
      <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 text-center hover:border-amber-400 transition-colors">
        <span class="block text-2xl sm:text-3xl font-black text-[#0D9488]">150+</span>
        <span class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Hiring Partners</span>
      </div>
      <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 text-center hover:border-amber-400 transition-colors">
        <span class="block text-2xl sm:text-3xl font-black text-[#1D4ED8]">₹8.5 LPA</span>
        <span class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Highest Package</span>
      </div>
    </div>
  </div>

  <!-- Infinite Logo Marquee Row 1 (Left to Right) -->
  <div class="marquee-wrapper relative w-full overflow-hidden mb-5">
    <div class="marquee-track marquee-track-1 flex gap-5 items-center py-2">
      <!-- First Copy -->
      {partnersRow1.map((p) => (
        <div class="partner-card flex-shrink-0 bg-white border border-slate-200 rounded-xl px-7 py-4 flex items-center justify-center min-w-[210px] h-[82px] shadow-xs hover:shadow-md hover:border-amber-400 transition-all duration-300">
          <div set:html={p.svg} />
        </div>
      ))}
      <!-- Duplicate Copy for seamless loop -->
      {partnersRow1.map((p) => (
        <div class="partner-card flex-shrink-0 bg-white border border-slate-200 rounded-xl px-7 py-4 flex items-center justify-center min-w-[210px] h-[82px] shadow-xs hover:shadow-md hover:border-amber-400 transition-all duration-300">
          <div set:html={p.svg} />
        </div>
      ))}
    </div>
    <!-- Edge Gradients for soft fading -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white to-transparent"></div>
  </div>

  <!-- Infinite Logo Marquee Row 2 (Right to Left) -->
  <div class="marquee-wrapper relative w-full overflow-hidden">
    <div class="marquee-track marquee-track-2 flex gap-5 items-center py-2">
      <!-- First Copy -->
      {partnersRow2.map((p) => (
        <div class="partner-card flex-shrink-0 bg-white border border-slate-200 rounded-xl px-7 py-4 flex items-center justify-center min-w-[210px] h-[82px] shadow-xs hover:shadow-md hover:border-amber-400 transition-all duration-300">
          <div set:html={p.svg} />
        </div>
      ))}
      <!-- Duplicate Copy for seamless loop -->
      {partnersRow2.map((p) => (
        <div class="partner-card flex-shrink-0 bg-white border border-slate-200 rounded-xl px-7 py-4 flex items-center justify-center min-w-[210px] h-[82px] shadow-xs hover:shadow-md hover:border-amber-400 transition-all duration-300">
          <div set:html={p.svg} />
        </div>
      ))}
    </div>
    <!-- Edge Gradients for soft fading -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white to-transparent"></div>
  </div>

  <!-- Bottom CTA for recruiters and students -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 text-center">
    <div class="inline-flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        data-open-demo-modal
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#07366C] hover:bg-[#0B4B89] text-white text-sm font-bold shadow-md hover:-translate-y-0.5 transition-transform"
      >
        <span>Enroll For Guaranteed Job Assistance</span>
        <span>&rarr;</span>
      </button>

      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-sm font-semibold shadow-xs hover:-translate-y-0.5 transition-transform"
      >
        <span>Hire From Us (Recruiter Tie-ups)</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Infinite Marquee Animation */
  .marquee-track-1 {
    width: max-content;
    animation: scrollLeft 38s linear infinite;
  }

  .marquee-track-2 {
    width: max-content;
    animation: scrollRight 38s linear infinite;
  }

  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scrollLeft {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scrollRight {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .partner-card:hover {
    transform: translateY(-2px);
  }
</style>
