---
const digitalCourses = [
  { name: 'Advanced Excel', domain: 'Office Skills' },
  { name: 'Microsoft Office Specialist', domain: 'Office Skills' },
  { name: 'Basic Digital Marketing', domain: 'Digital Marketing' },
  { name: 'Advanced Digital Marketing', domain: 'Digital Marketing' },
  { name: 'DTP (Desktop Publishing)', domain: 'Graphic Designing' },
  { name: 'Basic Graphic Designing', domain: 'Graphic Designing' },
  { name: 'Advanced Graphic Designing', domain: 'Graphic Designing' },
  { name: 'Web Development using PHP', domain: 'Web Dev & Programming' },
  { name: 'Web Design using React', domain: 'Web Dev & Programming' },
  { name: 'Basic Python Programming', domain: 'Web Dev & Programming' },
  { name: 'Advanced Python Programming', domain: 'Web Dev & Programming' },
  { name: 'Spoken English', domain: 'Spoken English' },
];

const domainIcons: Record<string, string> = {
  'Office Skills': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>',
  'Digital Marketing': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>',
  'Graphic Designing': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></svg>',
  'Web Dev & Programming': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  'Spoken English': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
};

const domainStyles: Record<string, { badge: string; iconBg: string }> = {
  'Office Skills': {
    badge: 'bg-[#0757A8]/10 text-[#0757A8] border-[#0757A8]/20',
    iconBg: 'bg-[#0757A8]/10 text-[#0757A8] group-hover:bg-[#0757A8] group-hover:text-white',
  },
  'Digital Marketing': {
    badge: 'bg-[#F39A18]/10 text-[#c27305] border-[#F39A18]/30',
    iconBg: 'bg-[#F39A18]/10 text-[#F39A18] group-hover:bg-[#F39A18] group-hover:text-white',
  },
  'Graphic Designing': {
    badge: 'bg-purple-50 text-purple-700 border-purple-200',
    iconBg: 'bg-purple-100/70 text-purple-700 group-hover:bg-purple-600 group-hover:text-white',
  },
  'Web Dev & Programming': {
    badge: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    iconBg: 'bg-emerald-100/70 text-emerald-700 group-hover:bg-emerald-600 group-hover:text-white',
  },
  'Spoken English': {
    badge: 'bg-rose-50 text-rose-700 border-rose-200',
    iconBg: 'bg-rose-100/70 text-rose-700 group-hover:bg-rose-600 group-hover:text-white',
  },
};
---

<section id="digital-courses" class="py-24 bg-[#F8FAFD] border-t border-[#082B63]/[0.08] relative overflow-hidden">
  <!-- Subtle decorative background blurs -->
  <div class="pointer-events-none absolute -top-24 right-10 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.08)_0%,transparent_70%)]"></div>
  <div class="pointer-events-none absolute -bottom-24 left-10 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(7,87,168,0.08)_0%,transparent_70%)]"></div>

  <div class="container mx-auto px-5 sm:px-8 max-w-7xl relative z-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-14">
      <div>
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-3" style="font-family: 'Poppins', sans-serif;">
          <span>Digital Skills</span>
          <span class="text-[#F39A18]">•</span>
          <span class="font-['Noto_Sans_Devanagari']">डिजिटल कोर्सेज</span>
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[#082B63] font-['Poppins']">
          Specialized <span class="text-[#F39A18]">Digital Courses</span>
        </h2>
      </div>
      <p class="max-w-md text-[#506176] text-sm sm:text-base font-['Noto_Sans_Devanagari'] leading-relaxed bg-white/80 backdrop-blur-sm p-4 rounded-xl border border-[#082B63]/10 shadow-sm">
        आधुनिक कार्यक्षेत्र के लिए जॉब-रेडी डिजिटल स्किल्स। RSCIT प्रवेश पर — पाएं <span class="text-[#082B63] font-bold underline decoration-[#F39A18] decoration-2">2 Digital Courses बिल्कुल FREE</span>।
      </p>
    </div>

    <!-- NIOS / Distance Courses Banner (Navy Gradient Card) -->
    <div
      data-reveal="up"
      class="mb-14 p-7 sm:p-9 rounded-2xl bg-gradient-to-br from-[#082B63] via-[#0B3B7B] to-[#07244C] text-white shadow-[0_12px_36px_rgba(8,43,99,0.18)] relative overflow-hidden border border-white/10"
    >
      <!-- Decorative background orb -->
      <div class="pointer-events-none absolute -top-12 -right-12 w-64 h-64 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.22)_0%,transparent_70%)]"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2.5 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#F39A18] animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-[0.25em] text-[#FBD47A] font-['Poppins']">
              After 12th / Graduation — Distance Education
            </span>
          </div>
          <p class="text-white text-base sm:text-lg lg:text-xl font-bold leading-relaxed tracking-wide font-['Poppins']">
            B.A., B.COM, B.Sc, M.A., M.Sc., MBA, BCA, MCA, PGDCA, ECCE, MSW, D.LIS, B.LIS, NTT
          </p>
          <p class="text-white/70 text-xs sm:text-sm mt-2 font-['Noto_Sans_Devanagari']">
            यूजीसी (UGC) मान्यता प्राप्त यूनिवर्सिटीज से दूरस्थ शिक्षा (Distance Education) डिग्री व डिप्लोमा
          </p>
        </div>

        <div class="flex-shrink-0 bg-white/10 backdrop-blur-md rounded-xl p-4 border border-white/15 text-left md:text-right">
          <p class="text-[10px] uppercase tracking-[0.25em] text-[#FBD47A] font-bold mb-1 font-['Poppins']">Also Available</p>
          <p class="text-white text-sm sm:text-base font-extrabold tracking-tight font-['Poppins']">NIOS / BOSSE</p>
          <p class="text-white/80 text-xs font-semibold">10th &amp; 12th Open Schooling</p>
        </div>
      </div>
    </div>

    <!-- Digital Courses Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="digital-courses-grid">
      {digitalCourses.map((course, idx) => {
        const style = domainStyles[course.domain] || {
          badge: 'bg-gray-100 text-gray-700 border-gray-200',
          iconBg: 'bg-gray-100 text-[#082B63] group-hover:bg-[#082B63] group-hover:text-white',
        };

        return (
          <div
            data-reveal="zoom"
            style={`transition-delay: ${(idx % 4) * 80}ms;`}
            class="digital-course-card relative p-6 rounded-2xl bg-white border border-[#082B63]/[0.08] shadow-[0_4px_16px_rgba(8,43,99,0.04)] hover:shadow-[0_12px_30px_rgba(8,43,99,0.12)] hover:border-[#0757A8]/30 transition-all duration-300 ease-out hover:-translate-y-1.5 cursor-pointer flex flex-col justify-between min-h-[160px] group"
            data-domain={course.domain}
          >
            <!-- Domain Icon & Badge -->
            <div class="flex justify-between items-start mb-4">
              <div class={`p-2.5 rounded-xl transition-all duration-300 ${style.iconBg}`}>
                <Fragment set:html={domainIcons[course.domain]} />
              </div>
              <span class={`text-[10px] uppercase tracking-wider px-3 py-1 rounded-full font-bold border ${style.badge}`} style="font-family: 'Poppins', sans-serif;">
                {course.domain}
              </span>
            </div>

            <!-- Course Name -->
            <div class="mt-2">
              <h3 class="text-base sm:text-lg font-bold text-[#082B63] group-hover:text-[#0757A8] transition-colors leading-snug font-['Poppins']">
                {course.name}
              </h3>
            </div>

            <!-- Bottom hover indicator -->
            <div class="mt-4 pt-3 border-t border-[#082B63]/[0.06] flex items-center justify-between text-xs font-semibold text-[#0757A8]">
              <span class="group-hover:translate-x-0.5 transition-transform duration-200">Explore Course</span>
              <svg class="w-4 h-4 text-[#F39A18] transform group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
