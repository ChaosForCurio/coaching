---
/**
 * LeadModal.astro — Professional Application Form Modal
 * Behaviour: Soft popup after 15 seconds on first visit (dismissible at any time).
 * No gate lock. No canvas CAPTCHA. Close button always visible.
 * Connects to Neon DB (/api/enquiry) and Google Sheets via Google Apps Script.
 */
---

<!-- Modal Overlay -->
<div
  id="application-modal-overlay"
  class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-end sm:items-center justify-center p-3 sm:p-4 opacity-0 pointer-events-none transition-all duration-300 overflow-y-auto"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="modal-title"
>
  <!-- Outer White Rounded Container -->
  <div
    id="application-modal-content"
    class="relative w-full max-w-[500px] bg-white rounded-3xl p-5 sm:p-7 shadow-2xl transform translate-y-8 transition-all duration-300 text-gray-900 my-auto"
  >
    <!-- Close Button — always visible -->
    <button
      id="close-application-modal"
      class="absolute top-4 right-5 text-gray-400 hover:text-gray-800 transition-colors p-1.5 text-2xl font-light leading-none cursor-pointer z-10"
      aria-label="Close modal"
    >
      &times;
    </button>

    <!-- Modal Header -->
    <div class="text-center mb-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-semibold mb-2">
        <span>🎓</span> Admissions Open — Kota Campus
      </div>
      <h2 id="modal-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">
        Book a Free Demo Class
      </h2>
      <p class="text-xs text-gray-500 mt-1.5 font-medium">
        Fill in your details and we'll call you back to schedule your demo.
      </p>
    </div>

    <!-- Inner Royal Purple Form Section -->
    <div class="bg-[#39318B] rounded-2xl p-5 sm:p-6 text-white shadow-inner">
      <form id="application-form" class="space-y-3" novalidate>

        <!-- Error Message Alert Box -->
        <div id="form-error-alert" class="hidden p-3 bg-red-500/20 border border-red-400/30 rounded-xl text-red-200 text-xs font-medium text-center">
        </div>

        <!-- Anti-Spam Honeypot (invisible to humans, traps bots) -->
        <div style="position: absolute; left: -9999px; top: -9999px; opacity: 0; pointer-events: none; height: 0; width: 0; overflow: hidden;" aria-hidden="true" tabindex="-1">
          <label for="app-website-field">Leave this empty</label>
          <input type="text" id="app-website-field" name="website_url" autocomplete="off" tabindex="-1" />
        </div>

        <!-- 1. Name -->

        <div>
          <input
            type="text"
            id="app-name"
            name="name"
            required
            placeholder="Your Full Name *"
            class="w-full bg-white text-gray-900 placeholder-gray-400 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 border border-transparent font-medium"
          />
        </div>

        <!-- 2. Mobile Number -->
        <div class="flex gap-2">
          <div class="flex items-center justify-center bg-white text-gray-800 rounded-lg px-3 text-xs font-bold border border-transparent select-none flex-shrink-0">
            +91 &#9660;
          </div>
          <input
            type="tel"
            id="app-phone"
            name="phone"
            required
            maxlength="10"
            pattern="[0-9]{10}"
            placeholder="10-digit Mobile Number *"
            class="w-full bg-white text-gray-900 placeholder-gray-400 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 border border-transparent font-medium"
          />
        </div>

        <!-- 3. Email (optional) -->
        <div>
          <input
            type="email"
            id="app-email"
            name="email"
            placeholder="Email Address (optional)"
            class="w-full bg-white text-gray-900 placeholder-gray-400 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 border border-transparent font-medium"
          />
        </div>

        <!-- 4. Preferred Course -->
        <div>
          <select
            id="app-course"
            name="course"
            required
            class="w-full bg-white text-gray-900 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 border border-transparent font-medium cursor-pointer"
          >
            <option value="" disabled selected>Select Preferred Course *</option>
            <option value="DCA (Diploma in Computer Applications)">DCA (Diploma in Computer Applications)</option>
            <option value="Tally Prime with GST">Tally Prime with GST</option>
            <option value="RS-CIT Government Course">RS-CIT Government Course</option>
            <option value="Python Programming">Python Programming</option>
            <option value="Web Development (MERN)">Web Development (MERN)</option>
            <option value="Advanced Excel & Analytics">Advanced Excel & Analytics</option>
            <option value="Graphic Design & Photoshop">Graphic Design & Photoshop</option>
            <option value="Digital Marketing">Digital Marketing</option>
            <option value="Not sure — help me choose">Not sure — help me choose</option>
          </select>
        </div>

        <!-- 5. Consent Checkbox -->
        <div class="flex items-start gap-2 pt-1">
          <input
            type="checkbox"
            id="app-consent"
            name="consent"
            checked
            class="mt-1 h-4 w-4 rounded border-gray-300 text-amber-400 focus:ring-amber-400 cursor-pointer flex-shrink-0"
          />
          <label for="app-consent" class="text-[11px] leading-snug text-white/80 select-none cursor-pointer">
            I agree to receive updates via SMS, Email &amp; WhatsApp.*
          </label>
        </div>

        <!-- 6. Submit Button -->
        <button
          type="submit"
          id="app-submit-btn"
          class="w-full py-3 px-6 rounded-xl bg-[#FFD900] hover:bg-[#ffe033] text-gray-950 font-bold text-sm transition-all shadow-md tracking-wider uppercase cursor-pointer flex items-center justify-center gap-2 mt-2"
        >
          <span>Get Free Demo Class</span>
        </button>
      </form>

      <!-- Success View (Hidden by Default) -->
      <div id="application-success-view" class="hidden text-center py-8 space-y-4">
        <div class="w-16 h-16 bg-emerald-400/20 text-emerald-300 rounded-full flex items-center justify-center mx-auto text-4xl border-2 border-emerald-400/40 animate-pulse">
          ✓
        </div>
        <h3 class="text-2xl font-bold text-white">Thank You! 🎉</h3>
        <p class="text-white/90 text-sm max-w-xs mx-auto leading-relaxed">
          Your application is received!<br/>
          Our team will call you back shortly.
        </p>
      </div>
    </div>

    <!-- Trust Footer -->
    <div class="mt-4 flex items-center justify-center gap-4 text-[10px] text-gray-400">
      <span>🔒 100% Private</span>
      <span>•</span>
      <span>No spam, ever</span>
      <span>•</span>
      <span>Free demo class, no obligation</span>
    </div>
  </div>
</div>

<script>
  import { captureUTMParameters, getStoredUTM } from '../utils/utm';

  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzMQ7mM6fErnhwpiPkqmtApeukLW0CaqET99MqbG1026Pw-ArbvByN-b38G2Zk-E05S/exec';
  const STORAGE_KEY = 'bhavya_application_submitted';

  // Capture UTM parameters from URL query params immediately
  captureUTMParameters();

  document.addEventListener('DOMContentLoaded', () => {
    captureUTMParameters();
    const overlay = document.getElementById('application-modal-overlay');

    const content = document.getElementById('application-modal-content');
    const closeBtn = document.getElementById('close-application-modal');
    const form = document.getElementById('application-form') as HTMLFormElement;
    const errorAlert = document.getElementById('form-error-alert');
    const successView = document.getElementById('application-success-view');
    const submitBtn = document.getElementById('app-submit-btn') as HTMLButtonElement;

    if (!overlay || !content) return;

    // --- Open / Close ---
    const openModal = () => {
      if (errorAlert) errorAlert.classList.add('hidden');
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      content.classList.remove('translate-y-8');
      content.classList.add('translate-y-0');
    };

    const closeModal = () => {
      overlay.setAttribute('aria-hidden', 'true');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      content.classList.remove('translate-y-0');
      content.classList.add('translate-y-8');
      // Body scroll is never blocked — nothing to restore
    };

    // --- Auto-open after 15 seconds on first visit ---
    let hasSubmitted = false;
    try {
      hasSubmitted = localStorage.getItem(STORAGE_KEY) === 'true';
    } catch (e) {}

    if (!hasSubmitted) {
      setTimeout(openModal, 15000);
    }

    // Manual triggers: any element with data-open-lead-modal etc.
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-open-demo-modal], [data-open-lead-modal], [data-open-application-modal]')) {
        e.preventDefault();
        openModal();
      }
    });

    closeBtn?.addEventListener('click', closeModal);

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('opacity-0')) {
        closeModal();
      }
    });

    // --- Form Validation & Submission ---
    const showError = (msg: string) => {
      if (errorAlert) {
        errorAlert.textContent = msg;
        errorAlert.classList.remove('hidden');
      }
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorAlert) errorAlert.classList.add('hidden');

      const name   = (document.getElementById('app-name') as HTMLInputElement).value.trim();
      const phone  = (document.getElementById('app-phone') as HTMLInputElement).value.trim();
      const email  = (document.getElementById('app-email') as HTMLInputElement).value.trim();
      const course = (document.getElementById('app-course') as HTMLSelectElement).value;
      const consentChecked = (document.getElementById('app-consent') as HTMLInputElement).checked;
      const honeypot = (document.getElementById('app-website-field') as HTMLInputElement)?.value || '';


      if (!name || !phone || !course) {
        showError('Please fill out your name, mobile number, and preferred course.');
        return;
      }

      const phoneRegex = /^[0-9]{10}$/;
      if (!phoneRegex.test(phone)) {
        showError('Please enter a valid 10-digit Indian mobile number.');
        return;
      }

      if (email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          showError('Please enter a valid email address or leave it blank.');
          return;
        }
      }

      if (!consentChecked) {
        showError('Please accept the consent checkbox to proceed.');
        return;
      }

      // Loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="inline-block animate-spin mr-2">&#9696;</span> Submitting...`;
      }

      // Collect marketing & UTM parameters
      const utmData = getStoredUTM();

      const payload = {
        name,
        email:           email || '',
        phone,
        secondaryPhone:  'N/A',
        branch:          'Kota',
        course,
        consent:         consentChecked,
        website_url:     honeypot,
        source:          (document.title ? document.title + ' | ' : '') + window.location.href,
        pagePath:        window.location.pathname,

        submittedAt:     new Date().toISOString(),
        device:          /Mobi|Android|iPhone/i.test(navigator.userAgent) ? 'Mobile' : 'Desktop',
        ...utmData,
        // Backwards compatibility for older Google Apps Scripts
        mobile:          phone,
        secondaryMobile: 'N/A',
        nearestBranch:   'Kota',
        preferredCourse: course,
        sourcePage:      (document.title ? document.title + ' | ' : '') + window.location.href,
      };


      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          throw new Error('API returned status ' + res.status);
        }
      } catch (err) {
        console.warn('API route fallback to direct webhook:', err);
        if (GOOGLE_SCRIPT_URL && !GOOGLE_SCRIPT_URL.includes('AKfycbz_SAMPLE')) {
          try {
            await fetch(GOOGLE_SCRIPT_URL, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'text/plain' },
              body: JSON.stringify(payload),
            });
          } catch (scriptErr) {
            console.error('Google Apps Script Error:', scriptErr);
          }
        }
      }

      try { localStorage.setItem(STORAGE_KEY, 'true'); } catch (e) {}

      form.reset();
      form.classList.add('hidden');
      if (successView) successView.classList.remove('hidden');

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<span>Get Free Demo Class</span>`;
      }

      // Auto-close after 4 seconds on success
      setTimeout(() => {
        closeModal();
        setTimeout(() => {
          form.classList.remove('hidden');
          if (successView) successView.classList.add('hidden');
        }, 400);
      }, 4000);
    });
  });
</script>
