---
/**
 * LeadModal.astro — Free Demo Class / Lead Capture Modal Component
 * Can be triggered from any page using buttons with `data-open-demo-modal`
 */
---

<div
  id="lead-modal-overlay"
  class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
>
  <div
    id="lead-modal-content"
    class="relative w-full max-w-lg bg-[#121212] border border-white/15 rounded-3xl p-6 sm:p-8 shadow-2xl transform scale-95 transition-all duration-300 text-white"
  >
    <!-- Close Button -->
    <button
      id="close-lead-modal"
      class="absolute top-5 right-5 text-white/40 hover:text-white transition-colors p-2 text-xl"
      aria-label="Close modal"
    >
      ✕
    </button>

    <!-- Header -->
    <div class="mb-6">
      <span class="inline-block px-3 py-1 text-[10px] uppercase tracking-[0.3em] font-semibold bg-amber-400/10 text-amber-400 rounded-full border border-amber-400/20 mb-3">
        Limited Seats
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">Book Free Demo Class</h2>
      <p class="text-white/60 text-sm leading-relaxed">
        Experience our practical computer lab training in Kota. Fill out the form below for a free 2-day demo class.
      </p>
    </div>

    <!-- Lead Form -->
    <form id="lead-capture-form" class="space-y-4">
      <div>
        <label for="student-name" class="block text-xs uppercase tracking-wider text-white/60 mb-1 font-medium">Your Name</label>
        <input
          type="text"
          id="student-name"
          name="name"
          required
          placeholder="e.g. Rahul Sharma"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white/40 transition-colors"
        />
      </div>

      <div>
        <label for="student-phone" class="block text-xs uppercase tracking-wider text-white/60 mb-1 font-medium">Mobile / WhatsApp Number</label>
        <input
          type="tel"
          id="student-phone"
          name="phone"
          required
          pattern="[0-9]{10}"
          placeholder="e.g. 9694932391"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-white/40 transition-colors"
        />
      </div>

      <div>
        <label for="selected-course" class="block text-xs uppercase tracking-wider text-white/60 mb-1 font-medium">Select Course</label>
        <select
          id="selected-course"
          name="course"
          required
          class="w-full bg-[#1e1e1e] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-white/40 transition-colors"
        >
          <option value="" disabled selected>-- Select a course --</option>
          <option value="Tally Prime with GST">Tally Prime with GST</option>
          <option value="DCA (Diploma in Computer Applications)">DCA (Diploma in Computer Applications)</option>
          <option value="RS-CIT Government Course">RS-CIT Government Course</option>
          <option value="Python Programming">Python Programming</option>
          <option value="Web Development (MERN)">Web Development (MERN)</option>
          <option value="Advanced Excel & Analytics">Advanced Excel & Analytics</option>
          <option value="Graphic Design & Photoshop">Graphic Design & Photoshop</option>
        </select>
      </div>

      <button
        type="submit"
        class="w-full mt-2 py-3.5 px-6 rounded-xl bg-amber-400 text-black font-semibold text-sm hover:bg-amber-300 transition-all shadow-lg tracking-wide uppercase"
      >
        Reserve My Free Demo Seat →
      </button>

      <p class="text-[11px] text-center text-white/40 mt-3">
        🔒 We respect your privacy. No spam guaranteed.
      </p>
    </form>

    <!-- Success Screen (Hidden by default) -->
    <div id="lead-success-msg" class="hidden text-center py-8 space-y-4">
      <div class="w-16 h-16 bg-emerald-500/10 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-3xl border border-emerald-500/20">
        ✓
      </div>
      <h3 class="text-2xl font-bold text-white">Seat Reserved!</h3>
      <p class="text-white/70 text-sm max-w-xs mx-auto leading-relaxed">
        Thank you! Our faculty team at Bhavya Computer Classes will call or WhatsApp you shortly with your demo class timings.
      </p>
      <button
        id="finish-lead-modal"
        class="py-2.5 px-6 bg-white/10 text-white rounded-xl text-xs font-semibold hover:bg-white/20 transition-all uppercase tracking-wider mt-4"
      >
        Close Window
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('lead-modal-overlay');
    const content = document.getElementById('lead-modal-content');
    const closeBtn = document.getElementById('close-lead-modal');
    const finishBtn = document.getElementById('finish-lead-modal');
    const form = document.getElementById('lead-capture-form') as HTMLFormElement;
    const successMsg = document.getElementById('lead-success-msg');

    if (!overlay || !content) return;

    const openModal = () => {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-95');
      content.classList.add('scale-100');
    };

    const closeModal = () => {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      content.classList.remove('scale-100');
      content.classList.add('scale-95');
    };

    // Listen for trigger clicks across document
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-open-demo-modal]')) {
        e.preventDefault();
        openModal();
      }
    });

    closeBtn?.addEventListener('click', closeModal);
    finishBtn?.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    // Form submission handler
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('student-name') as HTMLInputElement).value;
      const phone = (document.getElementById('student-phone') as HTMLInputElement).value;
      const course = (document.getElementById('selected-course') as HTMLSelectElement).value;

      // Construct WhatsApp message redirect
      const message = `Hi Bhavya Computer Classes, I want to book a Free Demo Class!\nName: ${name}\nPhone: ${phone}\nCourse: ${course}`;
      const waUrl = `https://wa.me/919694932391?text=${encodeURIComponent(message)}`;

      // Show success inside modal
      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      // Open WhatsApp window
      setTimeout(() => {
        window.open(waUrl, '_blank');
      }, 1000);
    });
  });
</script>
