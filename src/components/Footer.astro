---
import CookieConsent from './CookieConsent.astro';
import LeadModal from './LeadModal.astro';
import siteConfig from '../data/site-config.json';
---

<footer id="footer" class="bhavya-footer bg-[#F8B817] text-[#111827] font-['Montserrat'] relative z-10 border-t-4 border-[#E59C07]">
  <!-- Main Footer Content -->
  <div class="max-w-[1360px] mx-auto px-5 sm:px-8 pt-12 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      
      <!-- Column 1: Institute Brand & Contact Details -->
      <div class="footer-col footer-col-brand flex flex-col items-start">
        <!-- Circular Certification Seal / Emblem -->
        <div class="mb-4 flex items-center gap-3">
          <div class="relative w-20 h-20 flex-shrink-0">
            <!-- Circular decorative emblem SVG -->
            <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-md">
              <!-- Outer Segmented Ring -->
              <circle cx="50" cy="50" r="46" fill="none" stroke="#E65100" stroke-width="6" stroke-dasharray="22 4" stroke-dashoffset="0"/>
              <circle cx="50" cy="50" r="46" fill="none" stroke="#0D9488" stroke-width="6" stroke-dasharray="22 4" stroke-dashoffset="26"/>
              <circle cx="50" cy="50" r="46" fill="none" stroke="#1D4ED8" stroke-width="6" stroke-dasharray="22 4" stroke-dashoffset="52"/>
              <circle cx="50" cy="50" r="46" fill="none" stroke="#B91C1C" stroke-width="6" stroke-dasharray="22 4" stroke-dashoffset="78"/>
              <!-- Inner White Badge -->
              <circle cx="50" cy="50" r="40" fill="#FFFFFF" stroke="#07366C" stroke-width="2"/>
              <!-- Center Logo Text -->
              <text x="50" y="38" text-anchor="middle" font-family="'Poppins', sans-serif" font-weight="900" font-size="14" fill="#07366C">BHAVYA</text>
              <text x="50" y="49" text-anchor="middle" font-family="'Poppins', sans-serif" font-weight="800" font-size="7" fill="#E65100" letter-spacing="1">INSTITUTE</text>
              <line x1="28" y1="54" x2="72" y2="54" stroke="#CBD5E1" stroke-width="1"/>
              <text x="50" y="63" text-anchor="middle" font-family="'Poppins', sans-serif" font-weight="700" font-size="6" fill="#475569">KOTA • ESTD. 2010</text>
              <text x="50" y="73" text-anchor="middle" font-family="'Poppins', sans-serif" font-weight="700" font-size="5.5" fill="#0D9488">100% PLACEMENT</text>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xs uppercase font-extrabold tracking-wider text-[#07366C] leading-tight">ISO 9001:2015</span>
            <span class="text-[11px] font-bold text-slate-700 leading-tight">Govt. Recognized Center</span>
          </div>
        </div>

        <!-- Institute Title -->
        <h3 class="text-xl sm:text-2xl font-black text-[#0B1A30] leading-tight mb-1">
          Bhavya Career Institute
        </h3>
        <p class="text-[13px] font-extrabold text-[#07366C] mb-3">
          Kota's Leading Computer Training Center
        </p>

        <!-- Address & Contact Information -->
        <div class="space-y-1.5 text-[13.5px] text-slate-900 font-medium mb-4">
          <p class="flex items-start gap-2">
            <span class="font-bold">Address:</span>
            <span>{siteConfig.address.street}, {siteConfig.address.landmark}, {siteConfig.address.city}</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="font-bold">Phone:</span>
            <a href={`tel:${siteConfig.contact.phoneRaw}`} class="hover:underline font-semibold text-[#07366C]">
              {siteConfig.contact.phone}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="font-bold">Enquiry:</span>
            <a href={`tel:${siteConfig.contact.phoneRaw}`} class="hover:underline">
              +91 96949 32391
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="font-bold">E-mail:</span>
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:underline text-[13px]">
              {siteConfig.contact.email}
            </a>
          </p>
        </div>
      </div>

      <!-- Column 2: Quick Links & Action Buttons -->
      <div class="footer-col">
        <h4 class="text-base font-black text-[#0B1A30] underline underline-offset-4 decoration-2 decoration-[#07366C] mb-4">
          Quick Links
        </h4>
        <ul class="space-y-2 text-[14px] font-semibold text-slate-900 mb-6">
          <li><a href="/" class="hover:underline hover:text-[#07366C] transition-colors">Home</a></li>
          <li><a href="/about-us" class="hover:underline hover:text-[#07366C] transition-colors">About Us</a></li>
          <li><a href="/all-courses" class="hover:underline hover:text-[#07366C] transition-colors">All Courses</a></li>
          <li><a href="/faq" class="hover:underline hover:text-[#07366C] transition-colors">FAQ &amp; Help</a></li>
          <li><a href="/contact" class="hover:underline hover:text-[#07366C] transition-colors">Contact Us</a></li>
          <li><a href="https://bhavya-attendence.vercel.app" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-[#07366C] transition-colors">Student Attendance</a></li>
        </ul>

        <!-- Stacked Colored Action Buttons -->
        <div class="flex flex-col gap-2.5 max-w-[210px]">
          <button
            type="button"
            data-open-demo-modal
            class="w-full py-2.5 px-4 bg-[#082B63] hover:bg-[#062049] text-white text-[13px] font-bold rounded-lg shadow-sm text-center transition-transform hover:-translate-y-0.5"
          >
            Course Brochure
          </button>
          <a
            href="/about-us"
            class="w-full py-2.5 px-4 bg-[#0D9488] hover:bg-[#0F766E] text-white text-[13px] font-bold rounded-lg shadow-sm text-center transition-transform hover:-translate-y-0.5 block"
          >
            About Bhavya
          </a>
          <button
            type="button"
            data-open-demo-modal
            class="w-full py-2.5 px-4 bg-[#1D4ED8] hover:bg-[#1E40AF] text-white text-[13px] font-bold rounded-lg shadow-sm text-center transition-transform hover:-translate-y-0.5"
          >
            Book Free Demo
          </button>
        </div>
      </div>

      <!-- Column 3: Top Courses & Company -->
      <div class="footer-col">
        <!-- Top Courses -->
        <div class="mb-6">
          <h4 class="text-base font-black text-[#0B1A30] underline underline-offset-4 decoration-2 decoration-[#07366C] mb-3">
            Top Courses
          </h4>
          <ul class="space-y-1.5 text-[14px] font-semibold text-slate-900">
            <li><a href="/courses/dca" class="hover:underline hover:text-[#07366C] transition-colors">DCA &amp; PGDCA</a></li>
            <li><a href="/courses/tally-prime" class="hover:underline hover:text-[#07366C] transition-colors">Tally Prime with GST</a></li>
            <li><a href="/courses/advanced-excel" class="hover:underline hover:text-[#07366C] transition-colors">Advanced Excel</a></li>
            <li><a href="/courses/python-programming" class="hover:underline hover:text-[#07366C] transition-colors">Python Programming</a></li>
            <li><a href="/courses/full-stack-web-development" class="hover:underline hover:text-[#07366C] transition-colors">Web Development</a></li>
            <li><a href="/courses/graphic-design-photoshop-illustrator" class="hover:underline hover:text-[#07366C] transition-colors">Graphic Designing</a></li>
            <li><a href="/courses/digital-marketing" class="hover:underline hover:text-[#07366C] transition-colors">Digital Marketing</a></li>
            <li><a href="/courses/rscit" class="hover:underline hover:text-[#07366C] transition-colors">RSCIT (Govt. Approved)</a></li>
          </ul>
        </div>

        <!-- Company -->
        <div>
          <h4 class="text-base font-black text-[#0B1A30] underline underline-offset-4 decoration-2 decoration-[#07366C] mb-2">
            Company
          </h4>
          <ul class="space-y-1.5 text-[14px] font-semibold text-slate-900">
            <li><a href="/about-us" class="hover:underline hover:text-[#07366C] transition-colors">About Us</a></li>
            <li><a href="/contact" class="hover:underline hover:text-[#07366C] transition-colors">Careers &amp; Faculty</a></li>
            <li><a href="/contact" class="hover:underline hover:text-[#07366C] transition-colors">Contact Us</a></li>
          </ul>
        </div>
      </div>

      <!-- Column 4: Google Mini Map -->
      <div class="footer-col flex flex-col">
        <!-- Google Mini Map Card -->
        <div class="w-full">
          <div class="flex items-center justify-between mb-2.5">
            <span class="text-[13.5px] font-black uppercase tracking-wider text-[#0B1A30] flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#B91C1C]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              Our Institute Location
            </span>
            <a
              href="https://maps.google.com/maps?q=3-N-25+Mahaveer+Nagar+Extension+Kota+Rajasthan+324005"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[11.5px] font-extrabold text-[#07366C] underline hover:text-black flex items-center gap-0.5"
            >
              Open Maps &nearr;
            </a>
          </div>

          <div class="relative w-full h-[200px] rounded-xl overflow-hidden shadow-md border-2 border-white bg-white">
            <iframe
              title="Bhavya Career Institute Kota Google Mini Map"
              src="https://maps.google.com/maps?q=3-N-25+Mahaveer+Nagar+Extension+Kota+Rajasthan+324005&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border: 0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>

          <div class="mt-3 bg-white/70 backdrop-blur-sm p-3 rounded-lg border border-amber-300/80 shadow-xs">
            <p class="text-[12.5px] font-bold text-[#0B1A30] leading-snug">
              📍 3-N-25, Mahaveer Nagar Extn.
            </p>
            <p class="text-[11.5px] font-medium text-slate-700 leading-tight mt-0.5">
              Near Ganesh Ji Mandir, Kota, Rajasthan — 324005
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Sub-Footer / Copyright & Legal Strip -->
  <div class="border-t border-[#E59C07]/80 bg-[#EFAC0F] py-4 px-5 sm:px-8">
    <div class="max-w-[1360px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-[12.5px] font-bold text-slate-900">
      <p class="text-center sm:text-left">
        Copyright &copy; 2026 Bhavya Career Institute. All Rights Reserved.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-slate-900">
        <a href="/terms-and-conditions" class="hover:underline">Terms of service</a>
        <span>|</span>
        <a href="/privacy-policy" class="hover:underline">Privacy policy</a>
        <span>|</span>
        <a href="/disclaimer" class="hover:underline">Disclaimer</a>
        <span>|</span>
        <button type="button" data-open-demo-modal class="hover:underline font-extrabold text-[#07366C]">
          Verify Certificate
        </button>
      </div>
    </div>
  </div>
</footer>

<CookieConsent />
<LeadModal />
