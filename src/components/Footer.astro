---

<footer id="footer" class="relative overflow-hidden bg-[#060606]" style="min-height: 90vh;">

  <!-- Google Map background -->
  <div id="footer-map" class="absolute inset-0 z-0 opacity-0 pointer-events-none transition-opacity duration-500">
    <iframe
      title="Bhavya Career Institute Location"
      src="https://maps.google.com/maps?q=Mahaveer+Nagar+Extension+Kota+Rajasthan&t=&z=15&ie=UTF8&iwloc=&output=embed"
      width="100%"
      height="100%"
      style="border: 0; filter: grayscale(100%) brightness(30%) contrast(120%); pointer-events: none;"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      tabindex="-1"
      aria-hidden="true"
    ></iframe>
    <div class="absolute inset-0 bg-gradient-to-t from-[#060606] via-[#060606]/60 to-transparent"></div>
  </div>

  <!-- BIG RISING TEXT -->
  <div id="footer-big-text-container" class="absolute bottom-0 left-0 right-0 flex items-end justify-center pointer-events-none select-none z-10 overflow-hidden">
    <h2
      id="footer-big-text"
      class="font-black uppercase leading-none tracking-tighter whitespace-nowrap opacity-0"
      style="font-size: clamp(80px, 18vw, 260px); -webkit-text-stroke: 1px rgba(255,255,255,0.08); color: transparent; letter-spacing: -0.04em; transform: translateY(30%);"
    >
      BHAVYA
    </h2>
  </div>

  <!-- Footer Content -->
  <div id="footer-content" class="relative z-20 container mx-auto px-8 pt-28 pb-16 opacity-0" style="transform: translateY(60px);">
    <!-- Top row -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-16 border-b border-white/10 pb-16 mb-12">

      <!-- Left: Institute identity -->
      <div class="max-w-sm">
        <span class="text-[10px] uppercase tracking-[0.6em] text-white/30 block mb-4">
          Est. 2010
        </span>
        <h3 class="text-4xl md:text-5xl leading-tight mb-6">
          Bhavya<br />Career Institute
        </h3>
        <p class="text-white/40 text-sm leading-relaxed font-light">
          Empowering students in Kota with government-certified, job-ready digital skills since a decade.
        </p>

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/919694932391"
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-8 inline-flex items-center gap-3 border border-white/20 px-6 py-3 hover:bg-white hover:text-black transition-all duration-500"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.528 2.01 14.069.987 11.48.987 6.045.987 1.62 5.357 1.616 10.787c-.001 1.748.47 3.447 1.36 4.966l-1.001 3.655 3.748-.973.334.218zM18.82 15.111c-.37-.185-2.18-.897-2.52-1.021-.34-.124-.588-.185-.836.186-.248.37-.958 1.206-1.17 1.454-.216.247-.433.279-.803.093-.37-.185-1.56-.57-2.971-1.829-1.09-.973-1.826-2.176-2.04-2.547-.217-.37-.023-.57.162-.754.166-.165.37-.432.556-.65.186-.216.248-.37.372-.617.124-.247.062-.463-.03-.649-.093-.185-.837-2.006-1.146-2.748-.3-.721-.606-.624-.836-.636-.216-.011-.463-.014-.71-.014-.248 0-.65.093-.99.463-.34.37-1.3 1.266-1.3 3.087 0 1.82 1.33 3.582 1.516 3.829.186.247 2.612 3.987 6.326 5.586.883.38 1.572.607 2.11.779.887.282 1.696.242 2.335.146.711-.107 2.18-.89 2.49-1.752.31-.862.31-1.603.217-1.752-.093-.149-.34-.241-.71-.426z" />
          </svg>
          <span class="text-xs uppercase tracking-[0.3em]">Enroll via WhatsApp</span>
          <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right: Contact details -->
      <div class="text-right">
        <div class="mb-10">
          <p class="text-white/30 uppercase tracking-[0.35em] text-[9px] mb-3">Address</p>
          <p class="text-white/70 leading-relaxed text-sm">
            3-N-25, Mahaveer Nagar Extn.<br />
            Near Ganesh Ji Mandir<br />
            Kota, Rajasthan
          </p>
        </div>

        <div class="mb-10">
          <p class="text-white/30 uppercase tracking-[0.35em] text-[9px] mb-3">Phone</p>
          <a href="tel:+919694932391" class="block text-white/70 hover:text-white transition-colors text-sm">
            +91 96949 32391
          </a>
          <a href="tel:+919694025249" class="block text-white/70 hover:text-white transition-colors text-sm mt-1">
            +91 96940 25249
          </a>
        </div>

        <div>
          <p class="text-white/30 uppercase tracking-[0.35em] text-[9px] mb-3">Facilities</p>
          <span class="text-white/50 text-xs uppercase tracking-widest">Library Available</span>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-[10px] uppercase tracking-[0.5em] text-white/20">
        © 2024 Bhavya Career Institute. All rights reserved.
      </p>
      <div class="flex gap-8 text-[10px] uppercase tracking-[0.4em] text-white/20">
        <a href="#" class="hover:text-white/50 transition-colors">Privacy</a>
        <a href="#" class="hover:text-white/50 transition-colors">Terms</a>
        <a href="#" class="hover:text-white/50 transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const footer = document.getElementById('footer');
    const bigText = document.getElementById('footer-big-text');
    const content = document.getElementById('footer-content');
    const map = document.getElementById('footer-map');

    if (!footer || !bigText || !content || !map) return;

    const onScroll = () => {
      const rect = footer.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      // Calculate progress from 0 (top of footer enters bottom of screen) to 1 (bottom of footer is at bottom of screen)
      let progress = 0;
      if (rect.top < windowHeight) {
        progress = (windowHeight - rect.top) / rect.height;
      }
      progress = Math.max(0, Math.min(1, progress));

      // Map opacity (0 to 0.5 -> 0 to 0.6)
      const mapOp = Math.min(0.6, progress * 1.2);
      map.style.opacity = mapOp.toString();

      // Big text Y (0 to 1 -> 30% to -8%) and Opacity (0 to 0.4 -> 0 to 1)
      const textY = 30 - (progress * 38);
      const textOp = Math.min(1, progress * 2.5);
      bigText.style.transform = `translateY(${textY}%)`;
      bigText.style.opacity = textOp.toString();

      // Content Y (0.2 to 0.8 -> 60 to 0) and Opacity (0.2 to 0.6 -> 0 to 1)
      let contY = 60;
      let contOp = 0;
      if (progress > 0.2) {
        contY = Math.max(0, 60 - ((progress - 0.2) / 0.6) * 60);
        contOp = Math.min(1, (progress - 0.2) / 0.4);
      }
      content.style.transform = `translateY(${contY}px)`;
      content.style.opacity = contOp.toString();
    };

    window.addEventListener('scroll', () => {
      requestAnimationFrame(onScroll);
    }, { passive: true });
    
    // Initial call
    onScroll();
  });
</script>
