---
const PATH =
  'M 200 80 C 350 80, 650 200, 720 380 C 790 560, 300 560, 280 740 C 260 920, 720 920, 760 1100 C 800 1280, 420 1330, 500 1450';

const milestones = [
  {
    id: '01',
    stage: 'Foundation',
    title: 'Computer Basics & RSCIT',
    desc: 'Start your journey with government-certified RSCIT — digital literacy, MS Office, internet, and e-governance tools.',
    cx: 200,
    cy: 80,
    side: 'right',
    threshold: 0.0,
    badgeColor: 'bg-[#0757A8]/10 text-[#0757A8] border-[#0757A8]/20',
    dotColor: '#0757A8',
  },
  {
    id: '02',
    stage: 'Skills',
    title: 'Tally & Accounting',
    desc: 'Master Tally ERP with practical accounting — GST, invoicing, ledgers, and financial reporting for business readiness.',
    cx: 720,
    cy: 380,
    side: 'left',
    threshold: 0.22,
    badgeColor: 'bg-[#F39A18]/15 text-[#B86B00] border-[#F39A18]/30',
    dotColor: '#F39A18',
  },
  {
    id: '03',
    stage: 'Digital',
    title: 'Graphic Design & Marketing',
    desc: 'Learn Photoshop, CorelDRAW, DTP, and digital marketing strategies including SEO, social media, and paid campaigns.',
    cx: 280,
    cy: 740,
    side: 'right',
    threshold: 0.46,
    badgeColor: 'bg-purple-100/70 text-purple-700 border-purple-200',
    dotColor: '#9333EA',
  },
  {
    id: '04',
    stage: 'Advanced',
    title: 'Web Dev & Python',
    desc: 'Build dynamic websites with PHP and React. Write automation scripts with Basic and Advanced Python programming.',
    cx: 760,
    cy: 1100,
    side: 'left',
    threshold: 0.68,
    badgeColor: 'bg-emerald-100/70 text-emerald-700 border-emerald-200',
    dotColor: '#059669',
  },
  {
    id: '05',
    stage: 'Career Ready',
    title: 'Distance Diploma & Typing',
    desc: 'Enroll in UGC-recognized online degrees (BA, BCom, MBA, BCA…) and master Hindi/English typing for government jobs.',
    cx: 500,
    cy: 1450,
    side: 'right',
    threshold: 0.9,
    badgeColor: 'bg-[#082B63]/10 text-[#082B63] border-[#082B63]/20',
    dotColor: '#082B63',
  },
];

const CONTAINER_H = 1600;
---

<section
  id="syllabus-container"
  class="py-28 md:py-36 bg-[#F8FAFD] border-t border-[#082B63]/[0.08] relative overflow-hidden"
>
  <!-- Decorative background orbs & ghost watermark -->
  <div class="pointer-events-none absolute -top-32 -left-32 w-[500px] h-[500px] rounded-full bg-[radial-gradient(circle,rgba(7,87,168,0.06)_0%,transparent_70%)]"></div>
  <div class="pointer-events-none absolute top-1/2 -right-32 w-[600px] h-[600px] rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.06)_0%,transparent_70%)]"></div>

  <div
    class="absolute top-24 left-10 opacity-[0.03] select-none pointer-events-none"
  >
    <h2 class="text-[20vw] leading-none font-black italic text-[#082B63]">GROW</h2>
  </div>

  <div class="container mx-auto px-5 sm:px-8 relative z-10 max-w-7xl">
    <!-- Section header -->
    <div class="max-w-3xl mb-24 md:mb-28">
      <span
        data-reveal="up"
        class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-4 opacity-0 translate-y-4 transition-all duration-600 ease-out"
        style="font-family: 'Poppins', sans-serif;"
      >
        <span>Your Roadmap</span>
        <span class="text-[#F39A18]">•</span>
        <span class="font-['Noto_Sans_Devanagari']">सीखने का मार्ग</span>
      </span>
      <h2
        data-reveal="up"
        style="transition-delay: 100ms;"
        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[#082B63] font-['Poppins'] leading-tight opacity-0 translate-y-6 transition-all duration-800 ease-out"
      >
        The Path to
        <span class="text-[#F39A18] block sm:inline"> Career Success</span>
      </h2>
      <p
        data-reveal="up"
        style="transition-delay: 200ms;"
        class="font-['Noto_Sans_Devanagari'] text-[#506176] text-base sm:text-lg mt-4 leading-relaxed opacity-0 translate-y-6 transition-all duration-800 ease-out"
      >
        बुनियादी कंप्यूटर ज्ञान (RSCIT) से लेकर उन्नत प्रोग्रामिंग, अकाउंटिंग व जॉब-रेडी सर्टिफिकेट तक का चरणबद्ध सफर।
      </p>
    </div>

    <!-- Desktop interactive curved timeline -->
    <div
      class="hidden md:block relative w-full"
      style={`height: ${CONTAINER_H}px;`}
    >
      <!-- SVG layer -->
      <svg
        class="absolute inset-0 w-full h-full pointer-events-none"
        viewBox="0 0 1000 1500"
        preserveAspectRatio="none"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <filter id="dotGlow" x="-150%" y="-150%" width="400%" height="400%">
            <feGaussianBlur stdDeviation="4" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
          <filter id="strokeGlow" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
            <feMerge>
              <feMergeNode in="blur"></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
          <linearGradient id="strokeGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0757A8"></stop>
            <stop offset="45%" stop-color="#F39A18"></stop>
            <stop offset="75%" stop-color="#059669"></stop>
            <stop offset="100%" stop-color="#082B63"></stop>
          </linearGradient>
        </defs>

        <!-- Ghost track (light subtle navy track) -->
        <path
          d={PATH}
          stroke="rgba(8, 43, 99, 0.12)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>

        <!-- Animated draw stroke -->
        <path
          id="animated-path"
          d={PATH}
          stroke="url(#strokeGrad)"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          filter="url(#strokeGlow)"
          class="transition-opacity duration-300"
          style={{ opacity: 0 }}></path>

        {
          milestones.map((m) => (
            <g
              class="milestone-dot"
              data-threshold={m.threshold}
              style={{ opacity: 0, transition: 'opacity 0.5s' }}
            >
              <circle
                cx={m.cx}
                cy={m.cy}
                r="24"
                fill="white"
                stroke={m.dotColor}
                stroke-width="1.5"
                class="milestone-ring shadow-sm"
              />
              <circle
                cx={m.cx}
                cy={m.cy}
                r="9"
                fill={m.dotColor}
                filter="url(#dotGlow)"
              />
            </g>
          ))
        }
      </svg>

      <!-- Milestone cards -->
      {
        milestones.map((m) => (
          <div
            class="milestone-card absolute pointer-events-none"
            data-threshold={m.threshold}
            data-side={m.side}
            style={`left: ${(m.cx / 1000) * 100}%; top: ${(m.cy / 1500) * CONTAINER_H}px; transform: ${m.side === 'right' ? 'translate(28px, -50%)' : 'translate(calc(-100% - 28px), -50%)'};`}
          >
            <div
              class={`milestone-card-inner w-[320px] p-6 rounded-2xl border border-[#082B63]/[0.08] bg-white/95 backdrop-blur-xl shadow-[0_12px_36px_rgba(8,43,99,0.08)] hover:shadow-[0_16px_44px_rgba(8,43,99,0.14)] transition-all duration-700 ease-out ${
                m.side === 'left' ? 'text-right' : 'text-left'
              }`}
              style={`opacity: 0; transform: translateX(${m.side === 'right' ? '-28px' : '28px'});`}
            >
              <div
                class={`flex items-center gap-3 mb-3 ${m.side === 'left' ? 'flex-row-reverse' : 'flex-row'}`}
              >
                <span class="text-xs font-black px-2.5 py-0.5 rounded-md bg-[#082B63] text-white font-['Poppins']">
                  {m.id}
                </span>
                <span class={`text-[10px] uppercase tracking-wider px-2.5 py-0.5 rounded-full font-bold border ${m.badgeColor}`} style="font-family: 'Poppins', sans-serif;">
                  {m.stage}
                </span>
              </div>
              <h4 class="text-lg md:text-xl font-bold mb-2 text-[#082B63] font-['Poppins'] leading-snug">
                {m.title}
              </h4>
              <p class="text-xs sm:text-[13px] text-[#506176] leading-relaxed font-normal">
                {m.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Mobile linear vertical timeline -->
    <div
      class="block md:hidden relative border-l-2 border-[#0757A8]/30 pl-6 ml-3 space-y-10 mt-10"
    >
      {
        milestones.map((m) => (
          <div
            data-reveal="left"
            class="relative opacity-0 -translate-x-5 transition-all duration-500 ease-out"
          >
            <div class="absolute -left-[33px] top-1.5 w-4 h-4 bg-[#0757A8] rounded-full border-2 border-white shadow-[0_0_8px_rgba(7,87,168,0.5)]" />
            <div class="p-6 rounded-2xl border border-[#082B63]/[0.08] bg-white shadow-[0_6px_20px_rgba(8,43,99,0.06)]">
              <div class="flex items-center gap-3 mb-2.5">
                <span class="text-xs font-black px-2 py-0.5 rounded bg-[#082B63] text-white font-['Poppins']">
                  {m.id}
                </span>
                <span class={`text-[10px] uppercase tracking-wider px-2.5 py-0.5 rounded-full font-bold border ${m.badgeColor}`} style="font-family: 'Poppins', sans-serif;">
                  {m.stage}
                </span>
              </div>
              <h4 class="text-lg font-bold mb-2 text-[#082B63] font-['Poppins']">
                {m.title}
              </h4>
              <p class="text-xs text-[#506176] leading-relaxed font-normal">
                {m.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-[#082B63]/[0.03] to-transparent pointer-events-none"
  >
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('syllabus-container');
    const path = document.getElementById('animated-path');
    const dots = document.querySelectorAll('.milestone-dot');
    const cards = document.querySelectorAll('.milestone-card');

    if (!container || !(path instanceof SVGPathElement)) return;

    // Set up SVG path for dash animation
    const length = path.getTotalLength();
    path.style.strokeDasharray = `${length} ${length}`;
    path.style.strokeDashoffset = `${length}`;
    path.style.opacity = '0';

    // Animation Loop for smooth spring-like behavior
    let targetProgress = 0;
    let currentProgress = 0;

    const lerp = (start: number, end: number, factor: number): number =>
      start + (end - start) * factor;

    const render = () => {
      currentProgress = lerp(currentProgress, targetProgress, 0.1);

      // Update path
      const drawLength = length * currentProgress;
      path.style.strokeDashoffset = `${length - drawLength}`;

      // Show/hide dots and cards based on progress
      dots.forEach((dot) => {
        if (!(dot instanceof HTMLElement)) return;
        const threshold = parseFloat(dot.getAttribute('data-threshold') || '0');
        const ring = dot.querySelector('.milestone-ring');

        // Dot opacity
        if (currentProgress >= Math.max(0, threshold - 0.01)) {
          dot.style.opacity = '1';
        } else {
          dot.style.opacity = '0';
        }

        // Ring opacity
        if (ring instanceof SVGElement) {
          if (
            currentProgress >= threshold &&
            currentProgress <= threshold + 0.1
          ) {
            (
              ring as SVGElement & { style: CSSStyleDeclaration }
            ).style.opacity = '0.5';
          } else {
            (
              ring as SVGElement & { style: CSSStyleDeclaration }
            ).style.opacity = '0.15';
          }
        }
      });

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const inner = card.querySelector('.milestone-card-inner');
        const threshold = parseFloat(
          card.getAttribute('data-threshold') || '0'
        );

        if (inner instanceof HTMLElement) {
          if (currentProgress >= Math.max(0, threshold - 0.01)) {
            inner.style.opacity = '1';
            inner.style.transform = 'translateX(0)';
          } else {
            const side = card.getAttribute('data-side');
            inner.style.opacity = '0';
            inner.style.transform = `translateX(${side === 'right' ? '-28px' : '28px'})`;
          }
        }
      });

      requestAnimationFrame(render);
    };
    render();

    const onScroll = () => {
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Calculate progress (0 to 1) relative to viewport
      // The section is 1600px tall (+ padding). We start when it's center-screen, end when it's at bottom
      const startTrigger = windowHeight / 2;
      const totalDistance = rect.height; // approximate

      let p = 0;
      if (rect.top <= startTrigger) {
        p = (startTrigger - rect.top) / totalDistance;
      }
      p = Math.max(0, Math.min(1, p));

      targetProgress = p;

      // Stroke opacity logic
      if (targetProgress > 0) {
        path.style.opacity = '1';
      } else {
        path.style.opacity = '0';
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // initial call
  });
</script>
