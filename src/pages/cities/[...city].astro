---
import { getCollection, render } from 'astro:content';
import SEOHead from '../../components/SEOHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const cityEntries = await getCollection('cities');
  return cityEntries.map(entry => ({
    params: { city: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const canonical = `https://bhavyacareerinstitute.com/cities/${entry.id}`;

const localSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": `Bhavya Career Institute — ${entry.data.title ?? 'Kota'}`,
      "description": entry.data.description,
      "url": canonical,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3-N-25, Mahaveer Nagar Extension, Near Ganesh Ji Mandir",
        "addressLocality": "Kota",
        "addressRegion": "Rajasthan",
        "postalCode": "324005",
        "addressCountry": "IN"
      },
      "telephone": "+919694932391"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bhavyacareerinstitute.com/" },
        { "@type": "ListItem", "position": 2, "name": entry.data.title, "item": canonical }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={`${entry.data.title} | Bhavya Career Institute, Kota`}
      description={entry.data.description ?? `Computer training courses near ${entry.data.title}. Bhavya Career Institute offers government-certified DCA, Tally, Python, and Web Development courses in Kota, Rajasthan.`}
      canonical={canonical}
      schema={localSchema}
    />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Navbar />

    <main class="w-full max-w-5xl mx-auto px-4 py-24 min-h-screen">
      <div class="prose prose-invert prose-lg max-w-none text-center mb-12">
        <h1 class="text-5xl font-extrabold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">
          {entry.data.title}
        </h1>
        <p class="text-xl text-gray-400">{entry.data.description}</p>
      </div>

      <div class="bg-gray-900/50 p-8 rounded-2xl border border-gray-800 shadow-xl shadow-blue-900/10 mb-8">
        <div class="prose prose-invert max-w-none">
          <Content />
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
