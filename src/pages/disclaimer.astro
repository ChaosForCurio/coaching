---
export const prerender = true;

import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Disclaimer | Bhavya Career Institute — Kota"
      description="Disclaimer for Bhavya Career Institute. Information about educational content accuracy, course details, external links, and Google AdSense advertisement notices."
      canonical="https://www.bhavyacomputerclasses.com/disclaimer"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main class="w-full min-h-screen pt-20">
      <!-- Standard Hero Banner -->
      <section class="relative py-16 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <nav class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[1.5px] text-white/70 bg-white/[0.07] border border-white/15 px-5 py-2 rounded-full mb-5" aria-label="Breadcrumb">
            <a href="/" class="text-[#F4B51B] hover:text-white transition-colors">Home</a>
            <span class="text-white/40">›</span>
            <span>Disclaimer</span>
          </nav>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-3 text-white font-['Poppins']">
            Disclaimer
          </h1>
          <p class="text-white/80 text-sm max-w-xl mx-auto">
            Last updated: September 2026 • अस्वीकरण
          </p>
        </div>
      </section>

      <!-- Content Container -->
      <div class="max-w-4xl mx-auto px-4 py-16">
        <div class="bg-white p-8 sm:p-12 rounded-3xl border border-[#082B63]/[0.08] shadow-sm space-y-8 text-[#4A5568] leading-relaxed font-['Inter']">
          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">General Disclaimer</h2>
            <p>
              The information provided on <strong>Bhavya Career Institute</strong> (<a href="https://www.bhavyacomputerclasses.com" class="text-[#0757A8] font-semibold hover:underline">www.bhavyacomputerclasses.com</a>) is for general educational and informational purposes only. While we strive to keep information up to date and correct, we make no representations or warranties of any kind about the completeness, accuracy, reliability, or suitability of the information.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">Course & Placement Guarantee Disclaimer</h2>
            <p>
              Course syllabus, batch timings, and fee structures are subject to periodic updates. Placement assistance refers to interview guidance, resume building, and job opportunity notifications; final job placement depends on student performance and interview results.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">Advertising Disclaimer</h2>
            <p>
              This website displays advertisements served by Google AdSense and third-party advertising partners. The presence of an advertisement on this site does not constitute an endorsement, guarantee, or recommendation by Bhavya Career Institute.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">External Links Disclaimer</h2>
            <p>
              Our site may contain links to external websites. We have no control over the content and nature of these sites and assume no responsibility for information provided on external websites.
            </p>
          </section>
        </div>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
