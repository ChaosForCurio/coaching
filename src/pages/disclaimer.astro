---
export const prerender = true;

import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Disclaimer | Bhavya Computer Classes — Kota"
      description="Disclaimer for Bhavya Computer Classes. Information about educational content accuracy, course details, external links, and Google AdSense advertisement notices."
      canonical="https://www.bhavyacomputerclasses.com/disclaimer"
    />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Navbar />

    <main class="w-full min-h-screen pt-32 pb-24 px-6 md:px-12 max-w-5xl mx-auto">
      <div class="border-b border-white/10 pb-8 mb-12">
        <span class="text-xs uppercase tracking-[0.4em] text-white/50 block mb-2">Legal Information</span>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Disclaimer</h1>
        <p class="text-white/60 text-sm mt-3">Last updated: September 2026</p>
      </div>

      <div class="prose prose-invert max-w-none space-y-8 text-white/80 leading-relaxed font-light text-base">
        <section>
          <h2 class="text-2xl font-semibold text-white mb-4">General Disclaimer</h2>
          <p>
            The information provided on <strong>Bhavya Computer Classes</strong> (<a href="https://www.bhavyacomputerclasses.com" class="text-amber-400 hover:underline">www.bhavyacomputerclasses.com</a>) is for general educational and informational purposes only. While we strive to keep information up to date and correct, we make no representations or warranties of any kind about the completeness, accuracy, reliability, or suitability of the information.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-white mb-4">Course & Placement Guarantee Disclaimer</h2>
          <p>
            Course syllabus, batch timings, and fee structures are subject to periodic updates. Placement assistance refers to interview guidance, resume building, and job opportunity notifications; final job placement depends on student performance and interview results.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-white mb-4">Advertising Disclaimer</h2>
          <p>
            This website displays advertisements served by Google AdSense and third-party advertising partners. The presence of an advertisement on this site does not constitute an endorsement, guarantee, or recommendation by Bhavya Computer Classes.
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-semibold text-white mb-4">External Links Disclaimer</h2>
          <p>
            Our site may contain links to external websites. We have no control over the content and nature of these sites and assume no responsibility for information provided on external websites.
          </p>
        </section>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
