---
export const prerender = true;
import { getCollection } from 'astro:content';
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Cursor from '../components/Cursor.astro';
import Navbar from '../components/Navbar.astro';
import Courses from '../components/Courses.astro';
import DigitalCourses from '../components/DigitalCourses.astro';
import Syllabus from '../components/Syllabus.astro';
import Footer from '../components/Footer.astro';

const allCourses = await getCollection('courses');

const coursesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": "All Computer Courses at Bhavya Career Institute, Kota",
      "url": "https://coaching-ts8v.onrender.com/all-courses",
      "itemListElement": allCourses.map((course, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Course",
          "name": course.data.title,
          "description": course.data.description,
          "provider": { "@type": "Organization", "name": "Bhavya Career Institute", "url": "https://coaching-ts8v.onrender.com" },
          "hasCourseInstance": {
            "@type": "CourseInstance",
            "courseMode": "Onsite",
            "location": { "@type": "Place", "name": "Bhavya Career Institute, Kota, Rajasthan" }
          }
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://coaching-ts8v.onrender.com/" },
        { "@type": "ListItem", "position": 2, "name": "All Courses", "item": "https://coaching-ts8v.onrender.com/all-courses" }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="All Computer Courses in Kota | Bhavya Career Institute"
      description="Explore all government-certified computer courses in Kota at Bhavya Career Institute — DCA, Tally Prime with GST, Python, Web Development, RSCIT, Digital Marketing, Graphic Design & Advanced Excel. Placement assistance provided."
      canonical="https://coaching-ts8v.onrender.com/all-courses"
      schema={coursesSchema}
    />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />

    <main class="w-full pt-24 relative">
      <Courses />
      <DigitalCourses />
      <Syllabus />
    </main>

    <Footer />

    <script>
      import { initReveal } from '../scripts/reveal';
      
      document.addEventListener('DOMContentLoaded', () => {
        initReveal();
      });
    </script>
  </body>
</html>
