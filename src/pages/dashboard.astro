---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";
import Cursor from "../components/Cursor.astro";
import Navbar from "../components/Navbar.astro";

import { db } from '../db';
import { users, courses, enrollments, attendance } from '../db/schema';
import { eq, and } from 'drizzle-orm';

const userIdStr = Astro.cookies.get('userSession')?.value;
if (!userIdStr) {
  return Astro.redirect('/login');
}
const userId = parseInt(userIdStr);

// Fetch logged in user
const userResult = await db.select().from(users).where(eq(users.id, userId)).limit(1);
const currentUser = userResult[0];

if (!currentUser) {
  Astro.cookies.delete('userSession');
  return Astro.redirect('/login');
}

// Fetch dynamic database data
let studentCourses: any[] = [];
let studentAttendance: any[] = [];
let teacherCourses: any[] = [];
let allStudents: any[] = [];
let teacherEnrolledStudents: any[] = [];
let allAttendance: any[] = [];
let allEnrollments: any[] = [];

if (currentUser.role === 'STUDENT') {
  const myEnrollments = await db.select().from(enrollments).where(eq(enrollments.student_id, userId));
  const coursesList = await db.select().from(courses);
  studentCourses = coursesList.filter(c => myEnrollments.some(e => e.course_id === c.id));
  studentAttendance = await db.select().from(attendance).where(eq(attendance.student_id, userId));
} else {
  teacherCourses = await db.select().from(courses).where(eq(courses.teacher_id, userId));
  allStudents = await db.select().from(users).where(eq(users.role, 'STUDENT'));
  allEnrollments = await db.select().from(enrollments);
  
  const teacherEnrollments = allEnrollments.filter(e => teacherCourses.some(c => c.id === e.course_id));
  const enrolledStudentIds = Array.from(new Set(teacherEnrollments.map(e => e.student_id)));
  teacherEnrolledStudents = allStudents.filter(s => enrolledStudentIds.includes(s.id));
  allAttendance = await db.select().from(attendance);
}

const dbPayload = {
  currentUser,
  studentCourses,
  studentAttendance,
  teacherCourses,
  allStudents,
  teacherEnrolledStudents,
  allAttendance,
  allEnrollments
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Attendance Dashboard — Bhavya Career Institute"
      description="View your student attendance records, monthly calendar, and course-wise breakdown at Bhavya Career Institute portal."
      canonical="https://bhavyacareerinstitute.com/dashboard"
    />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />
    <div class="noise"></div>

    <!-- Hidden Payload for Client Script -->
    <div id="dashboard-payload" data-payload={JSON.stringify(dbPayload)} class="hidden"></div>

    <!-- ─── Dashboard Shell ────────────────────────────────────── -->
    <div class="dashboard-shell min-h-screen flex pt-[72px]">

      <!-- Sidebar -->
      <aside id="sidebar" class="sidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
          <div class="brand-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="url(#sg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <defs><linearGradient id="sg" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#a78bfa"/><stop offset="100%" stop-color="#22d3ee"/></linearGradient></defs>
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div>
            <p class="brand-name">BCI Portal</p>
            <p class="brand-sub" id="brand-role-sub">Student Dashboard</p>
          </div>
        </div>

        <!-- User card -->
        <div class="sidebar-user-card" id="sidebar-user-card">
          <div class="user-avatar" id="user-avatar">A</div>
          <div class="user-info">
            <p class="user-name" id="user-name">User</p>
            <p class="user-role" id="user-role-badge">Student</p>
          </div>
          <div class="user-status-dot"></div>
        </div>

        <!-- Nav -->
        <nav class="sidebar-nav">
          <a href="#profile" class="sidebar-link" id="nav-profile">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            My Profile
          </a>
          <a href="#overview" class="sidebar-link active" id="nav-overview">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Overview
          </a>
          <a href="#calendar" class="sidebar-link student-only" id="nav-calendar">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Calendar
          </a>
          <a href="#courses" class="sidebar-link" id="nav-courses">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            Courses
          </a>
          <a href="#mark" class="sidebar-link teacher-only hidden" id="nav-mark">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Mark Attendance
          </a>
          <a href="#assign" class="sidebar-link teacher-only hidden" id="nav-assign">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Assign Course
          </a>
        </nav>

        <!-- Logout -->
        <button id="logout-btn" class="sidebar-logout">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </button>
      </aside>

      <!-- Mobile header -->
      <div class="mobile-header">
        <button id="sidebar-toggle" class="sidebar-toggle-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <span class="mobile-brand">BCI Portal</span>
        <div class="user-avatar sm-avatar" id="mobile-avatar">A</div>
      </div>

      <!-- Main Content -->
      <main class="dashboard-main">

        <!-- ─── Page Header ───────────────────────── -->
        <div class="page-header">
          <div>
            <h2 class="page-title" id="page-greeting">Good morning! 👋</h2>
            <p class="page-subtitle" id="page-subtitle">Here's your attendance overview</p>
          </div>
          <div class="flex items-center gap-3">
            <div class="date-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
              <span id="today-date">June 6, 2026</span>
            </div>
          </div>
        </div>

        <!-- ─── Alert Banner ──────────────────────── -->
        <div id="alert-banner" class="alert-banner hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span id="alert-banner-text">⚠️ Your overall attendance is below 75%. Please attend classes regularly.</span>
          <button class="alert-close" onclick="this.closest('.alert-banner').classList.add('hidden')">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <!-- ─── User Profile ────────────────────────── -->
        <section id="profile" class="section">
          <div class="section-header">
            <h3 class="section-title">My Profile</h3>
          </div>
          <div class="stat-card mb-10">
            <div class="flex items-center gap-6 mb-6 pb-6 border-b border-white/10">
              <div class="user-avatar" id="profile-avatar" style="width: 80px; height: 80px; font-size: 32px;">U</div>
              <div>
                <h4 class="text-xl font-bold text-white mb-1" id="profile-name" style="font-family: 'Syne', sans-serif;">Name</h4>
                <p class="text-white/40 text-sm capitalize" id="profile-role" style="font-family: 'Outfit', sans-serif;">Role</p>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <p class="text-white/40 text-xs uppercase tracking-widest mb-1" style="font-family: 'Outfit', sans-serif;">Email</p>
                <p class="text-white/80 font-medium" id="profile-email" style="font-family: 'Outfit', sans-serif;">—</p>
              </div>
              <div>
                <p class="text-white/40 text-xs uppercase tracking-widest mb-1" style="font-family: 'Outfit', sans-serif;">Unique ID</p>
                <div class="flex items-center gap-2 bg-black/20 p-2.5 rounded-xl border border-white/5">
                  <code class="text-[#c4b5fd] text-sm flex-1 font-mono tracking-wider" id="profile-uuid">—</code>
                  <button type="button" id="profile-copy-uuid" class="flex items-center justify-center p-2 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-white/50 hover:text-white transition-all cursor-pointer" title="Copy ID">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── Overview Stats ─────────────────────── -->
        <section id="overview" class="section">
          <div class="stats-grid">

            <!-- Overall Attendance Ring -->
            <div class="stat-card stat-card-main">
              <div class="stat-main-inner">
                <div class="ring-container">
                  <svg class="ring-svg" viewBox="0 0 120 120">
                    <circle class="ring-bg" cx="60" cy="60" r="50" />
                    <circle id="ring-fg" class="ring-fg" cx="60" cy="60" r="50"
                      stroke-dasharray="314"
                      stroke-dashoffset="40"
                    />
                  </svg>
                  <div class="ring-label">
                    <span class="ring-percent" id="ring-percent">87%</span>
                    <span class="ring-sub" id="ring-sub-label">Overall</span>
                  </div>
                </div>
                <div class="ring-meta">
                  <p class="ring-meta-title" id="ring-meta-title">Attendance Summary</p>
                  <p class="ring-meta-sub" id="ring-meta-sub">This Month</p>
                  <div class="ring-meta-stats" id="ring-stats-container">
                    <div class="ring-meta-item">
                      <span class="dot dot-present"></span>
                      <span class="text-white/60 text-sm">Present</span>
                      <span class="text-white font-semibold text-sm ml-auto" id="stat-present">—</span>
                    </div>
                    <div class="ring-meta-item">
                      <span class="dot dot-absent"></span>
                      <span class="text-white/60 text-sm">Absent</span>
                      <span class="text-white font-semibold text-sm ml-auto" id="stat-absent">—</span>
                    </div>
                    <div class="ring-meta-item">
                      <span class="dot dot-holiday"></span>
                      <span class="text-white/60 text-sm">Holidays</span>
                      <span class="text-white font-semibold text-sm ml-auto" id="stat-holiday">—</span>
                    </div>
                    <div class="ring-meta-item border-t border-white/6 pt-2 mt-1">
                      <span class="text-white/60 text-sm">Total School Days</span>
                      <span class="text-white font-semibold text-sm ml-auto" id="stat-total">—</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Stat Cards -->
            <div class="stat-card stat-card-sm">
              <div class="stat-icon-wrap stat-icon-green" id="card-1-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div>
                <p class="stat-sm-label" id="card-1-label">This Week</p>
                <p class="stat-sm-value" id="card-1-value">—</p>
                <p class="stat-sm-sub text-emerald-400" id="card-1-sub">—</p>
              </div>
            </div>
            <div class="stat-card stat-card-sm">
              <div class="stat-icon-wrap stat-icon-blue" id="card-2-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </div>
              <div>
                <p class="stat-sm-label" id="card-2-label">Active Courses</p>
                <p class="stat-sm-value" id="card-2-value">—</p>
                <p class="stat-sm-sub text-cyan-400" id="card-2-sub">—</p>
              </div>
            </div>
            <div class="stat-card stat-card-sm">
              <div class="stat-icon-wrap stat-icon-amber" id="card-3-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <p class="stat-sm-label" id="card-3-label">Streak</p>
                <p class="stat-sm-value" id="card-3-value">—</p>
                <p class="stat-sm-sub text-amber-400" id="card-3-sub">—</p>
              </div>
            </div>

          </div>
        </section>

        <!-- ─── Monthly Calendar (Student only) ───────────────────── -->
        <section id="calendar" class="section student-only">
          <div class="section-header">
            <h3 class="section-title">Monthly Calendar</h3>
            <div class="calendar-nav">
              <button class="cal-nav-btn" id="prev-month">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <span class="cal-month-label" id="cal-month">June 2026</span>
              <button class="cal-nav-btn" id="next-month">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>

          <div class="calendar-card">
            <!-- Legend -->
            <div class="cal-legend">
              <span class="legend-item"><span class="dot dot-present"></span>Present</span>
              <span class="legend-item"><span class="dot dot-absent"></span>Absent</span>
              <span class="legend-item"><span class="dot dot-holiday"></span>Holiday</span>
              <span class="legend-item"><span class="dot dot-today"></span>Today</span>
            </div>
            <div class="overflow-x-auto pb-4">
              <div class="min-w-[500px]">
                <!-- Day headers -->
                <div class="cal-day-headers">
                  <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
                </div>
                <!-- Calendar grid -->
                <div class="cal-grid" id="cal-grid">
                  <!-- Filled by JS -->
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ─── Course-wise Breakdown ──────────────── -->
        <section id="courses" class="section">
          <div class="section-header">
            <h3 class="section-title" id="courses-section-title">Course-wise Attendance</h3>
            <button class="download-btn" id="download-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download Report
            </button>
          </div>

          <div class="courses-table-wrap overflow-x-auto">
            <table class="courses-table min-w-[700px]">
              <thead id="courses-thead">
                <tr>
                  <th>Course</th>
                  <th>Present</th>
                  <th>Total</th>
                  <th>Percentage</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="courses-tbody">
                <!-- Filled by JS -->
              </tbody>
            </table>
          </div>
        </section>

        <!-- ─── Mark Attendance (Teacher only) ── -->
        <section id="mark" class="section teacher-only hidden">
          <div class="section-header">
            <h3 class="section-title">Mark Attendance</h3>
            <div class="flex gap-2">
              <select class="section-select" id="mark-course">
                <!-- Loaded Dynamically -->
              </select>
              <input type="date" class="section-select" id="mark-date" />
            </div>
          </div>
          <div class="mark-table-wrap overflow-x-auto">
            <table class="courses-table min-w-[700px]">
              <thead>
                <tr><th>Roll No.</th><th>Student Name</th><th>Status</th><th>Remarks</th></tr>
              </thead>
              <tbody id="mark-tbody">
                <!-- Filled by JS -->
              </tbody>
            </table>
            <div class="flex justify-end mt-4 px-4 pb-4">
              <button class="login-btn-mini" id="save-attendance">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Save Attendance
              </button>
            </div>
          </div>
        </section>

        <!-- ─── Assign Course (Teacher only) ── -->
        <section id="assign" class="section teacher-only hidden">
          <div class="section-header">
            <h3 class="section-title">Assign Course to Student</h3>
          </div>
          <div class="stat-card">
            <form action="/api/assign-course" method="POST" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="form-label">Select Student</label>
                  <select name="student_id" class="section-select w-full p-3 bg-black/40 border border-white/10 rounded-xl text-white outline-none focus:border-[#a78bfa]" required>
                    {allStudents.map(s => <option value={s.id} class="bg-[#0a0a0a]">{s.name} ({s.email})</option>)}
                  </select>
                </div>
                <div>
                  <label class="form-label">Select Course</label>
                  <select name="course_id" class="section-select w-full p-3 bg-black/40 border border-white/10 rounded-xl text-white outline-none focus:border-[#a78bfa]" required>
                    {teacherCourses.map(c => <option value={c.id} class="bg-[#0a0a0a]">{c.title}</option>)}
                  </select>
                </div>
              </div>
              <div class="flex justify-end mt-4">
                <button type="submit" class="login-btn-mini">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Assign Course
                </button>
              </div>
            </form>
          </div>
        </section>

      </main>
    </div>

    <style>
      /* ─── Layout ───────────────────────────────── */
      .dashboard-shell { background: #0a0a0a; }

      .sidebar {
        width: 240px;
        min-height: calc(100vh - 72px);
        background: rgba(255,255,255,0.025);
        border-right: 1px solid rgba(255,255,255,0.06);
        display: flex;
        flex-direction: column;
        padding: 24px 16px;
        gap: 6px;
        position: fixed;
        top: 72px; left: 0; bottom: 0;
        z-index: 40;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        transition: transform 0.35s cubic-bezier(0.16,1,0.3,1);
      }

      .dashboard-main {
        margin-left: 240px;
        flex: 1;
        padding: 32px 32px 64px;
        min-height: 100vh;
      }

      @media (max-width: 768px) {
        .sidebar { transform: translateX(-100%); top: 0; min-height: 100vh; z-index: 60; }
        .sidebar.open { transform: translateX(0); }
