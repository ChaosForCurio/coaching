    <script>
      // ─── Load DB Payload ──────────────────────────────────────────────────────
      const payloadEl = document.getElementById('dashboard-payload');
      const payload = JSON.parse(payloadEl?.getAttribute('data-payload') || '{}');

      const currentUser = payload.currentUser;
      const role = currentUser.role.toLowerCase(); // 'student' or 'teacher'
      const userId = currentUser.id;
      const displayName = currentUser.name;
      const storedEmail = currentUser.email;

      // Update sidebar role label and user cards
      document.getElementById('brand-role-sub')!.textContent = currentUser.role.charAt(0) + currentUser.role.slice(1).toLowerCase() + ' Portal';
      document.getElementById('user-name')!.textContent = displayName;
      document.getElementById('user-role-badge')!.textContent = role.toUpperCase();
      
      const avatarLetter = displayName.charAt(0).toUpperCase() || 'U';
      const avatarEl = document.getElementById('user-avatar');
      const mobileAvatarEl = document.getElementById('mobile-avatar');
      const profileAvatar = document.getElementById('profile-avatar');
      if (avatarEl) avatarEl.textContent = avatarLetter;
      if (mobileAvatarEl) mobileAvatarEl.textContent = avatarLetter;
      if (profileAvatar) profileAvatar.textContent = avatarLetter;

      // Update Profile Details
      document.getElementById('profile-name')!.textContent = displayName;
      document.getElementById('profile-role')!.textContent = currentUser.role;
      document.getElementById('profile-email')!.textContent = storedEmail;
      document.getElementById('profile-uuid')!.textContent = String(userId);

      // Copy UUID helper
      document.getElementById('profile-copy-uuid')?.addEventListener('click', function() {
        navigator.clipboard.writeText(String(userId)).then(() => {
          const btn = this as HTMLButtonElement;
          const origHTML = btn.innerHTML;
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
          setTimeout(() => { btn.innerHTML = origHTML; }, 2000);
        });
      });

      // Show/Hide role specific navigation
      if (role === 'teacher') {
        document.querySelectorAll('.teacher-only').forEach(el => el.classList.remove('hidden'));
        document.querySelectorAll('.student-only').forEach(el => el.classList.remove('show', 'flex-show'));
      } else {
        document.querySelectorAll('.teacher-only').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.student-only').forEach(el => el.classList.add('show'));
      }

      // ─── Greeting ─────────────────────────────────────────────────────────────
      const hour = new Date().getHours();
      const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
      document.getElementById('page-greeting')!.textContent = `${greeting}, ${displayName.split(' ')[0]}! 👋`;

      // ─── Date ─────────────────────────────────────────────────────────────────
      document.getElementById('today-date')!.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

      // ─── Date Input Default for Teacher ───────────────────────────────────────
      const markDateInput = document.getElementById('mark-date') as HTMLInputElement | null;
      if (markDateInput) {
        markDateInput.value = new Date().toISOString().split('T')[0];
      }

      // ─── Calculations & Stat Panels ──────────────────────────────────────────
      let currentMonth = new Date(2026, 5, 1); // June 2026

      function getStatusBadge(pct: number) {
        if (pct >= 80) return `<span class="status-badge status-safe">● Safe</span>`;
        if (pct >= 75) return `<span class="status-badge status-warning">▲ Warning</span>`;
        return `<span class="status-badge status-danger">✗ At Risk</span>`;
      }
      function getBarColor(pct: number) {
        if (pct >= 80) return 'linear-gradient(90deg, #10b981, #34d399)';
        if (pct >= 75) return 'linear-gradient(90deg, #f59e0b, #fcd34d)';
        return 'linear-gradient(90deg, #ef4444, #f87171)';
      }
      function getPercentColor(pct: number) {
        if (pct >= 80) return '#10b981';
        if (pct >= 75) return '#f59e0b';
        return '#ef4444';
      }

      function renderDashboard() {
        const ringFg = document.getElementById('ring-fg') as SVGCircleElement | null;
        const CIRCUMFERENCE = 2 * Math.PI * 50;
        
        if (role === 'student') {
          // Calculate student attendance status map
          const attendanceData: Record<number, string> = {};
          payload.studentAttendance.forEach((att: any) => {
            const d = new Date(att.date);
            if (d.getFullYear() === currentMonth.getFullYear() && d.getMonth() === currentMonth.getMonth()) {
              attendanceData[d.getDate()] = 'present';
            }
          });

          // Generate calendar cells dynamically
          const grid = document.getElementById('cal-grid');
          const calMonthLabel = document.getElementById('cal-month');
          if (grid && calMonthLabel) {
            calMonthLabel.textContent = currentMonth.toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
            
            const year = currentMonth.getFullYear();
            const month = currentMonth.getMonth();
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const todayStr = new Date().toISOString().split('T')[0];

            grid.innerHTML = '';
            // Empty cells before first day
            for (let i = 0; i < firstDay; i++) {
              const empty = document.createElement('div');
              empty.className = 'cal-day empty';
              grid.appendChild(empty);
            }

            let presentCount = 0;
            let absentCount = 0;
            let holidayCount = 0;

            for (let d = 1; d <= daysInMonth; d++) {
              const cell = document.createElement('div');
              const cellDate = new Date(year, month, d);
              const cellDateStr = cellDate.toISOString().split('T')[0];
              const isSunday = cellDate.getDay() === 0;

              let status = '';
              if (cellDateStr <= todayStr) {
                if (isSunday) {
                  status = 'holiday';
                  holidayCount++;
                } else if (attendanceData[d] === 'present') {
                  status = 'present';
                  presentCount++;
                } else {
                  status = 'absent';
                  absentCount++;
                }
              }

              const isToday = cellDateStr === todayStr;
              cell.className = `cal-day ${isToday ? 'today' : status}`;
              cell.textContent = String(d);

              const statusLabels: Record<string, string> = {
                present: '✓ Present',
                absent: '✗ Absent',
                holiday: '⊘ Holiday',
                today: '● Today',
              };
              if (status) cell.title = statusLabels[status] || '';
              grid.appendChild(cell);
            }

            // Update Ring metrics
            const totalClasses = presentCount + absentCount;
            const overallPct = totalClasses > 0 ? Math.round((presentCount / totalClasses) * 100) : 100;

            document.getElementById('ring-percent')!.textContent = overallPct + '%';
            document.getElementById('stat-present')!.textContent = String(presentCount);
            document.getElementById('stat-absent')!.textContent = String(absentCount);
            document.getElementById('stat-holiday')!.textContent = String(holidayCount);
            document.getElementById('stat-total')!.textContent = String(totalClasses);

            if (ringFg) {
              const offset = CIRCUMFERENCE - (overallPct / 100) * CIRCUMFERENCE;
              ringFg.style.strokeDasharray = `${CIRCUMFERENCE}`;
              ringFg.style.strokeDashoffset = `${offset}`;
            }

            // Alert banner control
            const alertBanner = document.getElementById('alert-banner');
            if (overallPct < 75) {
              alertBanner?.classList.remove('hidden');
              document.getElementById('alert-banner-text')!.textContent = `⚠️ Your overall attendance is at ${overallPct}%, which is below 75%. Please attend regularly.`;
            } else {
              alertBanner?.classList.add('hidden');
            }

            // Cards: card-1 (This Week), card-2 (Courses), card-3 (Streak)
            document.getElementById('card-1-label')!.textContent = 'Weekly Presence';
            document.getElementById('card-1-value')!.textContent = `${presentCount} Days`;
            document.getElementById('card-1-sub')!.textContent = 'Logged In This Month';

            document.getElementById('card-2-label')!.textContent = 'Enrolled Courses';
            document.getElementById('card-2-value')!.textContent = String(payload.studentCourses.length);
            document.getElementById('card-2-sub')!.textContent = payload.studentCourses.length > 0 ? payload.studentCourses[0].title : 'No active courses';

            // Calculate streak
            let streak = 0;
            let streakCheckDate = new Date();
            streakCheckDate.setHours(0,0,0,0);
            const presentDates = new Set(payload.studentAttendance.map((a: any) => a.date));
            for (let i = 0; i < 90; i++) {
              const dateStr = streakCheckDate.toISOString().split('T')[0];
              const isSunday = streakCheckDate.getDay() === 0;
              if (presentDates.has(dateStr)) {
                streak++;
              } else if (isSunday) {
                // skip
              } else {
                if (i > 0) break; // if today is missed but yesterday was present, keep streak
              }
              streakCheckDate.setDate(streakCheckDate.getDate() - 1);
            }

            document.getElementById('card-3-label')!.textContent = 'Streak';
            document.getElementById('card-3-value')!.textContent = `${streak} Days`;
            document.getElementById('card-3-sub')!.textContent = streak > 0 ? '🔥 Keep it up!' : 'Log in tomorrow to start a streak!';

            // Student Courses Table
            const tbody = document.getElementById('courses-tbody');
            if (tbody) {
              tbody.innerHTML = '';
              if (payload.studentCourses.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-white/30">No courses assigned yet.</td></tr>`;
              } else {
                payload.studentCourses.forEach((c: any) => {
                  tbody.innerHTML += `
                    <tr>
                      <td style="color:rgba(255,255,255,0.85); font-weight:500;">${c.title}</td>
                      <td>${presentCount}</td>
                      <td>${totalClasses}</td>
                      <td>
                        <div class="progress-wrap">
                          <div class="progress-bar-bg">
                            <div class="progress-bar-fg" style="width:${overallPct}%; background:${getBarColor(overallPct)};"></div>
                          </div>
                          <span class="progress-label" style="color:${getPercentColor(overallPct)}">${overallPct}%</span>
                        </div>
                      </td>
                      <td>${getStatusBadge(overallPct)}</td>
                    </tr>`;
                });
              }
            }
          }
        } else {
          // TEACHER VIEW CALCULATIONS
          // Ring displays today's attendance rate for teacher's student pool
          const todayStr = new Date().toISOString().split('T')[0];
          const enrolledStudentIds = new Set(
            payload.allEnrollments
              .filter((e: any) => payload.teacherCourses.some((c: any) => c.id === e.course_id))
              .map((e: any) => e.student_id)
          );

          const totalStudentsCount = enrolledStudentIds.size;
          const presentTodayCount = payload.allAttendance.filter((a: any) => a.date === todayStr && enrolledStudentIds.has(a.student_id)).length;
          const absentTodayCount = Math.max(0, totalStudentsCount - presentTodayCount);
          const attendanceRate = totalStudentsCount > 0 ? Math.round((presentTodayCount / totalStudentsCount) * 100) : 100;

          document.getElementById('ring-percent')!.textContent = attendanceRate + '%';
          document.getElementById('ring-sub-label')!.textContent = "Today's Rate";
          document.getElementById('ring-meta-title')!.textContent = "Student Attendance Today";
          document.getElementById('ring-meta-sub')!.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

          const statsContainer = document.getElementById('ring-stats-container');
          if (statsContainer) {
            statsContainer.innerHTML = `
              <div class="ring-meta-item">
                <span class="dot dot-present"></span>
                <span class="text-white/60 text-sm">Present Today</span>
                <span class="text-white font-semibold text-sm ml-auto">${presentTodayCount}</span>
              </div>
              <div class="ring-meta-item">
                <span class="dot dot-absent"></span>
                <span class="text-white/60 text-sm">Absent Today</span>
                <span class="text-white font-semibold text-sm ml-auto">${absentTodayCount}</span>
              </div>
              <div class="ring-meta-item border-t border-white/6 pt-2 mt-1">
                <span class="text-white/60 text-sm">Total Enrolled Students</span>
                <span class="text-white font-semibold text-sm ml-auto">${totalStudentsCount}</span>
              </div>
            `;
          }

          if (ringFg) {
            const offset = CIRCUMFERENCE - (attendanceRate / 100) * CIRCUMFERENCE;
            ringFg.style.strokeDasharray = `${CIRCUMFERENCE}`;
            ringFg.style.strokeDashoffset = `${offset}`;
          }

          // Stat Cards
          document.getElementById('card-1-icon')!.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;
          document.getElementById('card-1-label')!.textContent = 'Active Courses';
          document.getElementById('card-1-value')!.textContent = String(payload.teacherCourses.length);
          document.getElementById('card-1-sub')!.textContent = 'Courses taught by you';

          document.getElementById('card-2-icon')!.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;
          document.getElementById('card-2-label')!.textContent = 'Student Pool';
          document.getElementById('card-2-value')!.textContent = String(payload.teacherEnrolledStudents.length);
          document.getElementById('card-2-sub')!.textContent = 'Total Enrolled Students';

          document.getElementById('card-3-icon')!.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`;
          document.getElementById('card-3-label')!.textContent = 'Recent Attendance';
          document.getElementById('card-3-value')!.textContent = `${payload.allAttendance.length} Logs`;
          document.getElementById('card-3-sub')!.textContent = 'Saved in database';

          // Courses Table for Teacher
          document.getElementById('courses-section-title')!.textContent = 'My Courses & Enrolled Students';
          const coursesThead = document.getElementById('courses-thead');
          if (coursesThead) {
            coursesThead.innerHTML = `
              <tr>
                <th>Course Name</th>
                <th>Enrolled Students</th>
                <th>Status</th>
              </tr>
            `;
          }

          const tbody = document.getElementById('courses-tbody');
          if (tbody) {
            tbody.innerHTML = '';
            if (payload.teacherCourses.length === 0) {
              tbody.innerHTML = `<tr><td colspan="3" class="text-center py-8 text-white/30">No courses assigned to you.</td></tr>`;
            } else {
              payload.teacherCourses.forEach((c: any) => {
                const count = payload.allEnrollments.filter((e: any) => e.course_id === c.id).length;
                tbody.innerHTML += `
                  <tr>
                    <td style="color:rgba(255,255,255,0.85); font-weight:500;">${c.title}</td>
                    <td>${count} Students</td>
                    <td><span class="status-badge status-safe">Active</span></td>
                  </tr>`;
              });
            }
          }
        }
      }

      renderDashboard();

      // Prev & Next Month buttons for calendar
      document.getElementById('prev-month')?.addEventListener('click', () => {
        currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1);
        renderDashboard();
      });
      document.getElementById('next-month')?.addEventListener('click', () => {
        currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
        renderDashboard();
      });

      // ─── Mark Attendance Dropdown & Selection Changes ────────────────────────
      const markCourseSelect = document.getElementById('mark-course') as HTMLSelectElement | null;
      
      if (markCourseSelect && role === 'teacher') {
        markCourseSelect.innerHTML = payload.teacherCourses.map((c: any) => 
          `<option value="${c.id}" class="bg-[#0a0a0a]">${c.title}</option>`
        ).join('');

        async function updateAttendanceMarkList() {
          const selectedCourseId = parseInt(markCourseSelect!.value);
          const selectedDate = (document.getElementById('mark-date') as HTMLInputElement).value;
          if (!selectedCourseId || !selectedDate) return;

          // Find present students on selected date
          const presentStudentIds = new Set(
            payload.allAttendance
              .filter((a: any) => a.date === selectedDate)
              .map((a: any) => a.student_id)
          );

          // Get students enrolled in selected course
          const studentIds = payload.allEnrollments
            .filter((e: any) => e.course_id === selectedCourseId)
            .map((e: any) => e.student_id);
          const enrolledStudents = payload.allStudents.filter((s: any) => studentIds.includes(s.id));

          const markTbody = document.getElementById('mark-tbody');
          if (!markTbody) return;
          markTbody.innerHTML = '';
          
          if (enrolledStudents.length === 0) {
            markTbody.innerHTML = `<tr><td colspan="4" class="text-center text-white/30 py-8">No students enrolled in this course.</td></tr>`;
            return;
          }

          enrolledStudents.forEach((s: any) => {
            const isPresent = presentStudentIds.has(s.id);
            const row = document.createElement('tr');
            row.innerHTML = `
              <td>BCI-${s.id.toString().padStart(3, '0')}</td>
              <td style="color:rgba(255,255,255,0.85); font-weight:500;">${s.name}</td>
              <td>
                <div class="attend-btn-group" data-student-id="${s.id}">
                  <button class="attend-btn attend-p ${isPresent ? 'selected' : ''}" onclick="selectAttend(this,'P')">P</button>
                  <button class="attend-btn attend-a ${!isPresent ? 'selected' : ''}" onclick="selectAttend(this,'A')">A</button>
                </div>
              </td>
              <td><input type="text" placeholder="Optional…" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:7px;padding:5px 10px;color:rgba(255,255,255,0.6);font-family:'Outfit',sans-serif;font-size:12px;outline:none;width:100px;" /></td>
            `;
            markTbody.appendChild(row);
          });
        }

        markCourseSelect.addEventListener('change', updateAttendanceMarkList);
        document.getElementById('mark-date')?.addEventListener('change', updateAttendanceMarkList);
        updateAttendanceMarkList();

        (window as any).selectAttend = function(btn: HTMLButtonElement, type: string) {
          const group = btn.closest('.attend-btn-group');
          group?.querySelectorAll('.attend-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
        };

        // Save Attendance Trigger
        document.getElementById('save-attendance')?.addEventListener('click', async () => {
          const btn = document.getElementById('save-attendance') as HTMLButtonElement;
          const selectedDate = (document.getElementById('mark-date') as HTMLInputElement).value;
          const buttonGroups = document.querySelectorAll('.attend-btn-group');
          
          const attendanceList: Array<{ studentId: number; status: 'P' | 'A' }> = [];
          buttonGroups.forEach(group => {
            const studentId = parseInt((group as HTMLElement).dataset.studentId || '0');
            const isPresent = group.querySelector('.attend-p')!.classList.contains('selected');
            attendanceList.push({
              studentId,
              status: isPresent ? 'P' : 'A'
            });
          });

          try {
            const res = await fetch('/api/mark-attendance', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ date: selectedDate, attendanceList })
            });

            if (res.ok) {
              btn.textContent = '✓ Saved!';
              btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
              setTimeout(() => {
                window.location.reload();
              }, 1000);
            } else {
              alert('Failed to save attendance');
            }
          } catch (err) {
            console.error(err);
            alert('Error saving attendance');
          }
        });
      }

      // ─── Download CSV Report (Demo) ──────────────────────────────────────────
      document.getElementById('download-btn')?.addEventListener('click', () => {
        let csvContent = "";
        let filename = `BCI_Attendance_${userId}_Report.csv`;
        
        if (role === 'student') {
          const rows = [
            ['Course Title', 'Present Days', 'Total School Days', 'Percentage'],
            ...payload.studentCourses.map((c: any) => {
              const totalDays = payload.studentAttendance.length; // rough mapping
              return [c.title, totalDays, totalDays, '100%'];
            })
          ];
          csvContent = rows.map(r => r.join(',')).join('\n');
        } else {
          filename = `BCI_Teacher_Courses_Report.csv`;
          const rows = [
            ['Course Title', 'Enrolled Students count'],
            ...payload.teacherCourses.map((c: any) => {
              const count = payload.allEnrollments.filter((e: any) => e.course_id === c.id).length;
              return [c.title, `${count} Students`];
            })
          ];
          csvContent = rows.map(r => r.join(',')).join('\n');
        }

        const blob = new Blob([csvContent], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
      });

      // ─── Logout ───────────────────────────────────────────────────────────────
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        // Clear server session cookie
        document.cookie = 'userSession=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        window.location.href = '/login';
      });

      // ─── Mobile sidebar toggle ────────────────────────────────────────────────
      const sidebar = document.getElementById('sidebar');
      document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
        sidebar?.classList.toggle('open');
      });

      // ─── Sidebar nav active links ─────────────────────────────────────────────
      document.querySelectorAll('.sidebar-link').forEach(link => {
        link.addEventListener('click', () => {
          document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
          link.classList.add('active');
          sidebar?.classList.remove('open');
        });
      });

      // SVG dynamic gradient setup
      const svgNS = 'http://www.w3.org/2000/svg';
      const defs = document.createElementNS(svgNS, 'defs');
      const lg = document.createElementNS(svgNS, 'linearGradient');
      lg.setAttribute('id', 'rg');
      lg.setAttribute('x1', '0%'); lg.setAttribute('y1', '0%');
      lg.setAttribute('x2', '100%'); lg.setAttribute('y2', '100%');
      const s1 = document.createElementNS(svgNS, 'stop');
      s1.setAttribute('offset', '0%'); s1.setAttribute('stop-color', '#a78bfa');
      const s2 = document.createElementNS(svgNS, 'stop');
      s2.setAttribute('offset', '100%'); s2.setAttribute('stop-color', '#22d3ee');
      lg.appendChild(s1); lg.appendChild(s2);
      defs.appendChild(lg);
      document.querySelector('.ring-svg')?.prepend(defs);
    </script>
  </body>
</html>
