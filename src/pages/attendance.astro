---
export const prerender = true;

import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Daily Student Attendance | Bhavya Computer Classes"
      description="Mark your daily attendance for Bhavya Computer Classes."
      canonical="https://www.bhavyacomputerclasses.com/attendance"
    />
  </head>
  <body
    class="bg-[#fafaf8] text-[#1a1a2e] overflow-x-hidden selection:bg-[#1a1a2e]/20 flex flex-col min-h-screen"
  >
    <Navbar />

    <main class="w-full flex-grow pt-32 pb-24">
      <div class="max-w-4xl mx-auto px-4 md:px-8">
        <!-- Header -->
        <div class="text-center mb-12">
          <h1
            class="text-4xl md:text-5xl font-bold font-plus-jakarta tracking-tight mb-4"
          >
            Daily Attendance
          </h1>
          <p class="text-lg text-black/60 max-w-2xl mx-auto">
            Please mark your attendance daily. Select your batch, enter your
            name, and submit the form below.
          </p>
        </div>

        <!-- Google Form Embed -->
        <div
          class="bg-white rounded-3xl p-4 md:p-8 shadow-xl shadow-black/[0.03] border border-black/5 mb-16 relative overflow-hidden flex flex-col items-center"
        >
          <div class="w-full max-w-md mx-auto">
            <form id="attendance-form" class="space-y-6">
              <div>
                <label for="studentName" class="block text-sm font-semibold text-[#1a1a2e] mb-2 font-plus-jakarta">Student Name</label>
                <input 
                  type="text" 
                  id="studentName" 
                  name="studentName" 
                  placeholder="Enter your full name" 
                  required
                  class="w-full px-5 py-4 rounded-xl border border-black/10 bg-black/[0.02] text-[#1a1a2e] focus:outline-none focus:ring-2 focus:ring-[#1a1a2e]/20 transition-all font-outfit"
                />
              </div>

              <button 
                type="submit" 
                id="submit-btn"
                class="w-full py-4 rounded-xl bg-[#1a1a2e] text-white font-bold font-outfit tracking-wide hover:bg-black transition-all hover:shadow-lg active:scale-[0.98] flex justify-center items-center gap-2"
              >
                <span>Mark Present</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </button>
              
              <div id="form-status" class="hidden p-4 rounded-xl text-center text-sm font-medium font-outfit"></div>
            </form>
          </div>

          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const form = document.getElementById('attendance-form');
              const submitBtn = document.getElementById('submit-btn');
              const statusDiv = document.getElementById('form-status');

              form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const studentName = document.getElementById('studentName').value;
                const timestamp = new Date().toLocaleString();
                
                // --- SETUP INSTRUCTIONS ---
                // Replace this URL with the Google Apps Script Web App URL
                const GOOGLE_SCRIPT_URL = "YOUR_GOOGLE_SCRIPT_WEB_APP_URL_HERE"; 
                
                // UI Loading State
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="opacity-70">Submitting...</span>';
                
                if (GOOGLE_SCRIPT_URL === "YOUR_GOOGLE_SCRIPT_WEB_APP_URL_HERE") {
                   statusDiv.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                   statusDiv.classList.add('bg-amber-100', 'text-amber-800');
                   statusDiv.innerHTML = "System Error: You must paste your Google Script URL into the code first!";
                   submitBtn.disabled = false;
                   submitBtn.innerHTML = '<span>Mark Present</span>';
                   return;
                }

                try {
                  // Send data to Google Script
                  const response = await fetch(GOOGLE_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                      name: studentName,
                      time: timestamp,
                      status: "Present"
                    })
                  });

                  // Success State
                  statusDiv.classList.remove('hidden', 'bg-amber-100', 'text-amber-800', 'bg-red-100', 'text-red-800');
                  statusDiv.classList.add('bg-green-100', 'text-green-800');
                  statusDiv.innerHTML = `✅ <b>${studentName}</b> marked as Present!`;
                  form.reset();
                  
                } catch (error) {
                  // Error State
                  statusDiv.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                  statusDiv.classList.add('bg-red-100', 'text-red-800');
                  statusDiv.innerHTML = "❌ Failed to submit attendance. Please try again.";
                } finally {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = '<span>Mark Present</span>';
                }
              });
            });
          </script>
        </div>

        <!-- Admin PDF Export Section -->
        <div
          class="bg-[#f0f0ed] rounded-3xl p-8 md:p-10 border border-black/5 text-center"
        >
          <h3 class="text-2xl font-bold font-plus-jakarta mb-3">
            Admin Action: Export Report
          </h3>
          <p class="text-black/60 mb-8 max-w-md mx-auto">
            Click the button below to instantly generate and download a PDF
            report of all student attendance records from your Google Sheet.
          </p>

          <a
            href="https://docs.google.com/spreadsheets/d/105YO4ESUzyYSQMXxbmhFLpHMzETXIyouFQQIsocmDNM/export?format=pdf&portrait=false&size=A4&scale=4"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-[#1a1a2e] text-white font-medium hover:bg-black transition-colors duration-300 shadow-md hover:shadow-xl hover:-translate-y-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            Download Attendance (PDF)
          </a>

          <div
            class="mt-6 flex items-center justify-center gap-2 text-sm text-black/50 bg-black/5 py-2 px-4 rounded-full inline-flex"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span
              >You must be logged into your admin Google Account to download.</span
            >
          </div>
        </div>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
