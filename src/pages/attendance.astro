---
export const prerender = true;

import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Daily Student Attendance | Bhavya Career Institute"
      description="Mark your daily attendance for Bhavya Career Institute."
      canonical="https://www.bhavyacomputerclasses.com/attendance"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body
    class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20 flex flex-col min-h-screen"
  >
    <Navbar />

    <main class="w-full flex-grow pt-20">
      <!-- Standard Hero Banner -->
      <section class="relative py-16 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <nav class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[1.5px] text-white/70 bg-white/[0.07] border border-white/15 px-5 py-2 rounded-full mb-5" aria-label="Breadcrumb">
            <a href="/" class="text-[#F4B51B] hover:text-white transition-colors">Home</a>
            <span class="text-white/40">›</span>
            <span>Attendance</span>
          </nav>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-3 text-white font-['Poppins']">
            Daily Student Attendance
            <span class="block text-xl sm:text-2xl font-semibold text-[#FBD47A] mt-2 font-['Noto_Sans_Devanagari']">
              दैनिक छात्र उपस्थिति पोर्टल
            </span>
          </h1>
          <p class="text-white/85 text-base max-w-xl mx-auto font-['Noto_Sans_Devanagari'] leading-relaxed">
            कृपया अपनी दैनिक उपस्थिति दर्ज करने के लिए नीचे दिए गए फॉर्म में अपना पूरा नाम दर्ज करें।
          </p>
        </div>
      </section>

      <div class="max-w-xl mx-auto px-4 py-16">
        <!-- Attendance Form Card -->
        <div
          class="bg-white rounded-3xl p-6 sm:p-10 shadow-lg border border-[#082B63]/[0.08] relative overflow-hidden flex flex-col items-center"
        >
          <div class="w-full">
            <form id="attendance-form" class="space-y-6">
              <div>
                <label for="studentName" class="block text-sm font-semibold text-[#082B63] mb-2 font-['Poppins']">Student Name / छात्र का नाम</label>
                <input 
                  type="text" 
                  id="studentName" 
                  name="studentName" 
                  placeholder="Enter your full registered name" 
                  required
                  class="w-full px-5 py-3.5 rounded-xl border border-[#082B63]/15 bg-[#F8FAFD] text-[#172033] focus:outline-none focus:ring-2 focus:ring-[#0757A8]/30 focus:border-[#0757A8] transition-all font-['Inter']"
                />
              </div>

              <button 
                type="submit" 
                id="submit-btn"
                class="w-full py-4 rounded-xl bg-[#082B63] text-white font-bold font-['Poppins'] tracking-wide hover:bg-[#0757A8] transition-all hover:shadow-lg active:scale-[0.98] flex justify-center items-center gap-2 cursor-pointer"
              >
                <span>Mark Present • उपस्थिति दर्ज करें</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </button>
              
              <div id="form-status" class="hidden p-4 rounded-xl text-center text-sm font-medium font-['Inter']"></div>
            </form>
          </div>

          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const form = document.getElementById('attendance-form');
              const submitBtn = document.getElementById('submit-btn');
              const statusDiv = document.getElementById('form-status');

              form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const studentName = document.getElementById('studentName').value;
                const timestamp = new Date().toLocaleString();
                
                // --- SETUP INSTRUCTIONS ---
                // Replace this URL with the Google Apps Script Web App URL
                const GOOGLE_SCRIPT_URL = "YOUR_GOOGLE_SCRIPT_WEB_APP_URL_HERE"; 
                
                // UI Loading State
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="opacity-70">Submitting...</span>';
                
                if (GOOGLE_SCRIPT_URL === "YOUR_GOOGLE_SCRIPT_WEB_APP_URL_HERE") {
                   statusDiv.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                   statusDiv.classList.add('bg-amber-100', 'text-amber-800');
                   statusDiv.innerHTML = "System Error: You must paste your Google Script URL into the code first!";
                   submitBtn.disabled = false;
                   submitBtn.innerHTML = '<span>Mark Present</span>';
                   return;
                }

                try {
                  // Send data to Google Script
                  const response = await fetch(GOOGLE_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                      name: studentName,
                      time: timestamp,
                      status: "Present"
                    })
                  });

                  // Success State
                  statusDiv.classList.remove('hidden', 'bg-amber-100', 'text-amber-800', 'bg-red-100', 'text-red-800');
                  statusDiv.classList.add('bg-green-100', 'text-green-800');
                  statusDiv.innerHTML = `✅ <b>${studentName}</b> marked as Present!`;
                  form.reset();
                  
                } catch (error) {
                  // Error State
                  statusDiv.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                  statusDiv.classList.add('bg-red-100', 'text-red-800');
                  statusDiv.innerHTML = "❌ Failed to submit attendance. Please try again.";
                } finally {
                  submitBtn.disabled = false;
                  submitBtn.innerHTML = '<span>Mark Present</span>';
                }
              });
            });
          </script>
        </div>

        <!-- Admin PDF Export Section -->
        <div
          class="bg-[#f0f0ed] rounded-3xl p-8 md:p-10 border border-black/5 text-center"
        >
          <h3 class="text-2xl font-bold font-plus-jakarta mb-3">
            Admin Action: Export Report
          </h3>
          <p class="text-black/60 mb-8 max-w-md mx-auto">
            Click the button below to instantly generate and download a PDF
            report of all student attendance records from your Google Sheet.
          </p>

          <a
            href="https://docs.google.com/spreadsheets/d/105YO4ESUzyYSQMXxbmhFLpHMzETXIyouFQQIsocmDNM/export?format=pdf&portrait=false&size=A4&scale=4"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-[#1a1a2e] text-white font-medium hover:bg-black transition-colors duration-300 shadow-md hover:shadow-xl hover:-translate-y-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              ></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            Download Attendance (PDF)
          </a>

          <div
            class="mt-6 flex items-center justify-center gap-2 text-sm text-black/50 bg-black/5 py-2 px-4 rounded-full inline-flex"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span
              >You must be logged into your admin Google Account to download.</span
            >
          </div>
        </div>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
