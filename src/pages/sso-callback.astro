---
const NEON_AUTH_BASE_URL = import.meta.env.NEON_AUTH_BASE_URL || '';

// The callbackURL from signIn.social() — where to go after session is ready
const callbackURL = Astro.url.searchParams.get('callbackURL') || '/dashboard';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Signing you in…</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0c0f14;
      color: #e7edf3;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100dvh;
      gap: 16px;
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(79, 70, 229, 0.2);
      border-top-color: #4f46e5;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    p { font-size: 15px; color: rgba(255,255,255,0.5); }
  </style>
</head>
<body data-auth-url={NEON_AUTH_BASE_URL} data-callback-url={callbackURL}>
  <div class="spinner"></div>
  <p>Signing you in…</p>

  <script>
    import { createAuthClient } from '@neondatabase/neon-js/auth';

    (async () => {
      const authUrl = document.body.dataset.authUrl;
      const callbackUrl = document.body.dataset.callbackUrl || '/dashboard';

      if (!authUrl) {
        window.location.href = '/login?error=auth_not_configured';
        return;
      }

      const authClient = createAuthClient(authUrl);

      try {
        const { data, error } = await authClient.getSession();

        if (error || !data) {
          window.location.href = '/login?error=oauth_failed';
          return;
        }

        // Session established — go to dashboard (server will route by role)
        window.location.href = callbackUrl;
      } catch (err) {
        console.error('[SSO Callback] error:', err);
        window.location.href = '/login?error=oauth_failed';
      }
    })();
  </script>
</body>
</html>
