---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";

const NEON_AUTH_BASE_URL = import.meta.env.NEON_AUTH_BASE_URL || '';

// The login button points to our own server-side route that POSTs to
// Neon Auth's /sign-in/social endpoint and redirects to Google OAuth.
// (Better Auth social sign-in is POST-based, not a plain GET redirect.)
const googleAuthUrl = '/api/auth/google-signin';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Sign in — Bhavya Career Institute"
      description="Sign in to your student or teacher portal at Bhavya Career Institute."
      canonical="https://www.bhavyacomputerclasses.com/login"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />
  </head>

  <body>
    <main class="signin-page">
      <h1>Sign in to your portal</h1>
      
      <p class="subtitle">
        Select your role and sign in with Google.
      </p>

      <div class="role-group" role="group" aria-label="Select role">
        <button
          id="btn-student"
          class="role-tab role-tab--active"
          data-role="STUDENT"
          type="button"
          aria-pressed="true"
        >
          Student
        </button>
        <button
          id="btn-teacher"
          class="role-tab"
          data-role="TEACHER"
          type="button"
          aria-pressed="false"
        >
          Teacher
        </button>
      </div>

      <div class="signin-buttons">
        <a id="google-btn" href={googleAuthUrl} class="signin-button" aria-label="Sign in with Google">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <span class="oauth-label">Sign in with Google</span>
        </a>
      </div>
    </main>

    <style>
      :root {
        --bg: #0c0f14;
        --panel: #0f131b;
        --text: #e7edf3;
        --text-dim: #9aa6b2;
        --border: #141a24;
        --accent: #4f46e5;
        --shadow: 0 8px 24px rgba(0,0,0,0.32);
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
      }

      .signin-page {
        height: 100vh;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .signin-page h1 {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
        text-align: center;
      }

      .subtitle {
        font-size: 15px;
        color: var(--text-dim);
        margin-bottom: 32px;
        text-align: center;
      }

      /* Role selector styling to fit minimalist theme */
      .role-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 24px;
        width: 100%;
        max-width: 280px;
      }
      .role-tab {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        background: transparent;
        border: none;
        color: var(--text-dim);
        font-family: inherit;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }
      .role-tab:first-child { border-right: 1px solid var(--border); }
      .role-tab--active { background: #1a2231; color: var(--text); }
      .role-tab:hover:not(.role-tab--active) {
        background: rgba(255,255,255,0.02);
        color: var(--text);
      }

      .signin-buttons {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
        max-width: 280px;
      }

      .signin-button {
        width: 100%;
        padding: 12px 24px;
        background: var(--panel);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 12px;
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        transition: all 0.2s ease;
      }
      .signin-button:hover {
        background: #141a21;
        border-color: var(--accent);
        transform: translateY(-1px);
      }
      .signin-button svg {
        flex-shrink: 0;
        width: 20px;
        height: 20px;
      }
    </style>

    <script>
      (function () {
        /* Role toggle */
        const btnStudent = document.getElementById('btn-student');
        const btnTeacher = document.getElementById('btn-teacher');
        let selectedRole = 'STUDENT';

        function setRole(role) {
          selectedRole = role;
          btnStudent.classList.toggle('role-tab--active', role === 'STUDENT');
          btnStudent.setAttribute('aria-pressed', String(role === 'STUDENT'));
          btnTeacher.classList.toggle('role-tab--active', role === 'TEACHER');
          btnTeacher.setAttribute('aria-pressed', String(role === 'TEACHER'));
          document.cookie = `pending-role=${role}; path=/; max-age=600; SameSite=Lax`;
        }
        btnStudent.addEventListener('click', () => setRole('STUDENT'));
        btnTeacher.addEventListener('click', () => setRole('TEACHER'));
        setRole('STUDENT');

        /* Google button loading state */
        const googleBtn = document.getElementById('google-btn');
        googleBtn.addEventListener('click', function () {
          const label = this.querySelector('.oauth-label');
          if (label) label.textContent = 'Redirecting\u2026';
          this.style.opacity = '0.6';
          this.style.pointerEvents = 'none';
        });
      })();
    </script>
  </body>
</html>
