---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";
import Cursor from "../components/Cursor.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const projectId = import.meta.env.PUBLIC_STACK_PROJECT_ID || '';
// Redirect URL back to our application dashboard
const redirectUrl = `${import.meta.env.PUBLIC_API_URL || 'http://localhost:4321'}/dashboard`;
const stackAuthUrl = `https://app.stack-auth.com/sign-in?project_id=${projectId}&redirect_url=${encodeURIComponent(redirectUrl)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Login / Register — Bhavya Career Institute"
      description="Access your student or teacher portal at Bhavya Career Institute via Stack Auth."
      canonical="https://www.bhavyacomputerclasses.com/login"
    />
  </head>
  <body class="bg-[#000] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />

    <!-- Ambient noise overlay -->
    <div class="noise"></div>

    <!-- Grid background overlay -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute inset-0 bg-grid opacity-20"></div>
    </div>

    <main class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 pt-32 pb-12">

      <!-- Logo / Brand -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl mb-4 logo-pulse text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <p class="text-white/30 text-xs uppercase tracking-[0.3em]" style="font-family: 'Outfit', sans-serif;">Bhavya Career Institute</p>
        <h1 id="portal-heading" class="text-2xl font-bold mt-1 text-white" style="font-family: 'Syne', sans-serif; letter-spacing: -0.04em;">Student & Teacher Portal</h1>
      </div>

      <!-- Main Card -->
      <div class="login-card w-full max-w-md rounded-3xl p-8 relative overflow-hidden text-center">

        <!-- Card glow edge -->
        <div class="card-glow-edge"></div>

        <h2 class="text-xl font-semibold mb-3" style="font-family: 'Syne', sans-serif;">Welcome Back</h2>
        <p class="text-white/40 text-sm mb-8 px-4" style="font-family: 'Outfit', sans-serif;">
          Click the button below to sign in or register a new account using our secure Stack Auth portal.
        </p>

        <!-- Stack Auth Button -->
        <a href={stackAuthUrl} class="login-btn w-full inline-flex items-center justify-center gap-3 decoration-none">
          <span class="btn-text">Sign In / Register</span>
          <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>

        <!-- Footer divider -->
        <div class="passkey-divider my-6">
          <span class="passkey-divider-line"></span>
          <span class="passkey-divider-text">Secure Identity</span>
          <span class="passkey-divider-line"></span>
        </div>

        <p class="text-white/30 text-[11px] leading-relaxed" style="font-family: 'Outfit', sans-serif;">
          Stack Auth protects your credentials with industry-grade security, supporting passwordless passkeys, Google OAuth, and secure email verification.
        </p>

      </div>

      <!-- Footer note -->
      <p class="mt-8 text-white/20 text-xs text-center" style="font-family: 'Outfit', sans-serif;">
        Having trouble? Contact us at
        <a href="https://wa.me/919694932391" class="text-white/40 hover:text-white/70 transition-colors underline underline-offset-2">+91 96949 32391</a>
      </p>
    </main>

    <Footer />

    <style>
      /* ─── Logo pulse ────────────────────────────────────── */
      @keyframes logoPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.1); }
        50% { box-shadow: 0 0 0 12px rgba(255, 255, 255, 0); }
      }
      .logo-pulse { animation: logoPulse 3s ease-in-out infinite; }

      /* ─── Login card ────────────────────────────────────── */
      .login-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow:
          0 0 0 1px rgba(255,255,255,0.04) inset,
          0 32px 64px rgba(0,0,0,0.6),
          0 0 80px rgba(255, 255, 255, 0.02);
      }
      .card-glow-edge {
        position: absolute;
        top: 0; left: 50%;
        transform: translateX(-50%);
        width: 60%; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      }

      /* ─── Login button ──────────────────────────────────── */
      .login-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 15px 24px;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        color: #000;
        background: #fff;
        border: none;
        outline: none;
        transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
        position: relative;
        overflow: hidden;
        letter-spacing: 0.01em;
        cursor: pointer;
        text-decoration: none;
      }
      .login-btn:hover {
        transform: translateY(-2px);
        background: #f0f0f0;
        box-shadow: 0 12px 40px rgba(255,255,255,0.15), 0 4px 12px rgba(255,255,255,0.1);
      }
      .login-btn:active { transform: translateY(0); }

      /* ─── Passkey divider ────────────────────────────────── */
      .passkey-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 24px 0;
      }
      .passkey-divider-line {
        flex: 1;
        height: 1px;
        background: rgba(255,255,255,0.07);
      }
      .passkey-divider-text {
        font-family: 'Outfit', sans-serif;
        font-size: 11px;
        color: rgba(255,255,255,0.25);
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
    </style>
  </body>
</html>
