---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";
import Cursor from "../components/Cursor.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Login / Register — Bhavya Career Institute"
      description="Login or register at Bhavya Career Institute portal. Students and teachers get a unique UUID on first registration."
      canonical="https://bhavyacareerinstitute.com/login"
    />
  </head>
  <body class="bg-[#000] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />

    <!-- Ambient noise overlay -->
    <div class="noise"></div>

    <!-- Grid background overlay -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute inset-0 bg-grid opacity-20"></div>
    </div>

    <main class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 pt-32 pb-12">

      <!-- Logo / Brand -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl mb-4 logo-pulse text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <p class="text-white/30 text-xs uppercase tracking-[0.3em]" style="font-family: 'Outfit', sans-serif;">Bhavya Career Institute</p>
        <h1 id="portal-heading" class="text-2xl font-bold mt-1 text-white" style="font-family: 'Syne', sans-serif; letter-spacing: -0.04em;">Student Portal</h1>
      </div>

      <!-- Main Card -->
      <div class="login-card w-full max-w-md rounded-3xl p-8 relative overflow-hidden">

        <!-- Card glow edge -->
        <div class="card-glow-edge"></div>

        <!-- Mode Switcher: Login / Register -->
        <div class="mode-tabs mb-6">
          <button type="button" class="mode-tab active" id="tab-login" data-mode="login">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Sign In
          </button>
          <button type="button" class="mode-tab" id="tab-register" data-mode="register">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            Register
          </button>
        </div>

        <!-- Role Selector -->
        <div class="mb-6">
          <p class="text-white/40 text-xs uppercase tracking-widest mb-3" style="font-family: 'Outfit', sans-serif;">I am a</p>
          <div class="role-tabs grid grid-cols-2 gap-2 p-1.5 rounded-xl bg-white/5 border border-white/8">
            <button type="button" class="role-tab active" data-role="student" id="role-student">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              Student
            </button>
            <button type="button" class="role-tab" data-role="teacher" id="role-teacher">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Teacher
            </button>
          </div>
        </div>

        <!-- ─── LOGIN FORM ─── -->
        <form id="login-form" novalidate class="space-y-4">

          <!-- Email -->
          <div class="form-group">
            <label for="login-email" class="form-label">Email Address</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <input type="email" id="login-email" name="email" class="form-input" placeholder="you@example.com" autocomplete="email" spellcheck="false" required />
            </div>
            <span class="form-error" id="login-email-error">Please enter a valid email</span>
          </div>

          <!-- Password -->
          <div class="form-group">
            <div class="flex justify-between items-center mb-2">
              <label for="login-password" class="form-label mb-0">Password</label>
              <a href="#" class="text-white/50 hover:text-white text-xs transition-colors" style="font-family: 'Outfit', sans-serif;">Forgot password?</a>
            </div>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="login-password" name="password" class="form-input" placeholder="Enter your password…" autocomplete="current-password" required />
              <button type="button" id="login-toggle-pwd" class="eye-toggle" aria-label="Toggle password visibility">
                <svg id="login-eye-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <span class="form-error" id="login-password-error">Please enter your password</span>
          </div>

          <!-- Error banner -->
          <div id="login-error" class="login-error-banner hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="login-error-text">Invalid credentials. Please try again.</span>
          </div>

          <!-- Submit -->
          <button type="submit" id="login-btn" class="login-btn w-full mt-2">
            <span class="btn-text">Sign In</span>
            <span class="btn-loader hidden">
              <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </span>
            <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>

          <p class="text-center text-white/30 text-xs mt-3" style="font-family: 'Outfit', sans-serif;">
            New here? <button type="button" id="switch-to-register" class="text-white/70 hover:text-white transition-colors underline underline-offset-2">Create an account</button>
          </p>

        </form>

        <!-- ─── REGISTER FORM ─── -->
        <form id="register-form" novalidate class="space-y-4 hidden">

          <!-- Full Name -->
          <div class="form-group">
            <label for="reg-name" class="form-label">Full Name</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input type="text" id="reg-name" name="name" class="form-input" placeholder="Your full name…" autocomplete="name" required />
            </div>
            <span class="form-error" id="reg-name-error">Please enter your full name</span>
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="reg-email" class="form-label">Email Address</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <input type="email" id="reg-email" name="email" class="form-input" placeholder="you@example.com" autocomplete="email" spellcheck="false" required />
            </div>
            <span class="form-error" id="reg-email-error">Please enter a valid email</span>
          </div>

          <!-- Mobile -->
          <div class="form-group">
            <label for="reg-mobile" class="form-label">Mobile Number</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              </span>
              <span class="mobile-prefix">+91</span>
              <input type="tel" id="reg-mobile" name="mobile" class="form-input form-input-mobile" placeholder="9876543210…" autocomplete="tel" maxlength="10" required />
            </div>
            <span class="form-error" id="reg-mobile-error">Please enter a valid 10-digit mobile number</span>
          </div>

          <!-- Password -->
          <div class="form-group">
            <label for="reg-password" class="form-label">Create Password</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="reg-password" name="password" class="form-input" placeholder="Min. 8 characters…" autocomplete="new-password" required />
              <button type="button" id="reg-toggle-pwd" class="eye-toggle" aria-label="Toggle password visibility">
                <svg id="reg-eye-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <span class="form-error" id="reg-password-error">Password must be at least 8 characters</span>
            <!-- Strength meter -->
            <div class="strength-meter mt-2">
              <div class="strength-bars">
                <div class="s-bar" id="s1"></div>
                <div class="s-bar" id="s2"></div>
                <div class="s-bar" id="s3"></div>
                <div class="s-bar" id="s4"></div>
              </div>
              <span class="strength-label" id="strength-label">Too short</span>
            </div>
          </div>

          <!-- Confirm Password -->
          <div class="form-group">
            <label for="reg-confirm" class="form-label">Confirm Password</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <input type="password" id="reg-confirm" name="confirm" class="form-input" placeholder="Re-enter your password…" autocomplete="new-password" required />
            </div>
            <span class="form-error" id="reg-confirm-error">Passwords do not match</span>
          </div>

          <!-- Error banner -->
          <div id="reg-error" class="login-error-banner hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="reg-error-text">This email is already registered.</span>
          </div>

          <!-- Submit -->
          <button type="submit" id="reg-btn" class="login-btn w-full mt-2">
            <span class="btn-text">Create Account</span>
            <span class="btn-loader hidden">
              <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </span>
            <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>

          <p class="text-center text-white/30 text-xs mt-3" style="font-family: 'Outfit', sans-serif;">
            Already have an account? <button type="button" id="switch-to-login" class="text-white/70 hover:text-white transition-colors underline underline-offset-2">Sign in</button>
          </p>

        </form>

        <!-- ─── UUID SUCCESS CARD ─── -->
        <div id="uuid-success" class="hidden text-center py-4">
          <div class="success-icon-wrap mx-auto mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-1" style="font-family: 'Syne', sans-serif;">Account Created!</h2>
          <p class="text-white/40 text-sm mb-6" style="font-family: 'Outfit', sans-serif;">Save your unique ID — you'll need it to access your portal.</p>

          <div class="uuid-display-card">
            <p class="text-white/30 text-xs uppercase tracking-widest mb-2" style="font-family: 'Outfit', sans-serif;">Your Unique Portal ID</p>
            <div class="uuid-box">
              <code id="uuid-value" class="uuid-code">—</code>
              <button type="button" id="copy-uuid" class="copy-btn" title="Copy ID">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
            <p class="text-white/25 text-xs mt-3" style="font-family: 'Outfit', sans-serif;">📌 Screenshot or copy this ID for your records</p>
          </div>

          <div class="mt-6 p-4 rounded-xl bg-white/3 border border-white/6 text-left">
            <p class="text-white/30 text-xs uppercase tracking-widest mb-2" style="font-family: 'Outfit', sans-serif;">Account Summary</p>
            <div class="space-y-1.5">
              <div class="flex justify-between">
                <span class="text-white/40 text-xs" style="font-family: 'Outfit', sans-serif;">Name</span>
                <span class="text-white/70 text-xs font-semibold" style="font-family: 'Outfit', sans-serif;" id="summary-name">—</span>
              </div>
              <div class="flex justify-between">
                <span class="text-white/40 text-xs" style="font-family: 'Outfit', sans-serif;">Email</span>
                <span class="text-white/70 text-xs" style="font-family: 'Outfit', sans-serif;" id="summary-email">—</span>
              </div>
              <div class="flex justify-between">
                <span class="text-white/40 text-xs" style="font-family: 'Outfit', sans-serif;">Mobile</span>
                <span class="text-white/70 text-xs" style="font-family: 'Outfit', sans-serif;" id="summary-mobile">—</span>
              </div>
              <div class="flex justify-between">
                <span class="text-white/40 text-xs" style="font-family: 'Outfit', sans-serif;">Role</span>
                <span class="text-white text-xs font-semibold uppercase tracking-wide" style="font-family: 'Outfit', sans-serif;" id="summary-role">—</span>
              </div>
            </div>
          </div>

          <button id="go-dashboard-btn" class="login-btn w-full mt-6">
            Go to Dashboard
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </div>

      </div>

      <!-- Footer note -->
      <p class="mt-8 text-white/20 text-xs text-center" style="font-family: 'Outfit', sans-serif;">
        Having trouble? Contact us at
        <a href="https://wa.me/919694932391" class="text-white/40 hover:text-white/70 transition-colors underline underline-offset-2">+91 96949 32391</a>
      </p>
    </main>

    <Footer />

    <style>
      /* Blobs removed for dashboard aesthetic */

      /* ─── Logo pulse ────────────────────────────────────── */
      @keyframes logoPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.1); }
        50% { box-shadow: 0 0 0 12px rgba(255, 255, 255, 0); }
      }
      .logo-pulse { animation: logoPulse 3s ease-in-out infinite; }

      /* ─── Login card ────────────────────────────────────── */
      .login-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow:
          0 0 0 1px rgba(255,255,255,0.04) inset,
          0 32px 64px rgba(0,0,0,0.6),
          0 0 80px rgba(255, 255, 255, 0.02);
      }
      .card-glow-edge {
        position: absolute;
        top: 0; left: 50%;
        transform: translateX(-50%);
        width: 60%; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      }

      /* ─── Mode tabs ──────────────────────────────────────── */
      .mode-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        padding: 5px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
      }
      .mode-tab {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px;
        border-radius: 10px;
        font-size: 13px;
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        color: rgba(255,255,255,0.35);
        background: transparent;
        border: none;
        cursor: pointer;
        transition: color 0.25s, background-color 0.25s, border-color 0.25s cubic-bezier(0.16,1,0.3,1);
      }
      .mode-tab:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      .mode-tab:hover { color: rgba(255,255,255,0.9); }
      .mode-tab.active {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fff;
      }

      /* ─── Role tabs ─────────────────────────────────────── */
      .role-tab {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 9px 4px;
        border-radius: 9px;
        font-size: 12.5px;
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
        color: rgba(255,255,255,0.4);
        transition: color 0.25s, background-color 0.25s, border-color 0.25s cubic-bezier(0.16,1,0.3,1);
        background: transparent;
        border: none;
        outline: none;
        cursor: pointer;
      }
      .role-tab:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      .role-tab:hover { color: rgba(255,255,255,0.9); background: rgba(255,255,255,0.06); }
      .role-tab.active {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fff;
      }
      .role-tab[data-role="teacher"].active {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fff;
      }

      /* ─── Form label ────────────────────────────────────── */
      .form-label {
        display: block;
        font-size: 11.5px;
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
        color: rgba(255,255,255,0.45);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
      }

      /* ─── Input wrapper ─────────────────────────────────── */
      .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
      }
      .input-icon {
        position: absolute;
        left: 14px;
        color: rgba(255,255,255,0.25);
        display: flex;
        align-items: center;
        pointer-events: none;
        transition: color 0.2s;
        z-index: 1;
      }
      .mobile-prefix {
        position: absolute;
        left: 42px;
        font-family: 'Outfit', sans-serif;
        font-size: 13.5px;
        color: rgba(255,255,255,0.45);
        pointer-events: none;
        z-index: 1;
      }
      .form-input {
        width: 100%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 12px;
        padding: 13px 48px 13px 42px;
        font-size: 14px;
        font-family: 'Outfit', sans-serif;
        color: rgba(255,255,255,0.85);
        outline: none;
        transition: border-color 0.25s, background-color 0.25s, box-shadow 0.25s cubic-bezier(0.16,1,0.3,1);
      }
      .form-input-mobile {
        padding-left: 72px;
      }
      .form-input::placeholder { color: rgba(255,255,255,0.2); font-size: 13.5px; }
      .form-input:focus-visible {
        background: rgba(255,255,255,0.06);
        border-color: rgba(255,255,255,0.3);
        box-shadow: 0 0 0 3px rgba(255,255,255,0.05), 0 0 20px rgba(255,255,255,0.02);
      }
      .input-wrapper:focus-within .input-icon { color: rgba(255,255,255,0.8); }
      .form-input.error {
        border-color: rgba(239,68,68,0.5);
        background: rgba(239,68,68,0.04);
      }

      /* ─── Eye toggle ────────────────────────────────────── */
      .eye-toggle {
        position: absolute;
        right: 14px;
        background: none;
        border: none;
        outline: none;
        color: rgba(255,255,255,0.25);
        display: flex;
        align-items: center;
        transition: color 0.2s;
        padding: 0;
        cursor: pointer;
      }
      .eye-toggle:hover { color: rgba(255,255,255,0.6); }

      /* ─── Form error ────────────────────────────────────── */
      .form-error {
        display: none;
        font-size: 11px;
        font-family: 'Outfit', sans-serif;
        color: rgba(239,68,68,0.8);
        margin-top: 5px;
        padding-left: 2px;
      }
      .form-group.has-error .form-error { display: block; }

      /* ─── Password strength ──────────────────────────────── */
      .strength-meter {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .strength-bars {
        display: flex;
        gap: 4px;
        flex: 1;
      }
      .s-bar {
        height: 3px;
        border-radius: 2px;
        flex: 1;
        background: rgba(255,255,255,0.1);
        transition: background 0.3s;
      }
      .s-bar.weak   { background: #ef4444; }
      .s-bar.fair   { background: #f59e0b; }
      .s-bar.good   { background: #10b981; }
      .s-bar.strong { background: #06b6d4; }
      .strength-label {
        font-family: 'Outfit', sans-serif;
        font-size: 10.5px;
        color: rgba(255,255,255,0.3);
        min-width: 52px;
        text-align: right;
      }

      /* ─── Error banner ──────────────────────────────────── */
      .login-error-banner {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 10px;
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.2);
        color: rgba(239,68,68,0.85);
        font-size: 13px;
        font-family: 'Outfit', sans-serif;
        animation: slideDown 0.3s ease;
      }
      .login-error-banner.hidden { display: none; }
      @keyframes slideDown {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* ─── Login button ──────────────────────────────────── */
      .login-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 15px 24px;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Outfit', sans-serif;
        color: #000;
        background: #fff;
        border: none;
        outline: none;
        transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
        position: relative;
        overflow: hidden;
        letter-spacing: 0.01em;
        cursor: pointer;
      }
      .login-btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      .login-btn::before {
        display: none;
      }
      .login-btn:hover {
        transform: translateY(-2px);
        background: #f0f0f0;
        box-shadow: 0 12px 40px rgba(255,255,255,0.15), 0 4px 12px rgba(255,255,255,0.1);
      }
      .login-btn:active { transform: translateY(0); }
      .login-btn .btn-text,
      .login-btn .btn-loader,
      .login-btn .btn-arrow { position: relative; z-index: 1; }
      .login-btn.loading .btn-text { opacity: 0.7; }
      .login-btn.loading .btn-arrow { display: none; }
      .login-btn.loading .btn-loader { display: flex !important; }

      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .animate-spin { animation: spin 0.8s linear infinite; }

      /* ─── UUID Success ───────────────────────────────────── */
      .success-icon-wrap {
        width: 64px; height: 64px;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(6,182,212,0.15));
        border: 1px solid rgba(16,185,129,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #10b981;
        animation: successPop 0.5s cubic-bezier(0.16,1,0.3,1);
      }
      @keyframes successPop {
        from { transform: scale(0.6); opacity: 0; }
        to   { transform: scale(1);   opacity: 1; }
      }
      .uuid-display-card {
        background: rgba(167,139,250,0.06);
        border: 1px solid rgba(167,139,250,0.2);
        border-radius: 16px;
        padding: 18px;
      }
      .uuid-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 12px 14px;
        margin-top: 8px;
      }
      .uuid-code {
        font-family: 'Courier New', monospace;
        font-size: 12.5px;
        color: #c4b5fd;
        letter-spacing: 0.05em;
        flex: 1;
        text-align: left;
        word-break: break-all;
      }
      .copy-btn {
        background: rgba(167,139,250,0.1);
        border: 1px solid rgba(167,139,250,0.2);
        border-radius: 7px;
        padding: 6px 8px;
        color: rgba(167,139,250,0.7);
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
        display: flex;
        align-items: center;
        flex-shrink: 0;
      }
      .copy-btn:hover {
        background: rgba(167,139,250,0.2);
        color: #c4b5fd;
      }
    </style>

    <script>
      // ─── Storage key ─────────────────────────────────────────────────────────
      const STORAGE_KEY = 'bci_users';

      type UserRecord = {
        uuid: string;
        name: string;
        email: string;
        mobile: string;
        password: string;
        role: string;
        createdAt: string;
      };

      function getUsers(): Record<string, UserRecord> {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        } catch { return {}; }
      }
      function saveUsers(users: Record<string, UserRecord>) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(users));
      }
      function generateUUID(): string {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
          const r = Math.random() * 16 | 0;
          return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
      }

      // ─── Role selection ───────────────────────────────────────────────────────
      let currentRole = 'student';
      const roleTabs = document.querySelectorAll<HTMLButtonElement>('.role-tab');
      const portalHeading = document.getElementById('portal-heading');

      roleTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          roleTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentRole = tab.dataset.role || 'student';
          if (portalHeading) {
            portalHeading.textContent = currentRole === 'teacher' ? 'Teacher Portal' : 'Student Portal';
          }
        });
      });

      // ─── Mode switching ───────────────────────────────────────────────────────
      let currentMode = 'login';
      const loginForm = document.getElementById('login-form') as HTMLFormElement;
      const registerForm = document.getElementById('register-form') as HTMLFormElement;
      const uuidSuccess = document.getElementById('uuid-success');
      const tabLogin = document.getElementById('tab-login') as HTMLButtonElement;
      const tabRegister = document.getElementById('tab-register') as HTMLButtonElement;

      function showMode(mode: string) {
        currentMode = mode;
        loginForm.classList.toggle('hidden', mode !== 'login');
        registerForm.classList.toggle('hidden', mode !== 'register');
        uuidSuccess?.classList.add('hidden');
        tabLogin.classList.toggle('active', mode === 'login');
        tabRegister.classList.toggle('active', mode === 'register');
        clearErrors();
      }

      tabLogin.addEventListener('click', () => showMode('login'));
      tabRegister.addEventListener('click', () => showMode('register'));
      document.getElementById('switch-to-register')?.addEventListener('click', () => showMode('register'));
      document.getElementById('switch-to-login')?.addEventListener('click', () => showMode('login'));

      // ─── Password toggles ─────────────────────────────────────────────────────
      function setupToggle(btnId: string, inputId: string, iconId: string) {
        const btn = document.getElementById(btnId);
        const input = document.getElementById(inputId) as HTMLInputElement;
        const icon = document.getElementById(iconId);
        btn?.addEventListener('click', () => {
          const hidden = input.type === 'password';
          input.type = hidden ? 'text' : 'password';
          if (icon) {
            icon.innerHTML = hidden
              ? `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>`
              : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`;
          }
        });
      }
      setupToggle('login-toggle-pwd', 'login-password', 'login-eye-icon');
      setupToggle('reg-toggle-pwd', 'reg-password', 'reg-eye-icon');

      // ─── Password strength meter ──────────────────────────────────────────────
      const regPwdInput = document.getElementById('reg-password') as HTMLInputElement;
      const strengthLabel = document.getElementById('strength-label');
      const bars = [
        document.getElementById('s1'),
        document.getElementById('s2'),
        document.getElementById('s3'),
        document.getElementById('s4'),
      ];
      const strengthLevels = [
        { label: 'Too short', color: '' },
        { label: 'Weak',      color: 'weak' },
        { label: 'Fair',      color: 'fair' },
        { label: 'Good',      color: 'good' },
        { label: 'Strong',    color: 'strong' },
      ];

      function calcStrength(pw: string): number {
        if (pw.length < 8) return 0;
        let score = 1;
        if (/[A-Z]/.test(pw)) score++;
        if (/[0-9]/.test(pw)) score++;
        if (/[^a-zA-Z0-9]/.test(pw)) score++;
        return score;
      }

      regPwdInput?.addEventListener('input', () => {
        const score = calcStrength(regPwdInput.value);
        const lvl = strengthLevels[score];
        bars.forEach((bar, i) => {
          if (!bar) return;
          bar.className = 's-bar';
          if (score > 0 && i < score) bar.classList.add(lvl.color);
        });
        if (strengthLabel) strengthLabel.textContent = lvl.label;
      });

      // ─── Helpers ─────────────────────────────────────────────────────────────
      function setError(inputId: string, show: boolean) {
        const input = document.getElementById(inputId) as HTMLInputElement;
        const group = input?.closest('.form-group');
        if (show) {
          input?.classList.add('error');
          group?.classList.add('has-error');
        } else {
          input?.classList.remove('error');
          group?.classList.remove('has-error');
        }
      }
      function clearErrors() {
        document.querySelectorAll('.form-input').forEach(i => i.classList.remove('error'));
        document.querySelectorAll('.form-group').forEach(g => g.classList.remove('has-error'));
        document.getElementById('login-error')?.classList.add('hidden');
        document.getElementById('reg-error')?.classList.add('hidden');
      }

      // ─── LOGIN form ───────────────────────────────────────────────────────────
      const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearErrors();

        const email = (document.getElementById('login-email') as HTMLInputElement).value.trim().toLowerCase();
        const password = (document.getElementById('login-password') as HTMLInputElement).value;

        let hasErr = false;
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('login-email', true); hasErr = true; }
        if (!password) { setError('login-password', true); hasErr = true; }
        if (hasErr) return;

        loginBtn.classList.add('loading');
        (loginBtn.querySelector('.btn-loader') as HTMLElement).classList.remove('hidden');

        await new Promise(r => setTimeout(r, 900));

        const formData = new FormData();
        formData.append('email', email);
        formData.append('password', password);

        try {
          const res = await fetch('/api/login', {
            method: 'POST',
            body: formData
          });

          const data = await res.json();

          if (!res.ok) {
            loginBtn.classList.remove('loading');
            (loginBtn.querySelector('.btn-loader') as HTMLElement).classList.add('hidden');
            const errBanner = document.getElementById('login-error');
            const errText = document.getElementById('login-error-text');
            if (errBanner && errText) {
              errBanner.classList.remove('hidden');
              errText.textContent = data.error || 'Invalid credentials. Please try again.';
            }
            // Shake
            ['login-email', 'login-password'].forEach(id => {
              const el = document.getElementById(id);
              el?.animate([
                { transform: 'translateX(-6px)' },
                { transform: 'translateX(6px)' },
                { transform: 'translateX(-4px)' },
                { transform: 'translateX(4px)' },
                { transform: 'translateX(0)' },
              ], { duration: 400, easing: 'ease-in-out' });
            });
            return;
          }

          // Success: server set the cookie
          window.location.href = data.url;
        } catch (err) {
          loginBtn.classList.remove('loading');
          (loginBtn.querySelector('.btn-loader') as HTMLElement).classList.add('hidden');
          console.error(err);
        }
      });

      // ─── REGISTER form ────────────────────────────────────────────────────────
      const regBtn = document.getElementById('reg-btn') as HTMLButtonElement;
      registerForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearErrors();

        const name     = (document.getElementById('reg-name') as HTMLInputElement).value.trim();
        const email    = (document.getElementById('reg-email') as HTMLInputElement).value.trim().toLowerCase();
        const mobile   = (document.getElementById('reg-mobile') as HTMLInputElement).value.trim();
        const password = (document.getElementById('reg-password') as HTMLInputElement).value;
        const confirm  = (document.getElementById('reg-confirm') as HTMLInputElement).value;

        let hasErr = false;
        if (!name) { setError('reg-name', true); hasErr = true; }
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('reg-email', true); hasErr = true; }
        if (!/^\d{10}$/.test(mobile)) { setError('reg-mobile', true); hasErr = true; }
        if (password.length < 8) { setError('reg-password', true); hasErr = true; }
        if (password !== confirm) { setError('reg-confirm', true); hasErr = true; }
        if (hasErr) return;

        regBtn.classList.add('loading');
        (regBtn.querySelector('.btn-loader') as HTMLElement).classList.remove('hidden');

        await new Promise(r => setTimeout(r, 1000));

        const formData = new FormData();
        formData.append('name', name);
        formData.append('email', email);
        formData.append('password', password);
        formData.append('role', currentRole.toUpperCase());

        try {
          const res = await fetch('/api/register', {
            method: 'POST',
            body: formData
          });

          const data = await res.json();

          if (!res.ok) {
            regBtn.classList.remove('loading');
            (regBtn.querySelector('.btn-loader') as HTMLElement).classList.add('hidden');
            const errBanner = document.getElementById('reg-error');
            const errText = document.getElementById('reg-error-text');
            if (errBanner && errText) {
              errBanner.classList.remove('hidden');
              errText.textContent = data.error || 'Registration failed.';
            }
            setError('reg-email', true);
            return;
          }

          // Generate UUID (we use the database ID now)
          const uuid = data.uuid;

          // Show success screen
          registerForm.classList.add('hidden');
          uuidSuccess?.classList.remove('hidden');
          const uuidEl = document.getElementById('uuid-value');
          if (uuidEl) uuidEl.textContent = uuid;
          const summaryName = document.getElementById('summary-name');
          const summaryEmail = document.getElementById('summary-email');
          const summaryMobile = document.getElementById('summary-mobile');
          const summaryRole = document.getElementById('summary-role');
          if (summaryName) summaryName.textContent = name;
          if (summaryEmail) summaryEmail.textContent = email;
          if (summaryMobile) summaryMobile.textContent = `+91 ${mobile}`;
          if (summaryRole) summaryRole.textContent = currentRole.charAt(0).toUpperCase() + currentRole.slice(1);

          // Hide mode tabs
          tabLogin.parentElement?.classList.add('hidden');
          document.querySelector('.mb-6.role-tabs')?.classList.add('hidden');

          regBtn.classList.remove('loading');
          (regBtn.querySelector('.btn-loader') as HTMLElement).classList.add('hidden');
        } catch (err) {
          regBtn.classList.remove('loading');
          (regBtn.querySelector('.btn-loader') as HTMLElement).classList.add('hidden');
          console.error(err);
        }
      });

      // ─── Copy UUID ────────────────────────────────────────────────────────────
      document.getElementById('copy-uuid')?.addEventListener('click', () => {
        const code = document.getElementById('uuid-value')?.textContent || '';
        navigator.clipboard.writeText(code).then(() => {
          const btn = document.getElementById('copy-uuid') as HTMLButtonElement;
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
          btn.style.color = '#10b981';
          setTimeout(() => {
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
            btn.style.color = '';
          }, 2000);
        });
      });

      // ─── Go to dashboard button ───────────────────────────────────────────────
      document.getElementById('go-dashboard-btn')?.addEventListener('click', () => {
        window.location.href = '/dashboard';
      });

      // ─── Clear error on input ─────────────────────────────────────────────────
      document.querySelectorAll('.form-input').forEach(input => {
        input.addEventListener('input', () => {
          input.classList.remove('error');
          input.closest('.form-group')?.classList.remove('has-error');
          document.getElementById('login-error')?.classList.add('hidden');
          document.getElementById('reg-error')?.classList.add('hidden');
        });
      });
    </script>
  </body>
</html>
