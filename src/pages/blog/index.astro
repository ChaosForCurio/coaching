---
export const prerender = true;
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import SEOHead from '../../components/SEOHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// High-quality curated tech & education images
const curatedImages = [
  'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&q=80&w=1200', // Collaborative study / tech discussion
  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=800',  // Team working with computers
  'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=800',  // Coding workspace
  'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&q=80&w=800',  // Classroom presentation & mentorship
  'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&q=80&w=800',  // Student working on laptop
  'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=800',  // Digital learning / tablet screen
  'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&q=80&w=800',  // Clean tech workstation
  'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&q=80&w=800',  // Code on screen
  'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&q=80&w=800',  // College students learning together
  'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=800',  // Business team strategy session
];

const getImage = (post: any, idx: number) => {
  if (post.data.image) return post.data.image;
  return curatedImages[idx % curatedImages.length];
};

const getPostCategory = (post: any) => {
  if (post.data.category) return post.data.category;
  if (post.data.tags && post.data.tags.length > 0) {
    return post.data.tags[0].replace(/-/g, ' ').toUpperCase();
  }
  return 'TECH & CAREER';
};

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
};

// Hero section posts
const heroMainPost = sortedPosts[0];
const heroSecondary1 = sortedPosts[1];
const heroSecondary2 = sortedPosts[2];

// Featured Category row (e.g., 4-card horizontal showcase)
const featuredPosts = sortedPosts.slice(3, 7);

// Remaining archive posts
const remainingPosts = sortedPosts.slice(7);

// Distinct categories for horizontal filter bar
const availableCategories = [
  'All',
  ...Array.from(
    new Set(
      sortedPosts
        .map((p) => p.data.category || (p.data.tags && p.data.tags[0]) || 'General')
        .map((c) => c.trim())
    )
  ),
].slice(0, 9);

const blogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': 'https://www.bhavyacomputerclasses.com/blog',
      name: 'Bhavya Computer Classes Blogs',
      url: 'https://www.bhavyacomputerclasses.com/blog',
      description:
        'Insights, career roadmaps, computer certification guides, and technology tips from Bhavya Computer Classes in Kota.',
      publisher: {
        '@type': 'Organization',
        name: 'Bhavya Computer Classes',
        url: 'https://www.bhavyacomputerclasses.com',
      },
      blogPost: sortedPosts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        datePublished: post.data.date.toISOString().split('T')[0],
        author: {
          '@type': 'Organization',
          name: post.data.author || 'Bhavya Computer Classes',
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.bhavyacomputerclasses.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: 'https://www.bhavyacomputerclasses.com/blog',
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Blogs | Bhavya Computer Classes — Computer Training & Career Guides"
      description="Career tips, course guides, and programming tutorials from Bhavya Computer Classes in Kota. Read about Python, Tally, Web Design, DCA, and digital skills."
      canonical="https://www.bhavyacomputerclasses.com/blog"
      schema={blogSchema}
    />
  </head>
  <body class="bg-[#060606] text-[#fafaf8] overflow-x-hidden selection:bg-amber-400 selection:text-black">
    <Navbar />

    <!-- Editorial Header Section (Dark Theme matching Homepage) -->
    <header class="w-full pt-28 pb-4 border-b border-white/10 bg-[#060606]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Top bar: Socials + Centered Brand Title "BLOGS" -->
        <div class="flex items-center justify-between py-4 border-b border-white/10">
          <!-- Left: Social icons -->
          <div class="flex items-center gap-3 sm:gap-4 text-white/50 text-sm">
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="hover:text-amber-400 transition-colors p-1"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a
              href="https://facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="hover:text-amber-400 transition-colors p-1"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="hover:text-amber-400 transition-colors p-1"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <a
              href="https://pinterest.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
              class="hidden sm:inline-block hover:text-amber-400 transition-colors p-1"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.365-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
            </a>
          </div>

          <!-- Center: Brand Masthead "BLOGS" -->
          <a href="/blog" class="text-center group inline-block">
            <span
              class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white uppercase group-hover:text-amber-400 transition-colors"
              style="font-family: 'Syne', sans-serif;"
            >
              BLOGS
            </span>
          </a>

          <!-- Right: Visual spacer for balance -->
          <div class="w-16 sm:w-24"></div>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
      
      {/* ============================================================== */}
      {/* 1. TOP EDITORIAL HERO GRID                                    */}
      {/* Left: Large hero post with overlaid badge and typography       */}
      {/* Right: Two stacked side stories with landscape thumbnails     */}
      {/* ============================================================== */}
      {heroMainPost && (
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
          
          <!-- Large Feature Card (Left 7 Cols) -->
          <div class="lg:col-span-7 flex">
            <a
              href={`/blog/${heroMainPost.id}`}
              class="group relative flex flex-col justify-end w-full min-h-[420px] sm:min-h-[480px] lg:min-h-[520px] rounded-2xl overflow-hidden bg-[#0d0d0d] border border-white/10 hover:border-amber-400/40 transition-all duration-300 shadow-xl"
            >
              <img
                src={getImage(heroMainPost, 0)}
                alt={heroMainPost.data.title}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#060606] via-[#060606]/65 to-transparent"></div>

              <div class="relative z-10 p-6 sm:p-8 md:p-10 text-white max-w-2xl">
                <span class="inline-block bg-amber-400 text-black text-[10px] sm:text-xs font-bold tracking-wider uppercase px-3 py-1 rounded-full mb-3" style="font-family: 'Outfit', sans-serif;">
                  {getPostCategory(heroMainPost)}
                </span>
                <h1
                  class="text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-white group-hover:text-amber-300 transition-colors mb-3"
                  style="font-family: 'Syne', sans-serif;"
                >
                  {heroMainPost.data.title}
                </h1>
                <p class="text-sm sm:text-base text-white/70 line-clamp-2 mb-4 font-normal leading-relaxed">
                  {heroMainPost.data.excerpt || 'Read the full coverage and expert analysis from our institute.'}
                </p>
                <div class="flex items-center text-xs text-white/50 gap-3 font-medium">
                  <time datetime={heroMainPost.data.date.toISOString().split('T')[0]}>
                    {formatDate(heroMainPost.data.date)}
                  </time>
                  <span>•</span>
                  <span>{heroMainPost.data.author || 'Bhavya Computer Classes'}</span>
                </div>
              </div>
            </a>
          </div>

          <!-- Two Stacked Stories (Right 5 Cols) -->
          <div class="lg:col-span-5 flex flex-col gap-6 justify-between">
            {heroSecondary1 && (
              <a
                href={`/blog/${heroSecondary1.id}`}
                class="group flex flex-col sm:flex-row lg:flex-row gap-4 p-4 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-amber-400/40 hover:bg-white/[0.06] transition-all h-full"
              >
                <div class="w-full sm:w-48 lg:w-48 h-40 sm:h-auto flex-shrink-0 overflow-hidden rounded-xl bg-white/5">
                  <img
                    src={getImage(heroSecondary1, 1)}
                    alt={heroSecondary1.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-col justify-center flex-grow py-1">
                  <span class="text-[10px] sm:text-xs font-bold tracking-wider uppercase text-amber-400 mb-1.5 block">
                    {getPostCategory(heroSecondary1)}
                  </span>
                  <h2
                    class="text-base sm:text-lg font-bold leading-snug text-white group-hover:text-amber-300 transition-colors mb-2 line-clamp-2"
                    style="font-family: 'Syne', sans-serif;"
                  >
                    {heroSecondary1.data.title}
                  </h2>
                  <time class="text-xs text-white/40 mt-auto">
                    {formatDate(heroSecondary1.data.date)}
                  </time>
                </div>
              </a>
            )}

            {heroSecondary2 && (
              <a
                href={`/blog/${heroSecondary2.id}`}
                class="group flex flex-col sm:flex-row lg:flex-row gap-4 p-4 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-amber-400/40 hover:bg-white/[0.06] transition-all h-full"
              >
                <div class="w-full sm:w-48 lg:w-48 h-40 sm:h-auto flex-shrink-0 overflow-hidden rounded-xl bg-white/5">
                  <img
                    src={getImage(heroSecondary2, 2)}
                    alt={heroSecondary2.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-col justify-center flex-grow py-1">
                  <span class="text-[10px] sm:text-xs font-bold tracking-wider uppercase text-amber-400 mb-1.5 block">
                    {getPostCategory(heroSecondary2)}
                  </span>
                  <h2
                    class="text-base sm:text-lg font-bold leading-snug text-white group-hover:text-amber-300 transition-colors mb-2 line-clamp-2"
                    style="font-family: 'Syne', sans-serif;"
                  >
                    {heroSecondary2.data.title}
                  </h2>
                  <time class="text-xs text-white/40 mt-auto">
                    {formatDate(heroSecondary2.data.date)}
                  </time>
                </div>
              </a>
            )}
          </div>
        </section>
      )}

      {/* ============================================================== */}
      {/* 2. CATEGORY ROW (4-CARD GRID)                                 */}
      {/* Header with amber indicator accent + title + "View All →" link */}
      {/* ============================================================== */}
      {featuredPosts.length > 0 && (
        <section class="space-y-6 pt-6">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-4 bg-amber-400 inline-block rounded-full"></span>
              <h2
                class="text-lg sm:text-xl font-bold tracking-tight text-white uppercase"
                style="font-family: 'Syne', sans-serif;"
              >
                Career & Courses
              </h2>
            </div>
            <a
              href="#all-articles"
              class="text-xs sm:text-sm font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1 group transition-colors"
            >
              View All
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {featuredPosts.map((post, idx) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col bg-white/[0.02] border border-white/10 hover:border-amber-400/40 hover:bg-white/[0.05] p-3 rounded-2xl transition-all"
              >
                <div class="aspect-[4/3] w-full overflow-hidden rounded-xl bg-white/5 mb-3.5">
                  <img
                    src={getImage(post, idx + 3)}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <span class="text-[10px] font-bold tracking-wider uppercase text-amber-400 mb-1.5">
                  {getPostCategory(post)}
                </span>
                <h3
                  class="text-sm sm:text-base font-bold leading-snug text-white group-hover:text-amber-300 transition-colors mb-2 line-clamp-2"
                  style="font-family: 'Syne', sans-serif;"
                >
                  {post.data.title}
                </h3>
                <time class="text-xs text-white/40 mt-auto">
                  {formatDate(post.data.date)}
                </time>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ============================================================== */}
      {/* 3. MORE STORIES / ARCHIVE GRID                                */}
      {/* Responsive cards with homepage dark glass aesthetic           */}
      {/* ============================================================== */}
      {remainingPosts.length > 0 && (
        <section class="space-y-6 pt-6" id="all-articles">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <span class="w-1.5 h-4 bg-amber-400 inline-block rounded-full"></span>
              <h2
                class="text-lg sm:text-xl font-bold tracking-tight text-white uppercase"
                style="font-family: 'Syne', sans-serif;"
              >
                All Articles & Guides
              </h2>
            </div>
            <span class="text-xs text-white/40 font-medium">
              Showing {remainingPosts.length} articles
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {remainingPosts.map((post, idx) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col bg-white/[0.02] border border-white/10 rounded-2xl overflow-hidden hover:border-amber-400/40 hover:bg-white/[0.05] transition-all duration-300 group-hover:-translate-y-1"
              >
                <div class="aspect-[16/10] w-full overflow-hidden bg-white/5">
                  <img
                    src={getImage(post, idx + 7)}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-6 flex flex-col flex-grow">
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="text-[10px] font-bold tracking-wider uppercase text-amber-400">
                      {getPostCategory(post)}
                    </span>
                    <time class="text-xs text-white/40">
                      {formatDate(post.data.date)}
                    </time>
                  </div>
                  <h3
                    class="text-base sm:text-lg font-bold leading-snug text-white group-hover:text-amber-300 transition-colors mb-2.5 line-clamp-2"
                    style="font-family: 'Syne', sans-serif;"
                  >
                    {post.data.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-white/60 line-clamp-3 mb-4 leading-relaxed flex-grow">
                    {post.data.excerpt || 'Learn practical skills, syllabus details, and market insights.'}
                  </p>
                  <div class="inline-flex items-center text-xs font-bold text-white group-hover:text-amber-400 transition-colors gap-1.5 mt-auto">
                    Read Article
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      import { initSmoothScroll } from '../../scripts/smooth-scroll';

      document.addEventListener('DOMContentLoaded', () => {
        initSmoothScroll();
      });
    </script>
  </body>
</html>
