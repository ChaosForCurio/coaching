---
export const prerender = true;

import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Privacy Policy | Bhavya Career Institute — Kota"
      description="Read the Privacy Policy of Bhavya Career Institute. Learn how we collect, use, and protect your data, and how Google AdSense and third-party cookies are managed."
      canonical="https://www.bhavyacomputerclasses.com/privacy-policy"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main class="w-full min-h-screen pt-20">
      <!-- Standard Hero Banner -->
      <section class="relative py-16 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <nav class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[1.5px] text-white/70 bg-white/[0.07] border border-white/15 px-5 py-2 rounded-full mb-5" aria-label="Breadcrumb">
            <a href="/" class="text-[#F4B51B] hover:text-white transition-colors">Home</a>
            <span class="text-white/40">›</span>
            <span>Privacy Policy</span>
          </nav>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-3 text-white font-['Poppins']">
            Privacy Policy
          </h1>
          <p class="text-white/80 text-sm max-w-xl mx-auto">
            Last updated: September 2026 • गोपनीयता नीति
          </p>
        </div>
      </section>

      <!-- Content Container -->
      <div class="max-w-4xl mx-auto px-4 py-16">
        <div class="bg-white p-8 sm:p-12 rounded-3xl border border-[#082B63]/[0.08] shadow-sm space-y-8 text-[#4A5568] leading-relaxed font-['Inter']">
          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">1. Introduction</h2>
            <p>
              Welcome to <strong>Bhavya Career Institute</strong> ("we", "our", or "us"). We operate the website 
              <a href="https://www.bhavyacomputerclasses.com" class="text-[#0757A8] font-semibold hover:underline">www.bhavyacomputerclasses.com</a>. 
              We respect your privacy and are committed to protecting any personal information you share with us. This Privacy Policy explains our data collection practices and your rights.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">2. Information We Collect</h2>
            <p>We may collect information directly from you or automatically when you use our site:</p>
            <ul class="list-disc pl-6 space-y-2 mt-2">
              <li><strong>Personal Data:</strong> Name, email address, phone number, and inquiry details provided voluntarily through contact forms, course registrations, or attendance checks.</li>
              <li><strong>Usage Data:</strong> Technical logs including IP address, browser type, operating system, pages visited, and time spent on pages.</li>
            </ul>
          </section>

          <section class="p-6 rounded-2xl bg-[#082B63]/[0.03] border border-[#082B63]/10">
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">3. Google AdSense & Cookies (Important Notice)</h2>
            <p>
              Our website uses <strong>Google AdSense</strong>, a third-party advertising service provided by Google LLC. Google AdSense uses cookies to serve ads based on users' prior visits to our website or other websites on the Internet.
            </p>
            <ul class="list-disc pl-6 space-y-3 mt-4">
              <li>
                <strong>Use of Cookies:</strong> Google's use of advertising cookies enables it and its partners to serve ads to users based on their visit to our site and/or other sites on the Internet.
              </li>
              <li>
                <strong>Personalized Advertising:</strong> You may opt out of personalized advertising by visiting 
                <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[#0757A8] font-semibold hover:underline">Google Ads Settings</a>. Alternatively, you can opt out of third-party vendor's use of cookies for personalized advertising by visiting <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-[#0757A8] font-semibold hover:underline">www.aboutads.info</a>.
              </li>
              <li>
                <strong>Third-Party Vendors:</strong> Third-party vendors and ad networks may also serve ads on our site. You can manage or disable cookies through your browser settings.
              </li>
            </ul>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">4. How We Use Your Information</h2>
            <p>We use collected data to:</p>
            <ul class="list-disc pl-6 space-y-2 mt-2">
              <li>Provide course information, admissions updates, and student services.</li>
              <li>Respond to queries submitted via form or phone.</li>
              <li>Analyze website performance and improve user experience.</li>
              <li>Display relevant advertisements through certified ad networks.</li>
            </ul>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">5. Data Protection & Security</h2>
            <p>
              We implement strict technical and organizational security measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">6. Children's Privacy</h2>
            <p>
              Our website is intended for general audiences and student inquiry. We do not knowingly collect personal information from children under 13 without parental consent.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">7. Contact Us</h2>
            <p>If you have any questions regarding this Privacy Policy or data practices, please contact us:</p>
            <div class="mt-4 p-5 rounded-2xl bg-[#F8FAFD] border border-[#082B63]/10 text-sm space-y-1.5 text-[#172033]">
              <p class="font-bold text-[#082B63]">Bhavya Career Institute</p>
              <p>Address: 3-N-25, Mahaveer Nagar Extn, Near Ganesh Ji Mandir, Kota, Rajasthan - 324005</p>
              <p>Phone: +91 96949 32391 | +91 96940 25249</p>
            </div>
          </section>
        </div>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
