---
import DashboardOverview from '../../components/DashboardOverview.astro';
import { requireAuth } from '../../utils/auth';

const currentUser = await requireAuth(Astro.cookies);
if (!currentUser) {
  Astro.cookies.delete('__session');
  return Astro.redirect('/login');
}
---

<DashboardOverview currentUser={currentUser} />
