---
export const prerender = true;
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import Courses from '../components/Courses.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Reviews from '../components/Reviews.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Footer from '../components/Footer.astro';

import { generateLocalBusinessSchema } from '../utils/schemaGenerator';

// JSON-LD: Organisation + Courses + Local Business
const organizationSchema = generateLocalBusinessSchema();
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Bhavya Computer Classes — Best Computer Classes in Kota, Rajasthan"
      description="Bhavya Computer Classes — Kota's top government-certified computer training institute. Learn DCA, Tally Prime, Advanced Excel, Python, Web Development, RSCIT & Digital Marketing. 100% placement assistance. Est. 2010."
      canonical="https://www.bhavyacomputerclasses.com/"
      schema={organizationSchema}
    />
    <!-- Preload hero image for LCP performance -->
    <link rel="preload" as="image" href="/images/hero-bg.jpg" />
  </head>
  <body class="bg-[#fafaf8] text-[#1a1a2e] overflow-x-hidden selection:bg-[#1a1a2e]/20">
    <Navbar />

    <main class="w-full">
      <!-- Visually hidden h1 supplement for SEO — visible h1 is inside Hero -->
      <Hero />
      <StatsCounter />
      <Courses />
      <EnquiryForm />
      <Reviews />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      import { initReveal } from '../scripts/reveal';

      // If Neon Auth redirects here with a session verifier, send to sso-callback
      if (window.location.search.includes('neon_auth_session_verifier')) {
        window.location.href = '/sso-callback' + window.location.search;
      }

      document.addEventListener('DOMContentLoaded', () => {
        initReveal();
      });
    </script>
  </body>
</html>
