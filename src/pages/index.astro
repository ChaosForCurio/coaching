---
export const prerender = true;
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Courses from '../components/Courses.astro';
import Reviews from '../components/Reviews.astro';
import CallToBanner from '../components/CallToBanner.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Footer from '../components/Footer.astro';

import { generateLocalBusinessSchema } from '../utils/schemaGenerator';
import { getOptimizedImageUrl } from '../utils/cloudinary';

// JSON-LD: Organisation + Courses + Local Business
const organizationSchema = generateLocalBusinessSchema();

const heroPreloadUrl = getOptimizedImageUrl('/images/hero-bg.jpg', {
  width: 1600,
  quality: 'auto',
  format: 'auto',
  crop: 'fill',
});
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Bhavya Career Institute — Best Computer Classes in Kota, Rajasthan"
      description="Bhavya Career Institute — Kota's top government-certified computer training institute. Learn DCA, Tally Prime, Advanced Excel, Python, Web Development, RSCIT & Digital Marketing. 100% placement assistance. Est. 2010."
      canonical="https://www.bhavyacomputerclasses.com/"
      schema={organizationSchema}
    />
    <!-- Preconnect to Cloudinary CDN for faster image delivery -->
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <!-- Preload hero image for LCP performance -->
    <link rel="preload" as="image" href={heroPreloadUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F5F8FC] text-[#1a1a2e] overflow-x-hidden selection:bg-[#1a1a2e]/20">
    <Navbar />

    <main class="w-full">
      <Hero />
      <StatsCounter />
      <WhyChooseUs />
      <Courses />
      <Reviews />
      <CallToBanner />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      import { initReveal } from '../scripts/reveal';
      import { initSmoothScroll } from '../scripts/smooth-scroll';

      // If Neon Auth redirects here with a session verifier, send to sso-callback
      if (window.location.search.includes('neon_auth_session_verifier')) {
        window.location.href = '/sso-callback' + window.location.search;
      }

      document.addEventListener('DOMContentLoaded', () => {
        initSmoothScroll();
        initReveal();
      });
    </script>
  </body>
</html>
