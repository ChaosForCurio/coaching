---
export const prerender = true;

import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import FAQComponent from '../components/FAQ.astro';
import CallToBanner from '../components/CallToBanner.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

import { generateFAQSchema, generateBreadcrumbSchema } from '../utils/schemaGenerator';
import faqs from '../data/faqs.json';

const rawFaqSchema = generateFAQSchema(faqs);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', item: 'https://www.bhavyacomputerclasses.com/' },
  { name: 'FAQ', item: 'https://www.bhavyacomputerclasses.com/faq' },
]);

const combinedSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': rawFaqSchema['@type'],
      mainEntity: rawFaqSchema.mainEntity,
    },
    breadcrumbSchema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="FAQ | Bhavya Career Institute — Computer Courses in Kota"
      description="Find answers to common questions about our computer courses, admissions, fees, placement assistance, and certification at Bhavya Career Institute, Kota. Free demo classes available."
      canonical="https://www.bhavyacomputerclasses.com/faq"
      schema={combinedSchema}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main class="w-full min-h-screen pt-20">
      <!-- FAQ Hero Banner matching Homepage / Inner pages pattern -->
      <section class="relative py-20 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-4 text-white font-['Poppins']">
            Frequently Asked Questions
            <span class="block text-xl sm:text-2xl font-semibold text-[#FBD47A] mt-2 font-['Noto_Sans_Devanagari']">
              अक्सर पूछे जाने वाले सवाल एवं उत्तर
            </span>
          </h1>

          <p class="font-['Noto_Sans_Devanagari'] text-base sm:text-lg text-white/85 max-w-2xl leading-relaxed">
            कोर्स चयन, फीस संरचना, सरकारी सर्टिफिकेट, प्रैक्टिकल लैब एवं 100% प्लेसमेंट सहायता से जुड़े सभी सवालों के जवाब।
          </p>
        </div>
      </section>

      <FAQComponent />
      <CallToBanner />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      import { initSmoothScroll } from '../scripts/smooth-scroll';

      document.addEventListener('DOMContentLoaded', () => {
        initSmoothScroll();
      });
    </script>
  </body>
</html>
