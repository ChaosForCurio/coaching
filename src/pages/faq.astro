---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import Navbar from '../components/Navbar.astro';
import FAQComponent from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>FAQ | Bhavya Career Institute — Kota</title>
    <meta
      name="description"
      content="Find answers to common questions about our courses, admissions, fees, placements, and certification at Bhavya Career Institute, Kota."
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="FAQ — Bhavya Career Institute" />
    <meta
      property="og:description"
      content="Got questions? We've got answers about our DCA, Tally, Python, Web Designing courses and more."
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@300;400;500;600&family=Outfit:wght@300;400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />

    <main class="w-full min-h-screen pt-24">
      <FAQComponent />
    </main>

    <Footer />
  </body>
</html>
