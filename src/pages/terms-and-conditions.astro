---
export const prerender = true;

import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Terms and Conditions | Bhavya Career Institute — Kota"
      description="Terms and Conditions of service for Bhavya Career Institute, Kota. Understand your rights, website terms, course enrollment policies, and website usage."
      canonical="https://www.bhavyacomputerclasses.com/terms-and-conditions"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main class="w-full min-h-screen pt-20">
      <!-- Standard Hero Banner -->
      <section class="relative py-16 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <nav class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[1.5px] text-white/70 bg-white/[0.07] border border-white/15 px-5 py-2 rounded-full mb-5" aria-label="Breadcrumb">
            <a href="/" class="text-[#F4B51B] hover:text-white transition-colors">Home</a>
            <span class="text-white/40">›</span>
            <span>Terms & Conditions</span>
          </nav>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-3 text-white font-['Poppins']">
            Terms & Conditions
          </h1>
          <p class="text-white/80 text-sm max-w-xl mx-auto">
            Last updated: September 2026 • नियम एवं शर्तें
          </p>
        </div>
      </section>

      <!-- Content Container -->
      <div class="max-w-4xl mx-auto px-4 py-16">
        <div class="bg-white p-8 sm:p-12 rounded-3xl border border-[#082B63]/[0.08] shadow-sm space-y-8 text-[#4A5568] leading-relaxed font-['Inter']">
          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">1. Acceptance of Terms</h2>
            <p>
              By accessing or using the website <a href="https://www.bhavyacomputerclasses.com" class="text-[#0757A8] font-semibold hover:underline">www.bhavyacomputerclasses.com</a>, 
              you agree to comply with and be bound by these Terms and Conditions. If you do not agree, please refrain from using our site.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">2. Intellectual Property</h2>
            <p>
              All content, including course outlines, text, graphics, logos, images, and software, is the property of Bhavya Career Institute and is protected under applicable copyright laws. Unauthorized reproduction or distribution is strictly prohibited.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">3. Course Admissions & Certification</h2>
            <p>
              Information provided regarding courses (such as DCA, Tally Prime, RS-CIT, Web Development) is subject to availability and batch scheduling. Certifications are granted based on course completion, attendance, and evaluation guidelines set by the respective governing bodies.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">4. User Responsibilities</h2>
            <p>
              Users agree not to misuse the website, attempt unauthorized access to systems, or post unlawful, harmful, or defamatory content.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">5. Advertisements & External Links</h2>
            <p>
              Our website displays advertisements via Google AdSense and may contain links to third-party sites. We are not responsible for the content, privacy policies, or practices of third-party websites or advertisers.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">6. Limitation of Liability</h2>
            <p>
              Bhavya Career Institute shall not be held liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use this website.
            </p>
          </section>

          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-[#082B63] mb-3 font-['Poppins']">7. Contact Information</h2>
            <p>For questions regarding these Terms, contact us at:</p>
            <div class="mt-4 p-5 rounded-2xl bg-[#F8FAFD] border border-[#082B63]/10 text-sm space-y-1.5 text-[#172033]">
              <p class="font-bold text-[#082B63]">Bhavya Career Institute</p>
              <p>Address: 3-N-25, Mahaveer Nagar Extn, Near Ganesh Ji Mandir, Kota, Rajasthan - 324005</p>
              <p>Phone: +91 96949 32391 | +91 96940 25249</p>
            </div>
          </section>
        </div>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
