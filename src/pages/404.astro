---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';

const popularCourses = [
  { name: 'Tally Prime with GST', desc: 'Accounting & GST Filing Course', link: '/all-courses' },
  { name: 'DCA Computer Course', desc: 'Diploma in Computer Applications', link: '/all-courses' },
  { name: 'RS-CIT Government Course', desc: 'RKCL Certified Computer Course', link: '/all-courses' },
  { name: 'Python & Web Development', desc: 'Practical Coding Lab Training', link: '/all-courses' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="404 — Page Not Found | Bhavya Career Institute, Kota"
      description="The page you are looking for does not exist on Bhavya Career Institute. Explore our computer courses in Kota or return home."
      canonical="https://www.bhavyacomputerclasses.com/404"
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main class="w-full min-h-screen pt-32 pb-24 px-6 max-w-4xl mx-auto flex flex-col items-center justify-center text-center">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-4 font-['Poppins']">
        404 Page Not Found • पृष्ठ नहीं मिला
      </span>

      <h1 class="text-7xl md:text-9xl font-black text-[#082B63]/15 tracking-tight leading-none mb-2 font-['Poppins']">
        404
      </h1>
      
      <h2 class="text-2xl md:text-4xl font-bold mb-3 text-[#082B63] font-['Poppins']">
        Looks like you're lost
      </h2>
      <p class="text-[#4A5568] text-base max-w-md mx-auto mb-10 leading-relaxed font-['Inter']">
        The page you are looking for might have been moved or doesn't exist. Explore our top computer courses in Kota below:
      </p>

      <!-- Popular Courses Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full text-left mb-12">
        {popularCourses.map((course) => (
          <a
            href={course.link}
            class="p-5 rounded-2xl bg-white border border-[#082B63]/[0.08] shadow-sm hover:shadow-md hover:border-[#0757A8]/40 transition-all group"
          >
            <h3 class="text-base font-bold text-[#082B63] group-hover:text-[#0757A8] transition-colors flex items-center justify-between font-['Poppins']">
              {course.name}
              <span class="text-xs text-[#0757A8] group-hover:translate-x-1 transition-transform">→</span>
            </h3>
            <p class="text-xs text-[#6B7A90] mt-1 font-['Inter']">{course.desc}</p>
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="px-8 py-3.5 rounded-full bg-[#082B63] text-white font-semibold text-sm hover:bg-[#0757A8] transition-all font-['Poppins'] shadow-md"
        >
          Return to Homepage
        </a>
        <a
          href="/contact"
          class="px-8 py-3.5 rounded-full bg-[#F39A18] text-white font-semibold text-sm hover:bg-[#e08a10] transition-all font-['Poppins'] shadow-md shadow-[#F39A18]/25"
        >
          Book Free Demo Class
        </a>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
