---
export const prerender = true;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';

const popularCourses = [
  { name: 'Tally Prime with GST', desc: 'Accounting & GST Filing Course', link: '/all-courses' },
  { name: 'DCA Computer Course', desc: 'Diploma in Computer Applications', link: '/all-courses' },
  { name: 'RS-CIT Government Course', desc: 'RKCL Certified Computer Course', link: '/all-courses' },
  { name: 'Python & Web Development', desc: 'Practical Coding Lab Training', link: '/all-courses' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="404 — Page Not Found | Bhavya Computer Classes, Kota"
      description="The page you are looking for does not exist on Bhavya Computer Classes. Explore our computer courses in Kota or return home."
      canonical="https://www.bhavyacomputerclasses.com/404"
    />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Navbar />

    <main class="w-full min-h-screen pt-32 pb-24 px-6 max-w-4xl mx-auto flex flex-col items-center justify-center text-center">
      <span class="text-xs uppercase tracking-[0.4em] text-white/50 mb-2 font-semibold">404 Error</span>
      <h1 class="text-7xl md:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-white/20 tracking-tight leading-none mb-4">
        404
      </h1>
      
      <h2 class="text-2xl md:text-4xl font-bold mb-3">Looks like you're lost</h2>
      <p class="text-white/60 text-base max-w-md mx-auto mb-10 leading-relaxed font-light">
        The page you are looking for might have been moved or doesn't exist. Explore our top computer courses in Kota below:
      </p>

      <!-- Popular Courses Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full text-left mb-12">
        {popularCourses.map((course) => (
          <a
            href={course.link}
            class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/25 hover:bg-white/[0.06] transition-all group"
          >
            <h3 class="text-base font-semibold text-white group-hover:text-amber-400 transition-colors flex items-center justify-between">
              {course.name}
              <span class="text-xs text-white/40 group-hover:translate-x-1 transition-transform">→</span>
            </h3>
            <p class="text-xs text-white/50 mt-1 font-light">{course.desc}</p>
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="px-8 py-3.5 rounded-xl bg-white text-black font-semibold text-sm hover:bg-white/90 transition-all uppercase tracking-wider shadow-lg"
        >
          Return to Homepage
        </a>
        <button
          type="button"
          data-open-demo-modal
          class="px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm border border-white/15 hover:bg-white/20 transition-all uppercase tracking-wider cursor-pointer"
        >
          Book Free Demo Class
        </button>
      </div>
    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
