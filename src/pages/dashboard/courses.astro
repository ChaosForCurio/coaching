---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { db } from '../../db';
import { users, courses, enrollments, attendance } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { requireAuth } from '../../utils/auth';

// ─── Auth Guard ─────────────────────────────────────────────────────────────
const currentUser = await requireAuth(Astro.cookies);
if (!currentUser) { 
  Astro.cookies.delete('userSession'); 
  return Astro.redirect('/login'); 
}
const userId = currentUser.id;

const role = currentUser.role;

// ─── Fetch course + attendance data ─────────────────────────────────────────
let studentCourses: any[] = [];
let studentAttendance: any[] = [];
let teacherCourses: any[] = [];
let allEnrollments: any[] = [];

if (role === 'STUDENT') {
  const myEnrollments = await db.select().from(enrollments).where(eq(enrollments.student_id, userId));
  const allCourses = await db.select().from(courses);
  studentCourses = allCourses.filter(c => myEnrollments.some(e => e.course_id === c.id));
  studentAttendance = await db.select().from(attendance).where(eq(attendance.student_id, userId));
} else {
  teacherCourses = await db.select().from(courses).where(eq(courses.teacher_id, userId));
  allEnrollments = await db.select().from(enrollments);
}

const dbPayload = { currentUser, studentCourses, studentAttendance, teacherCourses, allEnrollments };
---

<DashboardLayout
  title="Courses — BCI Dashboard"
  description="Course-wise attendance breakdown at Bhavya Career Institute."
  currentUser={currentUser}
  activePage="courses"
>
  <!-- Hidden payload -->
  <div id="dashboard-payload" data-payload={JSON.stringify(dbPayload)} class="hidden"></div>

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h2 class="page-title" id="page-title">Courses</h2>
      <p class="page-subtitle" id="page-subtitle">Course-wise attendance breakdown</p>
    </div>
    <button class="download-btn" id="download-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download Report
    </button>
  </div>

  <!-- Courses Table -->
  <section class="section">
    <div class="courses-table-wrap">
      <table class="courses-table">
        <thead id="courses-thead">
          <tr>
            <th>Course</th>
            <th>Present</th>
            <th>Total Days</th>
            <th>Percentage</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="courses-tbody">
          <tr><td colspan="5" class="empty-cell">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <style>
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 40px; flex-wrap: wrap; gap: 20px; }
    .page-title { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; color: white; letter-spacing: -0.04em; margin: 0; }
    .page-subtitle { font-family: 'Outfit', sans-serif; font-size: 14px; color: rgba(255,255,255,0.5); margin: 6px 0 0; }

    .section { margin-bottom: 48px; }

    .download-btn {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 12px;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.8); font-family: 'Outfit', sans-serif;
      font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;
    }
    .download-btn:hover {
      background: rgba(255,255,255,0.1); color: white;
      border-color: rgba(255,255,255,0.2); transform: translateY(-1px);
    }

    .courses-table-wrap {
      background: #000; border: 1px solid #333; border-radius: 20px; overflow: hidden;
    }
    .courses-table { width: 100%; border-collapse: collapse; min-width: 600px; }
    .courses-table th {
      padding: 16px 24px; text-align: left; font-family: 'Outfit', sans-serif;
      font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.4);
      text-transform: uppercase; letter-spacing: 0.1em;
      background: rgba(255,255,255,0.02); border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .courses-table td {
      padding: 18px 24px; font-family: 'Outfit', sans-serif; font-size: 14px;
      font-weight: 500; color: rgba(255,255,255,0.7);
      border-bottom: 1px solid rgba(255,255,255,0.03);
      font-variant-numeric: tabular-nums; transition: background-color 0.2s;
    }
    .courses-table tr:last-child td { border-bottom: none; }
    .courses-table tr:hover td { background: rgba(255,255,255,0.03); }

    .empty-cell { text-align: center; padding: 60px 24px !important; color: rgba(255,255,255,0.2) !important; }

    .progress-wrap { display: flex; align-items: center; gap: 12px; }
    .progress-bar-bg { height: 8px; border-radius: 4px; background: rgba(255,255,255,0.06); flex: 1; min-width: 80px; overflow: hidden; }
    .progress-bar-fg { height: 100%; border-radius: 4px; transition: width 1.2s cubic-bezier(0.16,1,0.3,1); }
    .progress-label { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; min-width: 40px; text-align: right; color: white; }

    .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-family: 'Outfit', sans-serif; font-weight: 600; letter-spacing: 0.05em; }
    .status-safe    { background: rgba(16,185,129,0.1);  color: #34d399; border: 1px solid rgba(16,185,129,0.2); }
    .status-warning { background: rgba(245,158,11,0.1);  color: #fbbf24; border: 1px solid rgba(245,158,11,0.2); }
    .status-danger  { background: rgba(239,68,68,0.1);   color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .status-active  { background: rgba(34,211,238,0.1);  color: #22d3ee; border: 1px solid rgba(34,211,238,0.2); }
  </style>

  <script>
    const payload = JSON.parse(document.getElementById('dashboard-payload')?.getAttribute('data-payload') || '{}');
    const { currentUser, studentCourses, studentAttendance, teacherCourses, allEnrollments } = payload;
    const role = currentUser.role.toLowerCase();

    const tbody = document.getElementById('courses-tbody') as HTMLTableSectionElement;
    const thead = document.getElementById('courses-thead') as HTMLTableSectionElement;

    function getStatusBadge(pct: number) {
      if (pct >= 80) return `<span class="status-badge status-safe">● Safe</span>`;
      if (pct >= 75) return `<span class="status-badge status-warning">▲ Warning</span>`;
      return `<span class="status-badge status-danger">✗ At Risk</span>`;
    }

    if (role === 'student') {
      // Compute overall attendance
      const now = new Date();
      const year = now.getFullYear(), month = now.getMonth();
      const todayStr = now.toISOString().split('T')[0];
      let present = 0, absent = 0;
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const presentSet = new Set(studentAttendance.map((a: any) => a.date));

      for (let d = 1; d <= daysInMonth; d++) {
        const cell = new Date(year, month, d);
        const ds = cell.toISOString().split('T')[0];
        if (ds > todayStr) break;
        if (cell.getDay() === 0) continue;
        presentSet.has(ds) ? present++ : absent++;
      }
      const total = present + absent;
      const pct = total > 0 ? Math.round((present / total) * 100) : 100;

      tbody.innerHTML = studentCourses.length === 0
        ? `<tr><td colspan="5" class="empty-cell">No courses assigned yet.</td></tr>`
        : studentCourses.map((c: any) => `
            <tr>
              <td style="color:rgba(255,255,255,0.9);font-weight:600;">${c.title}</td>
              <td>${present}</td>
              <td>${total}</td>
              <td>
                <div class="progress-wrap">
                  <div class="progress-bar-bg">
                    <div class="progress-bar-fg" style="width:${pct}%;background:#fff;"></div>
                  </div>
                  <span class="progress-label">${pct}%</span>
                </div>
              </td>
              <td>${getStatusBadge(pct)}</td>
            </tr>`).join('');

    } else {
      // Teacher view
      document.getElementById('page-title')!.textContent = 'My Courses';
      document.getElementById('page-subtitle')!.textContent = 'Courses you teach and enrolled students';

      thead.innerHTML = `
        <tr>
          <th>Course Name</th>
          <th>Enrolled Students</th>
          <th>Status</th>
        </tr>`;

      tbody.innerHTML = teacherCourses.length === 0
        ? `<tr><td colspan="3" class="empty-cell">No courses assigned to you.</td></tr>`
        : teacherCourses.map((c: any) => {
            const count = allEnrollments.filter((e: any) => e.course_id === c.id).length;
            return `
              <tr>
                <td style="color:rgba(255,255,255,0.9);font-weight:600;">${c.title}</td>
                <td>${count} ${count === 1 ? 'Student' : 'Students'}</td>
                <td><span class="status-badge status-active">● Active</span></td>
              </tr>`;
          }).join('');
    }

    // Download CSV
    document.getElementById('download-btn')?.addEventListener('click', () => {
      let rows: string[][], filename: string;
      if (role === 'student') {
        rows = [['Course Title', 'Present Days', 'Total Days', 'Percentage'], ...studentCourses.map((c: any) => [c.title, '—', '—', '—'])];
        filename = `BCI_Attendance_Report.csv`;
      } else {
        rows = [['Course Title', 'Enrolled Students'], ...teacherCourses.map((c: any) => [c.title, String(allEnrollments.filter((e: any) => e.course_id === c.id).length)])];
        filename = `BCI_Teacher_Courses_Report.csv`;
      }
      const csv = rows.map(r => r.join(',')).join('\n');
      const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(new Blob([csv], { type: 'text/csv' })), download: filename });
      a.click();
    });
  </script>

</DashboardLayout>
