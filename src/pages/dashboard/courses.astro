---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { db } from '../../db';
import { users, courses, enrollments, attendance } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { requireAuth } from '../../utils/auth';

// ─── Auth Guard ─────────────────────────────────────────────────────────────
const currentUser = await requireAuth(Astro.cookies);
if (!currentUser) { 
  Astro.cookies.delete('userSession'); 
  return Astro.redirect('/login'); 
}
const userId = currentUser.id;

const role = currentUser.role;

// ─── Fetch course + attendance data ─────────────────────────────────────────
let studentCourses: any[] = [];
let studentAttendance: any[] = [];
let teacherCourses: any[] = [];
let allEnrollments: any[] = [];

if (role === 'STUDENT') {
  const myEnrollments = await db.select().from(enrollments).where(eq(enrollments.student_id, userId));
  const allCourses = await db.select().from(courses);
  studentCourses = allCourses.filter(c => myEnrollments.some(e => e.course_id === c.id));
  studentAttendance = await db.select().from(attendance).where(eq(attendance.student_id, userId));
} else {
  const API_URL = '';
  try {
    const response = await fetch(`${API_URL}/api/courses`, {
      headers: {
        cookie: Astro.request.headers.get('cookie') || ''
      }
    });
    if (response.ok) {
      teacherCourses = await response.json();
    } else {
      console.error(`API response error: ${response.status}`);
      teacherCourses = [];
    }
  } catch (err) {
    console.error('Failed to fetch courses from API:', err);
    teacherCourses = [];
  }
  allEnrollments = await db.select().from(enrollments);
}

const dbPayload = { currentUser, studentCourses, studentAttendance, teacherCourses, allEnrollments };
---

<DashboardLayout
  title="Courses — BCI Dashboard"
  description="Course-wise attendance breakdown at Bhavya Career Institute."
  currentUser={currentUser}
  activePage="courses"
>
  <!-- Hidden payload -->
  <div id="dashboard-payload" data-payload={JSON.stringify(dbPayload)} class="hidden"></div>

  <!-- Page Header -->
  <div class="page-header">
    <div class="header-text">
      <h2 class="page-title" id="page-title">Courses</h2>
      <p class="page-subtitle" id="page-subtitle">Your enrolled courses and attendance overview</p>
    </div>
    <button class="download-btn" id="download-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download Report
    </button>
  </div>

  <!-- Courses Grid -->
  <section class="section" id="courses-container">
    <div class="courses-grid" id="courses-grid">
      <!-- Loading State -->
      <div class="course-card skeleton">
        <div class="skeleton-header"></div>
        <div class="skeleton-body"></div>
      </div>
      <div class="course-card skeleton">
        <div class="skeleton-header"></div>
        <div class="skeleton-body"></div>
      </div>
    </div>
  </section>

  <style>
    .page-header { 
      display: flex; align-items: flex-end; justify-content: space-between; 
      margin-bottom: 48px; flex-wrap: wrap; gap: 24px; 
    }
    .header-text {
      display: flex; flex-direction: column; gap: 8px;
    }
    .page-title { 
      font-family: 'Syne', sans-serif; font-size: 36px; font-weight: 800; 
      color: white; letter-spacing: -0.04em; margin: 0;
      background: linear-gradient(to right, #fff, #a5b4fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .page-subtitle { 
      font-family: 'Outfit', sans-serif; font-size: 16px; 
      color: rgba(255,255,255,0.6); margin: 0; 
    }

    .section { margin-bottom: 48px; }

    .download-btn {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 24px; border-radius: 14px;
      background: rgba(255,255,255,0.05); 
      border: 1px solid rgba(255,255,255,0.1);
      color: white; font-family: 'Outfit', sans-serif;
      font-size: 14px; font-weight: 600; cursor: pointer; 
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      backdrop-filter: blur(10px);
    }
    .download-btn:hover {
      background: rgba(255,255,255,0.1); 
      border-color: rgba(255,255,255,0.2); 
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .courses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }

    .course-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 28px;
      backdrop-filter: blur(12px);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      display: flex;
      flex-direction: column;
      gap: 24px;
      position: relative;
      overflow: hidden;
    }
    .course-card:hover {
      transform: translateY(-6px);
      border-color: rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }
    .card-accent-line {
      position: absolute;
      top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
      opacity: 0.8;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
    }
    .course-title {
      font-family: 'Syne', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: white;
      margin: 0;
      line-height: 1.2;
    }
    .course-meta {
      font-family: 'Outfit', sans-serif;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.4);
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .stats-row {
      display: flex;
      justify-content: space-between;
      padding: 20px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .stat-value {
      font-family: 'Syne', sans-serif;
      font-size: 28px;
      font-weight: 800;
      color: white;
      line-height: 1;
    }
    .stat-label {
      font-family: 'Outfit', sans-serif;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.4);
      font-weight: 600;
    }

    .progress-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .progress-bar-bg {
      height: 8px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.06);
      width: 100%;
      overflow: hidden;
      position: relative;
    }
    .progress-bar-fg {
      height: 100%;
      border-radius: 4px;
      width: 0%;
      transition: width 1.5s cubic-bezier(0.16,1,0.3,1);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .status-safe    { background: rgba(16,185,129,0.1);  color: #34d399; border: 1px solid rgba(16,185,129,0.2); }
    .status-warning { background: rgba(245,158,11,0.1);  color: #fbbf24; border: 1px solid rgba(245,158,11,0.2); }
    .status-danger  { background: rgba(239,68,68,0.1);   color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
    .status-active  { background: rgba(34,211,238,0.1);  color: #22d3ee; border: 1px solid rgba(34,211,238,0.2); }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 80px 24px;
      background: rgba(255,255,255,0.02);
      border: 1px dashed rgba(255,255,255,0.1);
      border-radius: 24px;
      color: rgba(255,255,255,0.4);
      font-family: 'Outfit', sans-serif;
      font-size: 16px;
    }

    /* Skeleton Loading */
    .skeleton { animation: pulse 2s infinite ease-in-out; }
    .skeleton-header { height: 28px; width: 60%; background: rgba(255,255,255,0.05); border-radius: 6px; margin-bottom: 24px; }
    .skeleton-body { height: 80px; width: 100%; background: rgba(255,255,255,0.05); border-radius: 12px; }
    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.5; }
      100% { opacity: 1; }
    }

    @media (max-width: 600px) {
      .page-title { font-size: 28px; }
      .page-header { margin-bottom: 32px; }
      .course-card { padding: 20px; }
      .courses-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import jsPDF from 'jspdf';
    import autoTable from 'jspdf-autotable';

    document.addEventListener('astro:page-load', () => {
      const payloadEl = document.getElementById('dashboard-payload');
      if (!payloadEl) return; // Only run on courses page

      const payload = JSON.parse(payloadEl.getAttribute('data-payload') || '{}');
      const { currentUser, studentCourses, studentAttendance, teacherCourses, allEnrollments } = payload;
      const role = currentUser.role.toLowerCase();

      const grid = document.getElementById('courses-grid');

      function getStatusBadge(pct: number) {
        if (pct >= 80) return `<span class="status-badge status-safe">● Safe</span>`;
        if (pct >= 75) return `<span class="status-badge status-warning">▲ Warning</span>`;
        return `<span class="status-badge status-danger">✗ At Risk</span>`;
      }

      function getProgressColor(pct: number) {
        if (pct >= 80) return '#34d399'; // Safe (Emerald)
        if (pct >= 75) return '#fbbf24'; // Warning (Amber)
        return '#f87171'; // Danger (Red)
      }

      // Variables to hold overall stats for the PDF
      let studentOverallPct = 100;
      let studentOverallPresent = 0;
      let studentOverallTotal = 0;

      // Delay render slightly for animation effect
      setTimeout(() => {
        if (role === 'student') {
          // Compute overall attendance
          const now = new Date();
          const year = now.getFullYear(), month = now.getMonth();
          const todayStr = now.toISOString().split('T')[0];
          let present = 0, absent = 0;
          const daysInMonth = new Date(year, month + 1, 0).getDate();
          const presentSet = new Set(studentAttendance.map((a: any) => a.date));

          for (let d = 1; d <= daysInMonth; d++) {
            const cell = new Date(year, month, d);
            const ds = cell.toISOString().split('T')[0];
            if (ds > todayStr) break;
            if (cell.getDay() === 0) continue;
            presentSet.has(ds) ? present++ : absent++;
          }
          const total = present + absent;
          const pct = total > 0 ? Math.round((present / total) * 100) : 100;

          studentOverallPresent = present;
          studentOverallTotal = total;
          studentOverallPct = pct;

          if (!grid) return;
          
          grid.innerHTML = studentCourses.length === 0
            ? `<div class="empty-state">No courses assigned yet.</div>`
            : studentCourses.map((c: any, index: number) => `
                <div class="course-card" style="animation-delay: ${index * 0.1}s">
                  <div class="card-accent-line"></div>
                  <div class="card-header">
                    <div>
                      <h3 class="course-title">${c.title}</h3>
                      <div class="course-meta">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                        Enrolled Course
                      </div>
                    </div>
                    ${getStatusBadge(pct)}
                  </div>
                  
                  <div class="stats-row">
                    <div class="stat-item">
                      <span class="stat-value">${present}</span>
                      <span class="stat-label">Days Present</span>
                    </div>
                    <div class="stat-item" style="align-items: flex-end;">
                      <span class="stat-value" style="color: rgba(255,255,255,0.3);">${total}</span>
                      <span class="stat-label">Total Days</span>
                    </div>
                  </div>

                  <div class="progress-container">
                    <div class="progress-header">
                      <span class="stat-label">Attendance Rate</span>
                      <span style="font-family: 'Syne'; font-weight: 800; font-size: 14px; color: white;">${pct}%</span>
                    </div>
                    <div class="progress-bar-bg">
                      <div class="progress-bar-fg" style="width:${pct}%; background: ${getProgressColor(pct)}; box-shadow: 0 0 10px ${getProgressColor(pct)}80;"></div>
                    </div>
                  </div>
                </div>`).join('');

        } else {
          // Teacher view
          const titleEl = document.getElementById('page-title');
          const subtitleEl = document.getElementById('page-subtitle');
          if (titleEl) titleEl.textContent = 'My Courses';
          if (subtitleEl) subtitleEl.textContent = 'Courses you teach and active enrollments';

          if (!grid) return;

          grid.innerHTML = teacherCourses.length === 0
            ? `<div class="empty-state">No courses assigned to you.</div>`
            : teacherCourses.map((c: any, index: number) => {
                const count = allEnrollments.filter((e: any) => e.course_id === c.id).length;
                return `
                  <div class="course-card" style="animation-delay: ${index * 0.1}s">
                    <div class="card-accent-line"></div>
                    <div class="card-header">
                      <div>
                        <h3 class="course-title">${c.title}</h3>
                        <div class="course-meta">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                          Teacher Dashboard
                        </div>
                      </div>
                      <span class="status-badge status-active">● Active</span>
                    </div>
                    
                    <div class="stats-row" style="border-bottom: none; padding-bottom: 0;">
                      <div class="stat-item">
                        <span class="stat-value">${count}</span>
                        <span class="stat-label">${count === 1 ? 'Enrolled Student' : 'Enrolled Students'}</span>
                      </div>
                    </div>
                  </div>`;
              }).join('');
        }
      }, 100);

      // Download PDF
      // ensure we only bind once or replace if possible. But astro:page-load handles cleanup automatically for some things, 
      // Actually we'll just bind. 
      const dlBtn = document.getElementById('download-btn');
      if (dlBtn) {
        // remove old listener if any by cloning
        const newDlBtn = dlBtn.cloneNode(true);
        dlBtn.parentNode?.replaceChild(newDlBtn, dlBtn);
        
        newDlBtn.addEventListener('click', () => {
          const doc = new jsPDF();
          let head = [];
          let body = [];
          let title = "";

          if (role === 'student') {
            title = "Student Attendance Report";
            head = [['Course Title', 'Present Days', 'Total Days', 'Percentage']];
            // Populate table
            body = studentCourses.map((c: any) => [c.title, String(studentOverallPresent), String(studentOverallTotal), `${studentOverallPct}%`]);
          } else {
            title = "Teacher Courses Report";
            head = [['Course Title', 'Enrolled Students']];
            body = teacherCourses.map((c: any) => [c.title, String(allEnrollments.filter((e: any) => e.course_id === c.id).length)]);
          }

          // Add Title
          doc.setFontSize(22);
          doc.setTextColor(40);
          doc.text(title, 14, 22);

          // Add Metadata
          doc.setFontSize(11);
          doc.setTextColor(100);
          doc.text(`Generated on: ${new Date().toLocaleDateString()}`, 14, 32);
          doc.text(`User: ${currentUser.name} (${currentUser.email})`, 14, 38);

          // Add Table
          autoTable(doc, {
            startY: 45,
            head: head,
            body: body,
            theme: 'grid',
            headStyles: { fillColor: [59, 130, 246] }, // blue-500
            styles: { font: 'helvetica', fontSize: 10 },
          });

          doc.save(`BCI_Report_${new Date().toISOString().split('T')[0]}.pdf`);
        });
      }
    });
  </script>

</DashboardLayout>
