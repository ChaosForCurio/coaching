---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../utils/auth';

// ─── Auth Guard ────────────────────────────────────────────────────────────
const currentUser = await requireAuth(Astro.cookies);
if (!currentUser) { 
  Astro.cookies.delete('userSession'); 
  return Astro.redirect('/login'); 
}

const role = currentUser.role;

// We will fetch the stats asynchronously on the client using the new API
// to demonstrate an API-first approach and keep initial page load instant.
---

  <DashboardLayout
  title="Overview — BCI Dashboard"
  description="Your attendance overview and quick stats at Bhavya Career Institute."
  currentUser={currentUser}
  activePage="overview"
>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h2 class="page-title" id="page-greeting">Good morning! 👋</h2>
      <p class="page-subtitle" id="page-subtitle">Loading your overview...</p>
    </div>
    <div class="date-badge">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
      <span id="today-date">—</span>
    </div>
  </div>

  <!-- Alert Banner -->
  <div id="alert-banner" class="alert-banner hidden">
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    <span id="alert-banner-text">⚠️ Your overall attendance is below 75%.</span>
    <button class="alert-close" aria-label="Close" onclick="this.closest('.alert-banner').classList.add('hidden')">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Stats Grid -->
  <section id="overview" class="section">
    <div class="stats-grid">

      <!-- Attendance Ring Card -->
      <div class="stat-card stat-card-main">
        <div class="stat-main-inner">
          <div class="ring-container">
            <svg class="ring-svg" viewBox="0 0 120 120">
              <defs>
                <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#3b82f6" />
                  <stop offset="50%" stop-color="#8b5cf6" />
                  <stop offset="100%" stop-color="#ec4899" />
                </linearGradient>
              </defs>
              <circle class="ring-bg" cx="60" cy="60" r="50" />
              <circle id="ring-fg" class="ring-fg" cx="60" cy="60" r="50"
                stroke-dasharray="314"
                stroke-dashoffset="314"
              />
            </svg>
            <div class="ring-label">
              <span class="ring-percent" id="ring-percent"><span class="skeleton-box" style="width: 60px; height: 32px;"></span></span>
              <span class="ring-sub" id="ring-sub-label">Loading</span>
            </div>
          </div>
          <div class="ring-meta">
            <p class="ring-meta-title" id="ring-meta-title">Attendance Summary</p>
            <p class="ring-meta-sub" id="ring-meta-sub">This Month</p>
            <div class="ring-meta-stats" id="ring-stats-container">
              <div class="ring-meta-item">
                <span class="dot dot-present"></span>
                <span class="meta-label" id="label-stat-1">Present</span>
                <span class="meta-value" id="stat-present"><span class="skeleton-box" style="width: 24px; height: 16px;"></span></span>
              </div>
              <div class="ring-meta-item">
                <span class="dot dot-absent"></span>
                <span class="meta-label" id="label-stat-2">Absent</span>
                <span class="meta-value" id="stat-absent"><span class="skeleton-box" style="width: 24px; height: 16px;"></span></span>
              </div>
              <div class="ring-meta-item">
                <span class="dot dot-holiday"></span>
                <span class="meta-label" id="label-stat-3">Holidays</span>
                <span class="meta-value" id="stat-holiday"><span class="skeleton-box" style="width: 24px; height: 16px;"></span></span>
              </div>
              <div class="ring-meta-item border-t border-white/6 pt-2 mt-1">
                <span class="meta-label" id="label-stat-4">Total</span>
                <span class="meta-value" id="stat-total"><span class="skeleton-box" style="width: 24px; height: 16px;"></span></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Stat 1 -->
      <div class="stat-card stat-card-sm">
        <div class="stat-icon-wrap" id="card-1-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <p class="stat-sm-label" id="card-1-label"><span class="skeleton-box" style="width: 80px; height: 12px; margin-bottom: 8px;"></span></p>
          <p class="stat-sm-value" id="card-1-value"><span class="skeleton-box" style="width: 48px; height: 32px; margin-bottom: 4px;"></span></p>
          <p class="stat-sm-sub" id="card-1-sub"><span class="skeleton-box" style="width: 100px; height: 12px;"></span></p>
        </div>
      </div>

      <!-- Quick Stat 2 -->
      <div class="stat-card stat-card-sm">
        <div class="stat-icon-wrap" id="card-2-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <div>
          <p class="stat-sm-label" id="card-2-label"><span class="skeleton-box" style="width: 80px; height: 12px; margin-bottom: 8px;"></span></p>
          <p class="stat-sm-value" id="card-2-value"><span class="skeleton-box" style="width: 48px; height: 32px; margin-bottom: 4px;"></span></p>
          <p class="stat-sm-sub" id="card-2-sub"><span class="skeleton-box" style="width: 100px; height: 12px;"></span></p>
        </div>
      </div>

      <!-- Quick Stat 3 -->
      <div class="stat-card stat-card-sm">
        <div class="stat-icon-wrap" id="card-3-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <p class="stat-sm-label" id="card-3-label"><span class="skeleton-box" style="width: 80px; height: 12px; margin-bottom: 8px;"></span></p>
          <p class="stat-sm-value" id="card-3-value"><span class="skeleton-box" style="width: 48px; height: 32px; margin-bottom: 4px;"></span></p>
          <p class="stat-sm-sub" id="card-3-sub"><span class="skeleton-box" style="width: 100px; height: 12px;"></span></p>
        </div>
      </div>

    </div>
  </section>

  <!-- Teacher Insights (Hidden by default, shown for TEACHER via JS) -->
  <section id="teacher-insights" class="section hidden">
    <div class="section-header">
      <h3 class="section-title">Teacher Insights</h3>
    </div>
    <div class="insights-grid">
      <!-- Chart -->
      <div class="insight-card chart-card">
        <p class="insight-title">Attendance Trends (Last 30 Days)</p>
        <div class="chart-container">
          <canvas id="attendanceChart"></canvas>
        </div>
      </div>
      <!-- Right Column -->
      <div class="insight-col">
        <!-- Students at Risk -->
        <div class="insight-card risk-card">
          <p class="insight-title" style="color: #f87171;">Students at Risk</p>
          <ul id="risk-list" class="risk-list">
            <li style="color: rgba(255,255,255,0.5); font-size: 14px;">Loading...</li>
          </ul>
        </div>
        <!-- Recent Activity Feed -->
        <div class="insight-card feed-card">
          <p class="insight-title">Recent Activity</p>
          <ul id="activity-feed" class="feed-list">
             <li style="color: rgba(255,255,255,0.5); font-size: 14px;">Loading...</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Links Section -->
  <section class="section">
    <div class="section-header">
      <h3 class="section-title">Quick Actions</h3>
    </div>
    <div class="quick-links-grid">
      <a href="/dashboard/profile/" class="quick-link-card">
        <div class="ql-icon" style="background: rgba(167,139,250,0.1); border-color: rgba(167,139,250,0.2);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div>
          <p class="ql-title">My Profile</p>
          <p class="ql-sub">View your account info</p>
        </div>
        <svg class="ql-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a href="/dashboard/courses/" class="quick-link-card">
        <div class="ql-icon" style="background: rgba(251,191,36,0.1); border-color: rgba(251,191,36,0.2);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <div>
          <p class="ql-title">Courses</p>
          <p class="ql-sub" id="ql-courses-sub">View attendance breakdown</p>
        </div>
        <svg class="ql-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      {role === 'STUDENT' && (
        <a href="/dashboard/calendar/" class="quick-link-card">
          <div class="ql-icon" style="background: rgba(52,211,153,0.1); border-color: rgba(52,211,153,0.2);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <p class="ql-title">Calendar</p>
            <p class="ql-sub">Monthly attendance view</p>
          </div>
          <svg class="ql-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      )}
      {role === 'TEACHER' && (
        <>
          <a href="/dashboard/mark/" class="quick-link-card">
            <div class="ql-icon" style="background: rgba(248,113,113,0.1); border-color: rgba(248,113,113,0.2);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <div>
              <p class="ql-title">Mark Attendance</p>
              <p class="ql-sub">Record today's attendance</p>
            </div>
            <svg class="ql-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/dashboard/assign/" class="quick-link-card">
            <div class="ql-icon" style="background: rgba(167,139,250,0.1); border-color: rgba(167,139,250,0.2);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <div>
              <p class="ql-title">Assign Course</p>
              <p class="ql-sub">Enroll a student to a course</p>
            </div>
            <svg class="ql-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </>
      )}
    </div>
  </section>

  <style>
    /* ─── Page Header ───────────────────────── */
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }
    .skeleton-box {
      animation: shimmer 2s infinite linear;
      background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.03) 75%);
      background-size: 1000px 100%;
      border-radius: 8px;
      display: inline-block;
    }
    .page-header {
      display: flex; align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 40px; flex-wrap: wrap; gap: 20px;
    }
    .page-title {
      font-family: 'Syne', sans-serif; font-size: 28px;
      font-weight: 800; color: white; letter-spacing: -0.04em; margin: 0;
    }
    .page-subtitle {
      font-family: 'Outfit', sans-serif; font-size: 14px;
      color: rgba(255,255,255,0.5); margin: 6px 0 0;
    }
    .date-badge {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 16px; border-radius: 12px;
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 500;
      color: rgba(255,255,255,0.7);
    }

    /* ─── Alert Banner ──────────────────────── */
    .alert-banner {
      display: flex; align-items: center; gap: 12px;
      padding: 16px 20px; border-radius: 16px;
      background: linear-gradient(90deg, rgba(245,158,11,0.1), rgba(245,158,11,0.02));
      border: 1px solid rgba(245,158,11,0.2); color: #fbbf24;
      font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 500;
      margin-bottom: 32px;
    }
    .alert-banner.hidden { display: none; }
    .alert-close {
      background: none; border: none; color: inherit; opacity: 0.6;
      cursor: pointer; margin-left: auto; padding: 4px; border-radius: 6px;
      transition: all 0.2s;
    }
    .alert-close:hover { opacity: 1; background: rgba(245,158,11,0.1); }

    /* ─── Section ───────────────────────────── */
    .section { margin-bottom: 48px; }
    .section-header {
      display: flex; align-items: center;
      justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;
    }
    .section-title {
      font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800;
      color: rgba(255,255,255,0.95); margin: 0; letter-spacing: -0.02em;
      display: flex; align-items: center; gap: 8px;
    }
    .section-title::before {
      content: ''; display: block; width: 4px; height: 18px;
      background: white; border-radius: 4px;
    }

    /* ─── Stats grid ────────────────────────── */
    .stats-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto; gap: 24px;
    }
    @media (min-width: 1024px) { .stats-grid { grid-template-columns: 2fr 1fr 1fr 1fr; grid-template-rows: 1fr; } }
    @media (max-width: 640px) { 
      .stats-grid { grid-template-columns: 1fr; gap: 16px; }
      .stat-card { padding: 20px; }
      .stat-main-inner { gap: 20px; justify-content: center; }
      .ring-meta { min-width: 100%; text-align: center; }
      .ring-meta-item { justify-content: center; }
    }

    /* ─── Stat Cards ────────────────────────── */
    .stat-card {
      background: rgba(255, 255, 255, 0.02); 
      border: 1px solid rgba(255, 255, 255, 0.05); 
      border-radius: 24px;
      padding: 28px; 
      backdrop-filter: blur(12px);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative; 
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    .stat-card::before {
      content: ''; 
      position: absolute; 
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      opacity: 0.5;
    }
    .stat-card:hover { 
      border-color: rgba(255, 255, 255, 0.15); 
      transform: translateY(-6px); 
      background: rgba(255, 255, 255, 0.04);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }
    .stat-card-main { grid-column: 1 / -1; }
    .stat-card-main::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, #3b82f6, #8b5cf6, #ec4899);
      opacity: 0.8;
    }
    @media (min-width: 1024px) { .stat-card-main { grid-column: span 1; } }

    /* ─── Ring ──────────────────────────────── */
    .stat-main-inner { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
    .ring-container { position: relative; width: 130px; height: 130px; flex-shrink: 0; }
    .ring-svg { width: 130px; height: 130px; transform: rotate(-90deg); }
    .ring-bg { fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 12; }
    .ring-fg {
      fill: none; stroke: url(#ringGradient); stroke-width: 12; stroke-linecap: round;
      transition: stroke-dashoffset 1.5s cubic-bezier(0.16,1,0.3,1);
      filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.4));
    }
    .ring-label {
      position: absolute; inset: 0; display: flex;
      flex-direction: column; align-items: center; justify-content: center;
    }
    .ring-percent {
      font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 800;
      color: white; line-height: 1; font-variant-numeric: tabular-nums;
    }
    .ring-sub {
      font-family: 'Outfit', sans-serif; font-size: 10px; color: rgba(255,255,255,0.5);
      text-transform: uppercase; letter-spacing: 0.15em; margin-top: 4px;
    }
    .ring-meta { flex: 1; min-width: 180px; }
    .ring-meta-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; color: white; margin: 0 0 4px; }
    .ring-meta-sub { font-family: 'Outfit', sans-serif; font-size: 13px; color: rgba(255,255,255,0.4); margin-bottom: 20px; }
    .ring-meta-stats { display: flex; flex-direction: column; gap: 10px; }
    .ring-meta-item { display: flex; align-items: center; gap: 10px; font-family: 'Outfit', sans-serif; }
    .meta-label { color: rgba(255,255,255,0.6); font-size: 14px; }
    .meta-value { color: white; font-weight: 600; font-size: 14px; margin-left: auto; font-variant-numeric: tabular-nums; }

    /* ─── Dots ──────────────────────────────── */
    .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
    .dot-present  { background: #10b981; box-shadow: 0 0 10px rgba(16,185,129,0.5); }
    .dot-absent   { background: #ef4444; box-shadow: 0 0 10px rgba(239,68,68,0.5); }
    .dot-holiday  { background: #f59e0b; box-shadow: 0 0 10px rgba(245,158,11,0.5); }

    /* ─── Small stat cards ──────────────────── */
    .stat-card-sm { display: flex; flex-direction: column; justify-content: space-between; gap: 16px; }
    .stat-icon-wrap {
      width: 48px; height: 48px; border-radius: 14px; display: flex;
      align-items: center; justify-content: center;
      background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: white;
      box-shadow: inset 0 0 20px rgba(255,255,255,0.02);
    }
    .stat-sm-label { font-family: 'Outfit', sans-serif; font-size: 12px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 6px; }
    .stat-sm-value { font-family: 'Syne', sans-serif; font-size: 32px; font-weight: 800; color: white; margin: 0 0 4px; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
    .stat-sm-sub { font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 500; margin: 0; color: rgba(255,255,255,0.5); }

    /* ─── Quick Links Grid ──────────────────── */
    .quick-links-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;
    }
    .quick-link-card {
      display: flex; align-items: center; gap: 16px;
      padding: 20px 24px; background: #000; border: 1px solid #222;
      border-radius: 18px; text-decoration: none; cursor: pointer;
      transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    .quick-link-card:hover { border-color: #444; transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); }
    .ql-icon {
      width: 44px; height: 44px; border-radius: 12px; border: 1px solid transparent;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ql-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: white; margin: 0 0 3px; }
    .ql-sub { font-family: 'Outfit', sans-serif; font-size: 12px; color: rgba(255,255,255,0.4); margin: 0; }
    .ql-arrow { color: rgba(255,255,255,0.2); margin-left: auto; flex-shrink: 0; transition: transform 0.2s, color 0.2s; }
    .quick-link-card:hover .ql-arrow { transform: translateX(4px); color: rgba(255,255,255,0.7); }

    /* ─── Teacher Insights ──────────────────── */
    .hidden { display: none !important; }
    .insights-grid {
      display: grid; grid-template-columns: 2fr 1fr; gap: 24px;
    }
    @media (max-width: 1024px) { .insights-grid { grid-template-columns: 1fr; } }
    .insight-card {
      background: #000; border: 1px solid #333; border-radius: 24px; padding: 24px;
    }
    .insight-title {
      font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 800; color: white; margin: 0 0 16px; letter-spacing: -0.02em;
    }
    .chart-container { position: relative; height: 260px; width: 100%; }
    .insight-col { display: flex; flex-direction: column; gap: 24px; }
    .risk-list, .feed-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .risk-item { display: flex; justify-content: space-between; font-family: 'Outfit', sans-serif; font-size: 14px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); padding: 12px 16px; border-radius: 14px; }
    .risk-name { color: white; font-weight: 500; }
    .risk-pct { color: #ef4444; font-weight: 800; }
    .feed-item { display: flex; flex-direction: column; gap: 4px; font-family: 'Outfit', sans-serif; font-size: 13px; background: rgba(255,255,255,0.03); padding: 12px 16px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.08); }
    .feed-msg { color: rgba(255,255,255,0.9); }
    .feed-time { color: rgba(255,255,255,0.4); font-size: 11px; }
    .quick-link-card {
      display: flex; align-items: center; gap: 16px;
      padding: 20px 24px; background: #000; border: 1px solid #222;
      border-radius: 18px; text-decoration: none; cursor: pointer;
      transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    .quick-link-card:hover { border-color: #444; transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); }
    .ql-icon {
      width: 44px; height: 44px; border-radius: 12px; border: 1px solid transparent;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ql-title { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: white; margin: 0 0 3px; }
    .ql-sub { font-family: 'Outfit', sans-serif; font-size: 12px; color: rgba(255,255,255,0.4); margin: 0; }
    .ql-arrow { color: rgba(255,255,255,0.2); margin-left: auto; flex-shrink: 0; transition: transform 0.2s, color 0.2s; }
    .quick-link-card:hover .ql-arrow { transform: translateX(4px); color: rgba(255,255,255,0.7); }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Check if we are on the overview page
      const dateEl = document.getElementById('today-date');
      if (!dateEl) return;

      // Setup generic greeting and date
      const hour = new Date().getHours();
      const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
      dateEl.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

      const CIRCUMFERENCE = 2 * Math.PI * 50;
      const ringFg = document.getElementById('ring-fg') as SVGCircleElement | null;

      function setRing(pct: number) {
        if (!ringFg) return;
        const offset = CIRCUMFERENCE - (pct / 100) * CIRCUMFERENCE;
        ringFg.style.strokeDasharray = `${CIRCUMFERENCE}`;
        ringFg.style.strokeDashoffset = `${offset}`;
      }

      // Fetch stats securely via the new API endpoint
      async function loadStats() {
        try {
          const API_URL = import.meta.env.PUBLIC_API_URL || '';
          const res = await fetch(`${API_URL}/api/dashboard/stats`);
          if (!res.ok) throw new Error('Failed to load stats');
          const data = await res.json();
          
          const firstName = data.name.split(' ')[0];
          const greetingEl = document.getElementById('page-greeting');
          if (greetingEl) greetingEl.textContent = `${greeting}, ${firstName}! 👋`;

          if (data.role === 'STUDENT') {
            const subtitleEl = document.getElementById('page-subtitle');
            if (subtitleEl) subtitleEl.textContent = "Here's your attendance overview";
            
            const { percentage, present, absent, holiday, total, streak, enrolledCourses, firstCourseName, recentEnrollments } = data.stats;
            
            const ringPct = document.getElementById('ring-percent');
            if (ringPct) ringPct.textContent = percentage + '%';
            
            const statPres = document.getElementById('stat-present');
            if (statPres) statPres.textContent = String(present);
            
            const statAbs = document.getElementById('stat-absent');
            if (statAbs) statAbs.textContent = String(absent);
            
            const statHol = document.getElementById('stat-holiday');
            if (statHol) statHol.textContent = String(holiday);
            
            const statTot = document.getElementById('stat-total');
            if (statTot) statTot.textContent = String(total);
            
            setRing(percentage);

            if (recentEnrollments && recentEnrollments.length > 0) {
              // Check if it's within the last 24 hours to consider it "recent enough" to show as alert
              const latest = recentEnrollments[0];
              const now = new Date();
              const createdAt = new Date(latest.createdAt);
              const hoursDiff = (now.getTime() - createdAt.getTime()) / (1000 * 60 * 60);

              if (hoursDiff < 48) { // show for 48 hours
                const banner = document.getElementById('alert-banner');
                if (banner) {
                  banner.classList.remove('hidden');
                  // change style to success/info style
                  banner.style.background = 'linear-gradient(90deg, rgba(56,189,248,0.1), rgba(56,189,248,0.02))';
                  banner.style.borderColor = 'rgba(56,189,248,0.2)';
                  banner.style.color = '#38bdf8';
                  const bannerText = document.getElementById('alert-banner-text');
                  if (bannerText) bannerText.innerHTML = `🔔 <strong>New Assignment:</strong> You have been assigned to <em>${latest.courseTitle}</em> by ${latest.teacherName}.`;
                }
              } else if (percentage < 75) {
                const banner = document.getElementById('alert-banner');
                if (banner) {
                  banner.classList.remove('hidden');
                  const bannerText = document.getElementById('alert-banner-text');
                  if (bannerText) bannerText.textContent = `⚠️ Your overall attendance is at ${percentage}%, which is below 75%. Please attend regularly.`;
                }
              }
            } else if (percentage < 75) {
              const banner = document.getElementById('alert-banner');
              if (banner) {
                banner.classList.remove('hidden');
                const bannerText = document.getElementById('alert-banner-text');
                if (bannerText) bannerText.textContent = `⚠️ Your overall attendance is at ${percentage}%, which is below 75%. Please attend regularly.`;
              }
            }

            const c1l = document.getElementById('card-1-label');
            if (c1l) c1l.textContent = 'Present This Month';
            const c1v = document.getElementById('card-1-value');
            if (c1v) c1v.textContent = String(present);
            const c1s = document.getElementById('card-1-sub');
            if (c1s) c1s.textContent = 'Days attended';

            const c2l = document.getElementById('card-2-label');
            if (c2l) c2l.textContent = 'Enrolled Courses';
            const c2v = document.getElementById('card-2-value');
            if (c2v) c2v.textContent = String(enrolledCourses);
            const c2s = document.getElementById('card-2-sub');
            if (c2s) c2s.textContent = firstCourseName;

            const c3l = document.getElementById('card-3-label');
            if (c3l) c3l.textContent = 'Streak';
            const c3v = document.getElementById('card-3-value');
            if (c3v) c3v.textContent = String(streak);
            const c3s = document.getElementById('card-3-sub');
            if (c3s) c3s.textContent = streak > 0 ? '🔥 Keep it up!' : 'Start attending to build a streak!';

          } else if (data.role === 'TEACHER') {
            const subtitleEl = document.getElementById('page-subtitle');
            if (subtitleEl) subtitleEl.textContent = "Here's your class overview";
            
            const { activeCourses, totalStudents, presentToday, absentToday, percentage, allLogsCount } = data.stats;
            
            const ringPct = document.getElementById('ring-percent');
            if (ringPct) ringPct.textContent = percentage + '%';
            
            const ringSub = document.getElementById('ring-sub-label');
            if (ringSub) ringSub.textContent = "Today's Rate";
            
            const metaTitle = document.getElementById('ring-meta-title');
            if (metaTitle) metaTitle.textContent = 'Student Attendance Today';
            
            const metaSub = document.getElementById('ring-meta-sub');
            if (metaSub) metaSub.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
            
            const label1 = document.getElementById('label-stat-1');
            if (label1) label1.textContent = 'Present Today';
            
            const statPres = document.getElementById('stat-present');
            if (statPres) statPres.textContent = String(presentToday);
            
            const label2 = document.getElementById('label-stat-2');
            if (label2) label2.textContent = 'Absent Today';
            
            const statAbs = document.getElementById('stat-absent');
            if (statAbs) statAbs.textContent = String(absentToday);
            
            // Hide holiday stat for teacher view
            const statHol = document.getElementById('stat-holiday');
            if (statHol && statHol.parentElement) statHol.parentElement.style.display = 'none';
            
            const label4 = document.getElementById('label-stat-4');
            if (label4) label4.textContent = 'Total Enrolled';
            
            const statTot = document.getElementById('stat-total');
            if (statTot) statTot.textContent = String(totalStudents);
            
            setRing(percentage);

            const c1l = document.getElementById('card-1-label');
            if (c1l) c1l.textContent = 'Active Courses';
            const c1v = document.getElementById('card-1-value');
            if (c1v) c1v.textContent = String(activeCourses);
            const c1s = document.getElementById('card-1-sub');
            if (c1s) c1s.textContent = 'Courses taught by you';
            const c1i = document.getElementById('card-1-icon');
            if (c1i) c1i.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;

            const c2l = document.getElementById('card-2-label');
            if (c2l) c2l.textContent = 'Student Pool';
            const c2v = document.getElementById('card-2-value');
            if (c2v) c2v.textContent = String(totalStudents);
            const c2s = document.getElementById('card-2-sub');
            if (c2s) c2s.textContent = 'Total enrolled students';
            const c2i = document.getElementById('card-2-icon');
            if (c2i) c2i.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`;

            const c3l = document.getElementById('card-3-label');
            if (c3l) c3l.textContent = 'Attendance Logs';
            const c3v = document.getElementById('card-3-value');
            if (c3v) c3v.textContent = String(allLogsCount);
            const c3s = document.getElementById('card-3-sub');
            if (c3s) c3s.textContent = 'Saved in database';
            const c3i = document.getElementById('card-3-icon');
            if (c3i) c3i.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`;
            
            const insightsSec = document.getElementById('teacher-insights');
            if (insightsSec) insightsSec.classList.remove('hidden');

            // Render Chart
            if (data.stats.chartData) {
              const ctx = document.getElementById('attendanceChart') as HTMLCanvasElement;
              if (ctx && (window as any).Chart) {
                new (window as any).Chart(ctx, {
                  type: 'bar',
                  data: {
                    labels: data.stats.chartData.labels,
                    datasets: [{
                      label: 'Present Students',
                      data: data.stats.chartData.data,
                      backgroundColor: 'rgba(167, 139, 250, 0.6)',
                      borderColor: 'rgba(167, 139, 250, 1)',
                      borderWidth: 1,
                      borderRadius: 4,
                    }]
                  },
                  options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                      y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: 'rgba(255,255,255,0.5)' } },
                      x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.5)' } }
                    },
                    plugins: { legend: { display: false } }
                  }
                });
              }
            }

            // Render Risk List
            const riskList = document.getElementById('risk-list');
            if (riskList && data.stats.studentsAtRisk) {
              if (data.stats.studentsAtRisk.length === 0) {
                 riskList.innerHTML = '<li style="color: rgba(255,255,255,0.5); font-size: 14px;">No students at risk.</li>';
              } else {
                 riskList.innerHTML = data.stats.studentsAtRisk.map((s: any) => `
                   <li class="risk-item">
                     <span class="risk-name">${s.name}</span>
                     <span class="risk-pct">${s.percentage}%</span>
                   </li>
                 `).join('');
              }
            }

            // Render Activity Feed
            const feedList = document.getElementById('activity-feed');
            if (feedList && data.stats.recentActivity) {
              if (data.stats.recentActivity.length === 0) {
                 feedList.innerHTML = '<li style="color: rgba(255,255,255,0.5); font-size: 14px;">No recent activity.</li>';
              } else {
                 feedList.innerHTML = data.stats.recentActivity.map((a: any) => `
                   <li class="feed-item">
                     <span class="feed-msg">${a.message}</span>
                     <span class="feed-time">${new Date(a.date).toLocaleString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
                   </li>
                 `).join('');
              }
            }
          }
        } catch (e) {
          console.error('Error fetching dashboard stats:', e);
          const subtitle = document.getElementById('page-subtitle');
          if (subtitle) subtitle.textContent = "Failed to load overview. Please refresh.";
          
          const banner = document.getElementById('alert-banner');
          if (banner) {
            banner.classList.remove('hidden');
            banner.style.background = 'linear-gradient(90deg, rgba(239,68,68,0.1), rgba(239,68,68,0.02))';
            banner.style.borderColor = 'rgba(239,68,68,0.2)';
            banner.style.color = '#ef4444';
            
            const bannerText = document.getElementById('alert-banner-text');
            if (bannerText) bannerText.textContent = "⚠️ An error occurred while loading your data.";
          }
        }
      }

      // Initialize
      loadStats();
    });
  </script>
</DashboardLayout>
