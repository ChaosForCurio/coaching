---
// src/pages/dashboard/index.astro
// Central dashboard router - Server-side redirect
import { requireAuth, getSessionUID } from '../../utils/auth';

const uid = await getSessionUID(Astro.cookies);
if (!uid) {
  return Astro.redirect('/login');
}

const currentUser = await requireAuth(Astro.cookies);
if (currentUser) {
  if (currentUser.role === 'TEACHER') {
    return Astro.redirect('/teacher/dashboard');
  } else {
    return Astro.redirect('/student/dashboard');
  }
} else {
  // We have a valid Firebase session but no DB profile.
  // Redirect to login with error so it can auto-recover or prompt user.
  return Astro.redirect('/login?error=profile_failed');
}
---

