---
export const prerender = true;
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': 'https://www.bhavyacomputerclasses.com/contact',
      name: 'Contact Bhavya Career Institute',
      url: 'https://www.bhavyacomputerclasses.com/contact',
      description:
        'Get in touch with Bhavya Career Institute in Kota for course enquiries, admissions, and free demo classes.',
      mainEntity: {
        '@type': 'LocalBusiness',
        name: 'Bhavya Career Institute',
        telephone: ['+919694932391', '+919694025249'],
        address: {
          '@type': 'PostalAddress',
          streetAddress:
            '3-N-25, Mahaveer Nagar Extension, Near Ganesh Ji Mandir',
          addressLocality: 'Kota',
          addressRegion: 'Rajasthan',
          postalCode: '324005',
          addressCountry: 'IN',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.bhavyacomputerclasses.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Contact',
          item: 'https://www.bhavyacomputerclasses.com/contact',
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Contact Us | Bhavya Career Institute — Kota, Rajasthan"
      description="Get in touch with Bhavya Career Institute in Kota. Call +91 96949 32391 or WhatsApp us to enquire about DCA, Tally, Python, Web Development, RSCIT courses and free demo classes."
      canonical="https://www.bhavyacomputerclasses.com/contact"
      schema={contactSchema}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main id="msbif-contact" class="w-full pt-20" aria-label="Contact Bhavya Career Institute">

      <!-- ============================================
           HERO SECTION (MSBIF NAVY GRADIENT HERO)
           ============================================ -->
      <section class="relative py-20 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <nav class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[1.5px] text-white/70 bg-white/[0.07] border border-white/15 px-5 py-2 rounded-full mb-6" aria-label="Breadcrumb">
            <a href="/" class="text-[#F4B51B] hover:text-white transition-colors">Home</a>
            <span class="text-white/40">›</span>
            <span>Contact Us</span>
          </nav>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-4 text-white font-['Poppins']">
            Contact Us
          </h1>

          <p class="font-['Noto_Sans_Devanagari'] text-base sm:text-lg text-white/85 max-w-2xl leading-relaxed">
            कोर्स संबंधी जानकारी, फ्री डेमो क्लास या प्रवेश के लिए हमसे सीधे संपर्क करें — हम आपकी सहायता के लिए सदैव तत्पर हैं।
          </p>

          <!-- Free Demo Banner -->
          <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-xs font-medium text-white/90">
            <span class="text-sm">🎓</span>
            <span>निःशुल्क डेमो क्लास उपलब्ध — कॉल या व्हाट्सएप द्वारा सीट आरक्षित करें।</span>
          </div>
        </div>
      </section>

      <!-- ============================================
           CONTACT GRID: 3 HIGHLIGHT CARDS (MSBIF STYLE)
           ============================================ -->
      <section class="py-16 md:py-20 bg-white border-b border-[#082B63]/[0.06]">
        <div class="max-w-[1200px] mx-auto px-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 -mt-24 relative z-20">
            
            <!-- Card 1: Direct Call -->
            <a href="tel:+919694932391" class="bg-white rounded-2xl p-8 border border-[#082B63]/[0.08] shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all relative overflow-hidden group flex flex-col items-center text-center">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0757A8] to-[#1677C8]"></div>
              <div class="w-16 h-16 rounded-2xl bg-[#0757A8]/[0.08] text-[#0757A8] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] font-['Poppins'] mb-1">Direct Call</h3>
              <p class="text-xs text-[#6B7A90] font-['Poppins'] mb-3">Speak directly with our academic advisor</p>
              <p class="text-base font-bold text-[#0757A8] font-['Poppins']">+91 96949 32391</p>
              <p class="text-xs text-[#4A5568] mt-0.5">+91 96940 25249</p>
              <span class="mt-4 text-xs font-semibold text-[#0757A8] bg-[#0757A8]/[0.08] px-3.5 py-1 rounded-full">Mon – Sat: 9 AM – 7 PM</span>
            </a>

            <!-- Card 2: WhatsApp Chat -->
            <a href="https://wa.me/919694932391" target="_blank" rel="noopener noreferrer" class="bg-white rounded-2xl p-8 border border-[#082B63]/[0.08] shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all relative overflow-hidden group flex flex-col items-center text-center">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#25D366] to-[#128C7E]"></div>
              <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.458L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.528 2.01 14.069.987 11.48.987 6.045.987 1.62 5.357 1.616 10.787c-.001 1.748.47 3.447 1.36 4.966l-1.001 3.655 3.748-.973l.334.218zM18.82 15.111c-.37-.185-2.18-.897-2.52-1.021-.34-.124-.588-.185-.836.186-.248.37-.958 1.206-1.17 1.454-.216.247-.433.279-.803.093-.37-.185-1.56-.57-2.971-1.829-1.09-.973-1.826-2.176-2.04-2.547-.217-.37-.023-.57.162-.754.166-.165.37-.432.556-.65.186-.216.248-.37.372-.617.124-.247.062-.463-.03-.649-.093-.185-.837-2.006-1.146-2.748-.3-.721-.606-.624-.836-.636-.216-.011-.463-.014-.71-.014-.248 0-.65.093-.99.463-.34.37-1.3 1.266-1.3 3.087 0 1.82 1.33 3.582 1.516 3.829.186.247 2.612 3.987 6.326 5.586.883.38 1.572.607 2.11.779.887.282 1.696.242 2.335.146.711-.107 2.18-.89 2.49-1.752.31-.862.31-1.603.217-1.752-.093-.149-.34-.241-.71-.426z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] font-['Poppins'] mb-1">WhatsApp Chat</h3>
              <p class="text-xs text-[#6B7A90] font-['Poppins'] mb-3">Fastest response · Usually in minutes</p>
              <p class="text-base font-bold text-emerald-600 font-['Poppins']">Chat on WhatsApp</p>
              <p class="text-xs text-[#4A5568] mt-0.5">Quick course brochure &amp; fee structure</p>
              <span class="mt-4 text-xs font-semibold text-emerald-700 bg-emerald-50 px-3.5 py-1 rounded-full">Available Anytime</span>
            </a>

            <!-- Card 3: Campus Location -->
            <a href="https://maps.google.com/?q=Mahaveer+Nagar+Extension+Kota+Rajasthan" target="_blank" rel="noopener noreferrer" class="bg-white rounded-2xl p-8 border border-[#082B63]/[0.08] shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all relative overflow-hidden group flex flex-col items-center text-center">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#F39A18] to-[#F4B51B]"></div>
              <div class="w-16 h-16 rounded-2xl bg-[#F39A18]/[0.1] text-[#F39A18] flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] font-['Poppins'] mb-1">Campus Visit</h3>
              <p class="text-xs text-[#6B7A90] font-['Poppins'] mb-3">Visit our modern lab in Kota</p>
              <p class="text-sm font-semibold text-[#082B63]">3-N-25, Mahaveer Nagar Extn.</p>
              <p class="text-xs text-[#4A5568] mt-0.5">Near Ganesh Ji Mandir, Kota 324005</p>
              <span class="mt-4 text-xs font-semibold text-[#F39A18] bg-[#F39A18]/[0.1] px-3.5 py-1 rounded-full">Open in Google Maps ›</span>
            </a>

          </div>
        </div>
      </section>

      <!-- ============================================
           MAIN FORM & INSTITUTE DETAILS (MSBIF FORM SECTION)
           ============================================ -->
      <section class="py-20 md:py-28 bg-[#F8FAFD] border-b border-[#082B63]/[0.06]">
        <div class="max-w-[1200px] mx-auto px-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <!-- Address & Institute Details -->
            <div class="lg:col-span-12 grid grid-cols-1 md:grid-cols-3 gap-8">
              
              <!-- Address Details -->
              <div class="bg-white rounded-3xl p-8 border border-[#082B63]/[0.08] shadow-md relative pl-8 before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#0757A8] before:rounded-l-3xl">
                <span class="text-xs font-bold uppercase tracking-wider text-[#0757A8] block mb-2 font-['Poppins']">Main Campus</span>
                <h3 class="text-lg font-bold text-[#082B63] mb-2 font-['Poppins']">Bhavya Career Institute</h3>
                <p class="text-sm text-[#4A5568] leading-relaxed font-['Noto_Sans_Devanagari'] mb-4">
                  3-N-25, महावीर नगर एक्सटेंशन, गणेश जी मंदिर के पास, कोटा, राजस्थान — 324005
                </p>
                <div class="pt-4 border-t border-[#082B63]/[0.08] text-xs text-[#6B7A90]">
                  <strong>Landmark:</strong> Near Ganesh Ji Mandir &middot; Easily accessible by city auto &amp; public transport.
                </div>
              </div>

              <!-- Timings Card -->
              <div class="bg-white rounded-3xl p-8 border border-[#082B63]/[0.08] shadow-md relative pl-8 before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#F39A18] before:rounded-l-3xl">
                <span class="text-xs font-bold uppercase tracking-wider text-[#F39A18] block mb-2 font-['Poppins']">Operating Hours</span>
                <h3 class="text-lg font-bold text-[#082B63] mb-4 font-['Poppins']">संस्थान का समय</h3>
                <div class="space-y-2.5 text-sm">
                  <div class="flex justify-between items-center py-1 border-b border-black/5">
                    <span class="text-[#4A5568]">Monday – Saturday</span>
                    <strong class="text-[#082B63]">9:00 AM – 7:00 PM</strong>
                  </div>
                  <div class="flex justify-between items-center py-1 border-b border-black/5">
                    <span class="text-[#4A5568]">Silent Library Hours</span>
                    <strong class="text-[#082B63]">8:00 AM – 8:00 PM</strong>
                  </div>
                  <div class="flex justify-between items-center py-1 text-xs">
                    <span class="text-[#8899AA]">Sunday</span>
                    <span class="text-amber-600 font-semibold">Online Support Active</span>
                  </div>
                </div>
              </div>

              <!-- Fast Contact Badges -->
              <div class="bg-gradient-to-br from-[#082B63] to-[#0a3572] rounded-3xl p-7 text-white shadow-md flex flex-col justify-between">
                <div>
                  <h4 class="font-bold text-base mb-2 font-['Poppins']">Quick Assistance:</h4>
                  <p class="text-xs text-white/80 leading-relaxed mb-4 font-['Noto_Sans_Devanagari']">
                    किसी भी पाठ्यक्रम की फीस, अवधि या नए बैच की तारीख के लिए हमें सीधे कॉल करें।
                  </p>
                </div>
                <div class="flex flex-col gap-2 pt-2">
                  <a href="tel:+919694932391" class="inline-flex items-center gap-2 text-sm font-semibold text-[#F4B51B] hover:underline">
                    <span>📞</span> +91 96949 32391 (Admission Desk)
                  </a>
                  <a href="tel:+919694025249" class="inline-flex items-center gap-2 text-sm font-semibold text-white/90 hover:underline">
                    <span>📞</span> +91 96940 25249 (Help Desk)
                  </a>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- ============================================
           GOOGLE MAP EMBED (MSBIF EMBED STYLE)
           ============================================ -->
      <section class="py-16 md:py-20 bg-white border-b border-[#082B63]/[0.06]">
        <div class="max-w-[1200px] mx-auto px-6">
          <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="inline-block font-['Poppins'] text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-3">
              Location Map
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#082B63] font-['Poppins'] mb-2">
              हमारा पता व मैप (Locate Us in Kota)
            </h2>
            <p class="text-sm text-[#6B7A90]">Visit us in Mahaveer Nagar Extension, Kota</p>
          </div>

          <div class="rounded-3xl overflow-hidden border-2 border-[#082B63]/10 shadow-xl h-[420px]">
            <iframe
              title="Bhavya Career Institute Location in Kota"
              src="https://maps.google.com/maps?q=Mahaveer+Nagar+Extension+Kota+Rajasthan&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </section>

      <!-- ============================================
           CTA BANNER (MSBIF SOLID NAVY CTA)
           ============================================ -->
      <section class="py-16 md:py-20 bg-[#082B63] text-white text-center relative overflow-hidden">
        <div class="pointer-events-none absolute -top-16 -right-16 w-60 h-60 rounded-full bg-[#F39A18]/10"></div>
        <div class="pointer-events-none absolute -bottom-20 -left-10 w-52 h-52 rounded-full bg-[#F4B51B]/10"></div>

        <div class="max-w-3xl mx-auto px-6 relative z-10">
          <h2 class="text-2xl sm:text-4xl font-bold font-['Noto_Sans_Devanagari'] leading-snug mb-4">
            आज ही अपने करियर को नई दिशा दें।
          </h2>
          <p class="text-white/80 text-sm sm:text-base mb-8 max-w-xl mx-auto font-['Noto_Sans_Devanagari'] leading-relaxed">
            हमारे अनुभवी प्रशिक्षकों से मार्गदर्शन प्राप्त करें और व्यावहारिक कंप्यूटर कौशल सीखकर अपने भविष्य को उज्ज्वल बनाएं।
          </p>

          <div class="flex flex-wrap gap-4 justify-center">
            <a href="https://wa.me/919694932391" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-[#F39A18] text-white font-['Poppins'] font-semibold text-sm hover:bg-[#e08a10] transition-all transform hover:-translate-y-0.5 shadow-lg shadow-[#F39A18]/25">
              WhatsApp Now: +91 96949 32391
            </a>
            <a href="/all-courses" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full border-2 border-white/60 text-white font-['Poppins'] font-semibold text-sm hover:bg-white hover:text-[#082B63] transition-all transform hover:-translate-y-0.5">
              View All Courses
            </a>
          </div>
        </div>
      </section>

    </main>

    <Footer />
    <WhatsAppFloat />
  </body>
</html>
