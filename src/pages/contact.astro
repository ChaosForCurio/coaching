---
export const prerender = true;
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Cursor from '../components/Cursor.astro';
import Navbar from '../components/Navbar.astro';
import ContactSection from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': 'https://www.bhavyacomputerclasses.com/contact',
      name: 'Contact Bhavya Computer Classes',
      url: 'https://www.bhavyacomputerclasses.com/contact',
      description:
        'Get in touch with Bhavya Computer Classes in Kota for course enquiries, admissions, and support.',
      mainEntity: {
        '@type': 'LocalBusiness',
        name: 'Bhavya Computer Classes',
        telephone: ['+919694932391', '+919694025249'],
        address: {
          '@type': 'PostalAddress',
          streetAddress:
            '3-N-25, Mahaveer Nagar Extension, Near Ganesh Ji Mandir',
          addressLocality: 'Kota',
          addressRegion: 'Rajasthan',
          postalCode: '324005',
          addressCountry: 'IN',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.bhavyacomputerclasses.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Contact',
          item: 'https://www.bhavyacomputerclasses.com/contact',
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="Contact Us | Bhavya Computer Classes — Kota, Rajasthan"
      description="Get in touch with Bhavya Computer Classes in Kota. Call +91 96949 32391, WhatsApp us, or fill out our form to enquire about DCA, Tally, Python, Web Development, RSCIT courses and free demo classes."
      canonical="https://www.bhavyacomputerclasses.com/contact"
      schema={contactSchema}
    />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />

    <main class="w-full pt-24">
      <ContactSection />
    </main>

    <Footer />

    <script>
      import { initReveal } from '../scripts/reveal';

      document.addEventListener('DOMContentLoaded', () => {
        initReveal();
      });
    </script>
  </body>
</html>
