            <div class="bg-white p-7 rounded-2xl border border-[#082B63]/[0.07] relative shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#F39A18] before:rounded-l-2xl">
