---
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Cursor from '../components/Cursor.astro';
import Navbar from '../components/Navbar.astro';
import Methodology from '../components/Methodology.astro';
import FacultyTeam from '../components/FacultyTeam.astro';
import Reviews from '../components/Reviews.astro';
import Footer from '../components/Footer.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://coaching-ts8v.onrender.com/" },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": "https://coaching-ts8v.onrender.com/about-us" }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="About Us | Bhavya Career Institute — Computer Training in Kota"
      description="Learn about Bhavya Career Institute — Kota's trusted computer training center since 2010. Meet our expert faculty, discover our teaching methodology, and read real student reviews."
      canonical="https://coaching-ts8v.onrender.com/about-us"
      schema={breadcrumbSchema}
    />
  </head>
  <body class="bg-[#0a0a0a] text-white overflow-x-hidden selection:bg-white/20">
    <Cursor />
    <Navbar />

    <main class="w-full pt-24">
      <Methodology />
      <FacultyTeam />
      <Reviews />
    </main>

    <Footer />

    <script>
      import { initReveal } from '../scripts/reveal';
      
      document.addEventListener('DOMContentLoaded', () => {
        initReveal();
      });
    </script>
  </body>
</html>
