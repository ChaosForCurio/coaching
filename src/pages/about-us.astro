---
export const prerender = true;

import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { Image } from 'astro:assets';
import facultyClassroomImg from '../../public/images/faculty-classroom.jpg';
import libraryClassroomImg from '../../public/images/library-classroom.jpg';
import { getOptimizedImageUrl } from '../utils/cloudinary';

const classroomOptimized = getOptimizedImageUrl('/images/classroom.png', {
  width: 900,
  quality: 'auto',
  format: 'auto',
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.bhavyacomputerclasses.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About Us',
      item: 'https://www.bhavyacomputerclasses.com/about-us',
    },
  ],
};

import instructorsData from '../data/instructors.json';

const facultyList = instructorsData.map((f) => ({
  ...f,
  experience: f.experience.includes('Experience') ? f.experience : `${f.experience} Experience`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title="About Us | Bhavya Career Institute — Computer Training in Kota"
      description="Learn about Bhavya Career Institute — Kota's trusted computer training center since 2010. Meet our expert faculty, discover our mission, values, and modern lab facilities."
      canonical="https://www.bhavyacomputerclasses.com/about-us"
      schema={breadcrumbSchema}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFD] text-[#172033] overflow-x-hidden selection:bg-[#F39A18]/20">
    <Navbar />

    <main id="msbif-about" class="w-full pt-20" aria-label="About Bhavya Career Institute">

      <!-- ============================================
           PAGE HERO (MSBIF NAVY GRADIENT STYLE)
           ============================================ -->
      <section class="msbif-about-hero relative py-20 px-4 sm:px-6 md:px-12 text-center text-white overflow-hidden bg-gradient-to-br from-[#082B63] via-[#0a3572] to-[#082B63]">
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[radial-gradient(circle,rgba(243,154,24,0.18)_0%,transparent_70%)]"></div>
        <div class="pointer-events-none absolute -bottom-28 -left-28 w-96 h-96 rounded-full bg-[radial-gradient(circle,rgba(22,119,200,0.16)_0%,transparent_70%)]"></div>

        <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
          <nav class="inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[1.5px] text-white/70 bg-white/[0.07] border border-white/15 px-5 py-2 rounded-full mb-6" aria-label="Breadcrumb">
            <a href="/" class="text-[#F4B51B] hover:text-white transition-colors">Home</a>
            <span class="text-white/40">›</span>
            <span>About Us</span>
          </nav>

          <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight mb-4 text-white font-['Poppins']">
            About Bhavya Career Institute
          </h1>

          <p class="font-['Noto_Sans_Devanagari'] text-base sm:text-lg text-white/85 max-w-2xl leading-relaxed">
            शिक्षा, व्यावहारिक कौशल और तकनीकी ज्ञान के माध्यम से बेहतर रोजगार और सशक्त भविष्य की ओर — 2010 से कोटा में विश्वसनीय मंच।
          </p>
        </div>
      </section>

      <!-- ============================================
           WHO WE ARE (MSBIF 2-COL WITH FLOATING BADGES)
           ============================================ -->
      <section class="py-20 md:py-28 bg-white border-b border-[#082B63]/[0.06]">
        <div class="max-w-[1200px] mx-auto px-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            
            <!-- Left: Content -->
            <div class="flex flex-col">
              <span class="inline-block self-start font-['Poppins'] text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-4">
                Who We Are
              </span>

              <h2 class="text-3xl sm:text-4xl md:text-[40px] font-bold text-[#082B63] font-['Poppins'] leading-tight mb-6">
                हम कौन हैं?<br>
                <span class="text-[#F39A18]">Bhavya Career Institute (BCI)</span>
              </h2>

              <p class="font-['Noto_Sans_Devanagari'] text-[#4A5568] text-base leading-[1.9] mb-4">
                Bhavya Career Institute राजस्थान के कोटा (Mahaveer Nagar Extension) में स्थित एक प्रतिष्ठित कंप्यूटर व व्यावसायिक कौशल शिक्षण संस्थान है। पिछले 15 वर्षों से हम स्कूल व कॉलेज के विद्यार्थियों, महिलाओं और नौकरी की तैयारी कर रहे युवाओं को जॉब-रेडी स्किल्स प्रदान कर रहे हैं।
              </p>

              <p class="font-['Noto_Sans_Devanagari'] text-[#4A5568] text-base leading-[1.9] mb-6">
                हमारा उद्देश्य केवल प्रमाणपत्र देना नहीं, बल्कि प्रत्येक छात्र को व्यावहारिक अनुभव (Hands-on Lab Training), आत्मविश्वास और आधुनिक उद्योग की मांग के अनुरूप तैयार करना है।
              </p>

              <!-- Highlight Banner -->
              <div class="bg-gradient-to-r from-[#F39A18]/[0.09] to-[#F4B51B]/[0.09] border border-[#F39A18]/25 rounded-2xl p-5 mb-8 font-['Noto_Sans_Devanagari'] font-semibold text-[#082B63] text-center sm:text-left leading-relaxed">
                कंप्यूटर साक्षरता <span class="text-[#F39A18] font-bold">|</span> सरकारी मान्यता प्राप्त RSCIT <span class="text-[#F39A18] font-bold">|</span> Tally व GST <span class="text-[#F39A18] font-bold">|</span> प्रोग्रामिंग व AI
              </div>

              <!-- Buttons -->
              <div class="flex flex-wrap gap-4 items-center">
                <a href="/all-courses" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-[#F39A18] text-white font-['Poppins'] font-semibold text-sm hover:bg-[#e08a10] transition-all transform hover:-translate-y-0.5 shadow-lg shadow-[#F39A18]/25">
                  Explore Courses
                </a>
                <a href="/contact" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full border-2 border-[#082B63] text-[#082B63] font-['Poppins'] font-semibold text-sm hover:bg-[#082B63] hover:text-white transition-all transform hover:-translate-y-0.5 shadow-sm">
                  Contact Us
                </a>
              </div>
            </div>

            <!-- Right: Institute Lab Visual -->
            <div class="relative max-w-lg mx-auto lg:max-w-none w-full">
              <!-- Decorative backing shapes -->
              <div class="absolute -top-4 -right-4 w-32 h-32 rounded-3xl bg-[#F39A18]/15 -z-10"></div>
              <div class="absolute -bottom-5 -left-5 w-40 h-40 rounded-full bg-[#0757A8]/10 -z-10"></div>

              <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white bg-[#082B63]/5">
                <img
                  src={classroomOptimized}
                  alt="Inside Bhavya Career Institute Lab in Kota"
                  class="w-full h-[400px] object-cover hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute bottom-4 left-4 right-4 bg-[#082B63]/85 backdrop-blur-md p-4 rounded-xl border border-white/20 text-white flex items-center gap-3">
                  <div class="w-10 h-10 rounded-lg bg-[#F39A18] text-[#082B63] flex items-center justify-center font-bold text-lg flex-shrink-0">
                    15+
                  </div>
                  <div>
                    <p class="text-xs uppercase tracking-wider font-semibold text-white/70">Years of Trust in Kota</p>
                    <p class="text-sm font-bold">5,000+ Certified Students Empowered</p>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ============================================
           MISSION / VISION / VALUES (MSBIF 3-CARD CARDS)
           ============================================ -->
      <section class="py-20 md:py-28 bg-[#F8FAFD]">
        <div class="max-w-[1200px] mx-auto px-6">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="inline-block font-['Poppins'] text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-3">
              Our Core
            </span>
            <h2 class="text-3xl sm:text-4xl font-bold text-[#082B63] font-['Poppins'] mb-3">
              हमारा मिशन, विज़न और मूल्य
            </h2>
            <p class="text-[#6B7A90] text-sm sm:text-base">What drives our educational commitment every single day</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Mission -->
            <div class="bg-white rounded-2xl p-8 border border-[#082B63]/[0.07] shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0757A8] to-[#1677C8]"></div>
              <div class="w-16 h-16 rounded-2xl bg-[#0757A8]/[0.08] flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-[#0757A8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-[#082B63] text-center mb-3 font-['Noto_Sans_Devanagari']">हमारा मिशन</h3>
              <p class="text-[#4A5568] text-center font-['Noto_Sans_Devanagari'] text-sm leading-[1.85]">
                कोटा और हाड़ौती क्षेत्र के प्रत्येक विद्यार्थी तक गुणवत्तापूर्ण, सस्ती और आधुनिक कंप्यूटर शिक्षा पहुंचाना—जिससे वे स्वरोजगार, प्राइवेट जॉब्स व सरकारी परीक्षाओं में आत्मनिर्भर बन सकें।
              </p>
            </div>

            <!-- Vision -->
            <div class="bg-white rounded-2xl p-8 border border-[#082B63]/[0.07] shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#F39A18] to-[#F4B51B]"></div>
              <div class="w-16 h-16 rounded-2xl bg-[#F39A18]/[0.1] flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-[#F39A18]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-[#082B63] text-center mb-3 font-['Noto_Sans_Devanagari']">हमारा विज़न</h3>
              <p class="text-[#4A5568] text-center font-['Noto_Sans_Devanagari'] text-sm leading-[1.85]">
                एक ऐसा डिजिटल रूप से सशक्त समाज तैयार करना जहां ज्ञान और तकनीक का लाभ उठाकर कोई भी युवा अवसरों से वंचित न रहे, और हर छात्र अपने सपनों को साकार कर सके।
              </p>
            </div>

            <!-- Values -->
            <div class="bg-white rounded-2xl p-8 border border-[#082B63]/[0.07] shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden group">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#082B63] to-[#0757A8]"></div>
              <div class="w-16 h-16 rounded-2xl bg-[#082B63]/[0.08] flex items-center justify-center mb-6 mx-auto group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-[#082B63]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-[#082B63] text-center mb-3 font-['Noto_Sans_Devanagari']">हमारे मूल्य</h3>
              <p class="text-[#4A5568] text-center font-['Noto_Sans_Devanagari'] text-sm leading-[1.85]">
                व्यक्तिगत मार्गदर्शन, ईमानदारी, व्यावहारिक अभ्यास (Hands-on Lab) और निरंतर सहयोग। हम प्रत्येक छात्र की प्रगति में व्यक्तिगत रुचि और प्रतिबद्धता रखते हैं।
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================================
           WHAT WE TEACH / FOCUS AREAS (MSBIF 6-GRID CARDS)
           ============================================ -->
      <section class="py-20 md:py-28 bg-white border-b border-[#082B63]/[0.06]">
        <div class="max-w-[1200px] mx-auto px-6">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="inline-block font-['Poppins'] text-xs font-bold uppercase tracking-[2px] text-[#0757A8] bg-[#0757A8]/[0.08] px-4 py-1.5 rounded-full mb-3">
              Our Training Areas
            </span>
            <h2 class="text-3xl sm:text-4xl font-bold text-[#082B63] font-['Poppins'] mb-3">
              हम क्या सिखाते हैं?
            </h2>
            <p class="text-[#6B7A90] text-sm sm:text-base">Comprehensive skill programs tailored to current industry standards</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- 1: RSCIT -->
            <div class="bg-white p-7 rounded-2xl border border-[#082B63]/[0.07] relative shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#0757A8] before:rounded-l-2xl">
              <div class="w-12 h-12 rounded-xl bg-[#0757A8]/[0.08] flex items-center justify-center mb-4 text-[#0757A8]">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3L1 9l11 6 11-6-11-6z"/><path d="M5 13v4c0 1.1 3.1 3 7 3s7-1.9 7-3v-4"/><path d="M12 15v4"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] mb-2 font-['Noto_Sans_Devanagari']">RSCIT सरकारी मान्यता प्राप्त कोर्स</h3>
              <p class="text-sm text-[#4A5568] leading-relaxed font-['Noto_Sans_Devanagari']">
                राजस्थान सरकार की सभी प्रतियोगी परीक्षाओं व सरकारी पदों के लिए अनिवार्य बेसिक कंप्यूटर व डिजिटल साक्षरता प्रमाणन।
              </p>
            </div>

            <!-- 2: Tally & GST -->
            <div class="bg-white p-7 rounded-2xl border border-[#082B63]/[0.07] relative shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#F39A18] before:rounded-l-2xl">
              <div class="w-12 h-12 rounded-xl bg-[#F39A18]/[0.1] flex items-center justify-center mb-4 text-[#F39A18]">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] mb-2 font-['Noto_Sans_Devanagari']">Tally Prime &amp; GST अकाउंटिंग</h3>
              <p class="text-sm text-[#4A5568] leading-relaxed font-['Noto_Sans_Devanagari']">
                कंपनी अकाउंट्स, बिलिंग, GST फाइलिंग, ई-वे बिल और वित्तीय रिपोर्टिंग की संपूर्ण हैंड्स-ऑन ट्रेनिंग।
              </p>
            </div>

            <!-- 3: DCA -->
            <div class="bg-white p-7 rounded-2xl border border-[#082B63]/[0.07] relative shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#1677C8] before:rounded-l-2xl">
              <div class="w-12 h-12 rounded-xl bg-[#1677C8]/[0.08] flex items-center justify-center mb-4 text-[#1677C8]">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] mb-2 font-['Noto_Sans_Devanagari']">DCA व एडवांस्ड कंप्यूटर डिप्लोमा</h3>
              <p class="text-sm text-[#4A5568] leading-relaxed font-['Noto_Sans_Devanagari']">
                12वीं के बाद 1 वर्षीय संपूर्ण कंप्यूटर डिप्लोमा—MS Office, इंटरनेट, DTP और ऑफिस ऑटोमेशन।
              </p>
            </div>

            <!-- 4: Web & Programming -->
            <div class="bg-white p-7 rounded-2xl border border-[#082B63]/[0.07] relative shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#F4B51B] before:rounded-l-2xl">
              <div class="w-12 h-12 rounded-xl bg-[#F4B51B]/[0.1] flex items-center justify-center mb-4 text-[#F4B51B]">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] mb-2 font-['Noto_Sans_Devanagari']">वेब डेवलपमेंट व कोडिंग (Python/JS)</h3>
              <p class="text-sm text-[#4A5568] leading-relaxed font-['Noto_Sans_Devanagari']">
                HTML, CSS, JavaScript, Python प्रोग्रामिंग, डेटाबेस और लाइव प्रोजेक्ट्स के साथ मॉडर्न सॉफ्टवेयर स्किल्स।
              </p>
            </div>

            <!-- 5: Graphic Design -->
            <div class="bg-white p-7 rounded-2xl border border-[#082B63]/[0.07] relative shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all flex flex-col before:content-[''] before:absolute before:top-0 before:left-0 before:w-1.5 before:h-full before:bg-[#082B63] before:rounded-l-2xl">
              <div class="w-12 h-12 rounded-xl bg-[#082B63]/[0.08] flex items-center justify-center mb-4 text-[#082B63]">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83M16.62 12l-5.74 9.94"/></svg>
              </div>
              <h3 class="text-lg font-bold text-[#082B63] mb-2 font-['Noto_Sans_Devanagari']">ग्राफिक डिजाइनिंग व DTP</h3>
              <p class="text-sm text-[#4A5568] leading-relaxed font-['Noto_Sans_Devanagari']">
                Photoshop, CorelDRAW, सोशल मीडिया पोस्ट डिज़ाइन, ब्रोशर और प्रिंटिंग मीडिया का व्यावहारिक अभ्यास।
              </p>
            </div>

