---
// src/pages/firebase-login-demo.astro
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Firebase Auth Demo - Login</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
    .card { background: #1e293b; padding: 2rem; border-radius: 0.5rem; width: 100%; max-width: 400px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
    h1 { margin-top: 0; text-align: center; }
    .form-group { margin-bottom: 1rem; }
    label { display: block; margin-bottom: 0.5rem; font-size: 0.875rem; }
    input, select { width: 100%; padding: 0.5rem; border-radius: 0.25rem; border: 1px solid #334155; background: #0f172a; color: white; margin-bottom: 0.5rem; box-sizing: border-box; }
    button { width: 100%; padding: 0.75rem; border: none; border-radius: 0.25rem; font-weight: bold; cursor: pointer; margin-top: 0.5rem; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-secondary { background: transparent; border: 1px solid #3b82f6; color: #3b82f6; }
    #error-message { color: #ef4444; text-align: center; font-size: 0.875rem; min-height: 20px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Welcome</h1>
    <div id="error-message"></div>
    
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" placeholder="you@example.com" />
    </div>
    
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" placeholder="••••••••" />
    </div>
    
    <div class="form-group">
      <label for="role">I am a...</label>
      <select id="role">
        <option value="student">Student</option>
        <option value="teacher">Teacher</option>
      </select>
    </div>

    <button id="login-btn" class="btn-primary">Log In</button>
    <button id="signup-btn" class="btn-secondary">Create Account</button>
  </div>

  <script>
    import { createUserWithEmailAndPassword, signInWithEmailAndPassword } from "firebase/auth";
    import { auth } from "../utils/firebase";

    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const roleInput = document.getElementById('role') as HTMLSelectElement;
    
    const signupBtn = document.getElementById('signup-btn');
    const loginBtn = document.getElementById('login-btn');
    const errorMsg = document.getElementById('error-message');

    function showError(msg: string) {
      if (errorMsg) errorMsg.textContent = msg;
    }

    signupBtn?.addEventListener('click', async () => {
      showError("");
      try {
        const userCredential = await createUserWithEmailAndPassword(auth, emailInput.value, passwordInput.value);
        const user = userCredential.user;
        const role = roleInput.value;

        // Send this to our new Astro API to save the role in Supabase.
        await fetch('/api/save-user', { 
          method: 'POST', 
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uid: user.uid, email: user.email, role }) 
        });
        
        // For the demo, we'll store it in localStorage so the dashboard knows.
        localStorage.setItem('demo_role', role);

        window.location.href = '/firebase-dashboard-demo';
      } catch (error: any) {
        showError(error.message);
      }
    });

    loginBtn?.addEventListener('click', async () => {
      showError("");
      try {
        await signInWithEmailAndPassword(auth, emailInput.value, passwordInput.value);
        
        // In a real app, you'd fetch their role from Neon DB here.
        if (!localStorage.getItem('demo_role')) {
            localStorage.setItem('demo_role', roleInput.value); // Fallback for demo
        }

        window.location.href = '/firebase-dashboard-demo';
      } catch (error: any) {
        showError(error.message);
      }
    });
  </script>
</body>
</html>
